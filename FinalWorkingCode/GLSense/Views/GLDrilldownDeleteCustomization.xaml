<utils:DpiAwareWindow x:Class="GLSense.Views.GLDrilldownDeleteCustomization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GLSense.Views"
        xmlns:utils="clr-namespace:GLSense.Utilities"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
        Background="#F8F9FA"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        MinWidth="620" MaxWidth="760"
        MinHeight="380" MaxHeight="560"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">

    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="TrashCanSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="Delete Drilldown Customizations" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= Cube Name Info ================= -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E9ECEF" Margin="0,12,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Cube Name:" FontWeight="SemiBold" Foreground="#212529" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtCubeName" Margin="6,0,0,0" Foreground="#212529" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================= DD Type DataGrid ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E9ECEF" Margin="0,12,0,12">
            <DataGrid x:Name="dgTypes"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeColumns="True"
                      Background="White"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>

                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                        <Setter Property="Background" Value="#E0E0E0"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Style>

                    <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                        <Setter Property="Background" Value="#6C757D"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Style>

                    <!-- Keyed (not just assigned to DataGrid.ColumnHeaderStyle directly) so the
                         per-column HeaderStyle overrides below (added only to attach tooltips)
                         can BasedOn it and inherit the real blue/white look - a BasedOn against
                         the bare {x:Type DataGridColumnHeader} default resolves to the generic
                         theme style instead, which is why "Drilldown Type"/"Columns Saved"
                         previously rendered with default gray headers while the checkbox
                         column's un-overridden header (using this Style directly) did not.
                         The ControlTemplate below is required, not optional - the default
                         DataGridColumnHeader template does not honor Background/Foreground via
                         plain Setters. -->
                    <Style x:Key="DrilldownHeaderStyle" TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2E86AB"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#1B6B93"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" TargetName="border" Value="#389BC7"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" TargetName="border" Value="#277596"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DrilldownHeaderStyle}"/>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#F8F9FA"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#212529"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Height" Value="36"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DgTypesRow_PreviewMouseLeftButtonDown"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#FFF8E1"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F8FF"/>
                                <Setter Property="BorderBrush" Value="#2E86AB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{Binding Foreground,
                            RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Checkbox column - fixed width, not user-resizable -->
                    <DataGridTemplateColumn Width="44" CanUserResize="False">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="chkSelectAll"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Checked="ChkSelectAll_Checked"
                                      Unchecked="ChkSelectAll_Unchecked"
                                      Style="{StaticResource ModernCheckBox}">
                                <CheckBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <TextBlock Text="Select/Deselect all drilldown types in the list" TextWrapping="Wrap"/>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkSelectType"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ModernCheckBox}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="Select this drilldown type for deletion" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Drilldown Type -->
                    <DataGridTextColumn Header="Drilldown Type"
                            IsReadOnly="True"
                            Binding="{Binding DisplayName}"
                            Width="*"
                            MinWidth="200">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DrilldownHeaderStyle}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="The saved drilldown metadata type for the selected cube" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <StackPanel>
                                                <TextBlock Text="Drilldown Type" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Columns Saved -->
                    <DataGridTextColumn Header="Columns Saved"
                            IsReadOnly="True"
                            Binding="{Binding RecordCount}"
                            Width="140"
                            MinWidth="120">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DrilldownHeaderStyle}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="Number of column-metadata entries saved locally for this drilldown type" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                <Setter Property="TextAlignment" Value="Left"/>
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <StackPanel>
                                                <TextBlock Text="Columns Saved" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding RecordCount}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= Footer Actions ================= -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E9ECEF" Padding="16">
            <Grid>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button x:Name="btnDelete" Content="Delete" Style="{StaticResource DynamicContentButton}"
                            Click="BtnDelete_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Delete the saved customization for the checked drilldown type(s)" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12"
                                                  Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="Will delete:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                <TextBlock Text="• Only the checked drilldown type(s)"
                                                     FontSize="11" FontStyle="Italic" Foreground="Black"
                                                     Margin="0,2,0,0"/>
                                                <TextBlock Text="• Unchecked types are kept as-is"
                                                     FontSize="11" FontStyle="Italic" Foreground="Black"
                                                     Margin="0,2,0,0"/>
                                                <TextBlock Text="• Action cannot be undone"
                                                     FontSize="11" FontStyle="Italic" Foreground="Black"
                                                     Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Close this window without deleting anything" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>
