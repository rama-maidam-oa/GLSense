<utils:DpiAwareWindow x:Class="GLSense.Views.GLSegmentDiscovery" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:utils="clr-namespace:GLSense.Utilities" 
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
					  xmlns:local="clr-namespace:GLSense.Views" WindowStyle="None" WindowStartupLocation="CenterOwner" 
                      SizeToContent="Manual" MinHeight="440" MaxHeight="490" MinWidth="680" MaxWidth="780" 
					  ResizeMode="CanResize" Background="#F8F9FA" Loaded="Window_Loaded">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="628*"/>
            <ColumnDefinition Width="69*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="CompassSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="GLSense Segment Values Discover" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>
        <!-- ================= Main Content ================= -->
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
            <StackPanel>
                <Border Style="{StaticResource ContentBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Segment Value : " Style="{StaticResource SectionHeader}" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSegmentValue" Style="{StaticResource ModernTextBox}" Grid.Column="1" Margin="8,0,0,0" IsReadOnly="True">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <StackPanel>
                                        <TextBlock Text="Displays the selected segment value to be written to Excel" TextWrapping="Wrap"/>
                                        <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="This value will be populated based on:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                    <TextBlock Text="• Number of selected Excel rows/cells" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                    <TextBlock Text="• Selected direction (Up/Down/Left/Right)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ContentBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Direction Options : " Style="{StaticResource SectionHeader}" Grid.Column="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <RadioButton x:Name="rbUp" Content="Up" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" IsChecked="True" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbDown" Content="Down" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbRight" Content="Right" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbLeft" Content="Left" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbDownAll" Content="Down All" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbRightAll" Content="Right All" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ContentBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Include Options : " Style="{StaticResource SectionHeader}" Grid.Column="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <CheckBox x:Name="chkParent" Content="Parent" Style="{StaticResource ModernCheckBox}" IsChecked="True"/>
                            <CheckBox x:Name="chkChild" Content="Child" Style="{StaticResource ModernCheckBox}" IsChecked="True" Margin="30,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ContentBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output Options : " Style="{StaticResource SectionHeader}" Grid.Column="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <RadioButton x:Name="rbOverwrite" Content="Overwrite" Style="{StaticResource ModernRadioButton}" GroupName="OutputGroup" IsChecked="True"/>
                            <RadioButton x:Name="rbInsert" Content="Insert" Style="{StaticResource ModernRadioButton}" GroupName="OutputGroup" Margin="30,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ContentBorderStyle}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Range Selected : " Style="{StaticResource SectionHeader}" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtRangeSelected" Style="{StaticResource ModernTextBox}" Grid.Column="1" Margin="8,0,0,0" IsReadOnly="True"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Action Buttons Section ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Grid.ColumnSpan="2" Padding="8,4" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSubmit" Style="{StaticResource InsertButtonStyle}" Click="BtnSubmit_Click" Margin="0,0,8,0"/>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- ================= Toast/Busy Overlay ================= -->
        <local:AppOverlay x:Name="AppOverlayControl" Margin="0" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>
