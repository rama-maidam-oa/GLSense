<utils:DpiAwareWindow x:Class="GLSense.Views.GLLogin" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:local="clr-namespace:GLSense.Views" 
        xmlns:ctrls="clr-namespace:GLSense.Controls" 
        xmlns:utils="clr-namespace:GLSense.Utilities"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" 
        Background="#F8F9FA" 
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" 
        WindowStyle="None"
        MinHeight="750"
        MinWidth="480" Width="540">

    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" 
           Orientation="Horizontal" 
           VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="RightToBracketSolid" 
                 Style="{StaticResource LargeIcon}" />
                    <TextBlock Text="Orbit GLSense Login" 
                 Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>

                <Button Grid.Column="2" 
             Style="{StaticResource CustomWindowCloseButtonStyle}" 
             Click="BtnClose_Click" />
            </Grid>
        </Border>
        <!-- ================= Form + WebView Section ================= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Form Section -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0">
                <Border Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="15" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Instance Row -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#F8F9FA" CornerRadius="4" Padding="8,6" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconFontAwesome Kind="GlobeSolid" Style="{StaticResource SmallIcon}" Foreground="#2E86AB" Margin="0,2,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Instance:" Style="{StaticResource HeaderTextBlock}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ctrls:SuggestAppendComboBox x:Name="cmbServer" Grid.Row="0" 
                            Grid.Column="1" Height="32" HorizontalAlignment="Stretch" 
                            VerticalAlignment="Center" Margin="0,0,0,8" 
                            ItemsSource="{Binding ServerList}" 
                            ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" 
                            Background="White" Foreground="#212529" 
                            DisplayMemberPath="Name" 
                            SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
                        </ctrls:SuggestAppendComboBox>
                        <!-- URL Row -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#F8F9FA" CornerRadius="4" Padding="8,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconFontAwesome Kind="LinkSolid" Margin="0,2,0,0" Style="{StaticResource SmallIcon}" Foreground="#2E86AB" VerticalAlignment="Center"/>
                                <TextBlock Text="URL:" Style="{StaticResource HeaderTextBlock}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="txtServer" 
                                 Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="32" 
                                 Style="{StaticResource ModernTextBox}" 
                                 IsReadOnly="True" 
                                 Text="{Binding SelectedServer.Address, Mode=OneWay}">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="This URL is read-only and automatically updates based on your instance selection." 
                                               TextWrapping="Wrap"/>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- WebView2 Section -->
            <Border Grid.Row="1" Background="White" BorderThickness="1" BorderBrush="#E9ECEF" CornerRadius="6" Margin="0,0,0,8" VerticalAlignment="Stretch">
                <wpf:WebView2 x:Name="webView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
        <!-- ================= Buttons Section ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" 
                    Click="BtnClose_Click" />
            </StackPanel>
        </Border>
        <!-- ================= App Overlay ================= -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>