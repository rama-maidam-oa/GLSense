<UserControl x:Class="GLSense.Views.ExcelRefEditControl" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:data="clr-namespace:GLSense"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:GLSense.Converters"
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Center" 
             x:Name="excelRefControl" 
             Loaded="ExcelRefEditControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Add this brush for GLAccentHex -->
            <SolidColorBrush x:Key="GLAccentBrush" Color="#2E86AB"/>

            <!-- Grid disabled style (control-specific) -->
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Converters -->
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Single Grid with unified border -->
    <Border Background="White" 
            CornerRadius="4" 
            BorderThickness="1" 
            BorderBrush="#E9ECEF"
            SnapsToDevicePixels="True">

        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TextBox - Now stretches properly -->
            <TextBox x:Name="txtBox" 
                     Grid.Column="0" 
                     IsReadOnly="True" 
                     BorderThickness="0" 
                     Background="Transparent" 
                     VerticalContentAlignment="Top" 
                     Padding="8,6" 
                     Foreground="#212529" 
                     FontSize="13"
                     TextWrapping="NoWrap"
                     FontFamily="Segoe UI"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Left"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                <!-- Add tooltip to show full text when trimmed -->
                <TextBox.ToolTip>
                    <ToolTip x:Name="cellRefToolTip"
                             Placement="Bottom"
                             Style="{StaticResource SimpleBrowserToolTip}"
                             Visibility="{Binding PlacementTarget.Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyStringToVisibilityConverter}}">

                        <StackPanel x:Name="toolTipPanel" MaxWidth="300">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="LocationDotSolid" 
                                                                Width="12" 
                                                                Height="12" 
                                                                Foreground="#2E86AB" 
                                                                Margin="0,0,6,0" 
                                                                VerticalAlignment="Center"/>
                                <TextBlock Text="Selected Excel Cell:" 
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Show full text in tooltip - bind to PlacementTarget -->
                            <TextBlock x:Name="toolTipTextBlock" 
                                       FontFamily="Segoe UI" 
                                       Background="#F5F5F5" 
                                       Padding="4" 
                                       Margin="0,6,0,0" 
                                       FontWeight="SemiBold"
                                       Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                       TextWrapping="Wrap"/>

                            <Border Background="#FBB41A" 
                                    CornerRadius="3" 
                                    Padding="8,6" 
                                    Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" 
                                                                    Width="12" 
                                                                    Height="12" 
                                                                    Foreground="Black" 
                                                                    Margin="0,0,6,0" 
                                                                    VerticalAlignment="Center"/>
                                    <TextBlock Text="Click the table button to select excel cell" 
                                               FontSize="11" 
                                               FontStyle="Italic" 
                                               Foreground="Black"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ToolTip>
                </TextBox.ToolTip>
            </TextBox>

            <!-- Edit Button -->
            <Button x:Name="btnEdit" 
                    Grid.Column="1" 
                    Margin="0" 
                    Padding="4" 
                    BorderThickness="0" 
                    Cursor="Hand" 
                    Click="BtnEdit_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{x:Null}">
                        <Setter Property="Background" Value="Transparent"/>
                        <!-- Fix: Use StaticResource for Foreground -->
                        <Setter Property="Foreground" Value="{StaticResource GLAccentBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="4" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" 
                                                    Property="Background" 
                                                    Value="#808080"/>
                                            <Setter Property="Foreground" 
                                                    Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Button.ToolTip>
                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="TableCellsSolid"
                                                                Width="12"
                                                                Height="12"
                                                                Foreground="{StaticResource GLAccentBrush}"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"/>
                                <TextBlock Text="Select Excel Cell"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Click to select excel cell as a reference." 
                                       Margin="0,4,0,0" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <iconPacks:PackIconFontAwesome Kind="TableCellsSolid"
                                                Width="16"
                                                Height="16"
                                                Margin="0,1,0,0"/>
            </Button>

            <!-- Clear Button -->
            <Button x:Name="btnClear" 
                    Grid.Column="2" 
                    Margin="0" 
                    Padding="4" 
                    BorderThickness="0" 
                    Cursor="Hand" 
                    Click="BtnClear_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{x:Null}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#6C757D"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="4" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" 
                                                    Property="Background" 
                                                    Value="#808080"/>
                                            <Setter Property="Foreground" 
                                                    Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Button.ToolTip>
                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="EraserSolid" 
                                                                Width="12" 
                                                                Height="12" 
                                                                Foreground="#6C757D" 
                                                                Margin="0,0,6,0" 
                                                                VerticalAlignment="Center"/>
                                <TextBlock Text="Clear Reference" 
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Click to clear the selected cell reference" 
                                       Margin="0,4,0,0" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <iconPacks:PackIconFontAwesome Kind="EraserSolid" 
                                                Width="16" 
                                                Height="16" 
                                                Margin="0,1,0,0"/>
            </Button>
        </Grid>
    </Border>
</UserControl>