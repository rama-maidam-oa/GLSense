<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="http://schemas.fontawesome.io/icons/"
                    xmlns:ctrls="clr-namespace:GLSense.Controls"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome">

    <!-- Merge GlobalStyles - All common styles are centralized here -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Multi-select template for SuggestAppendComboBox -->
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type ctrls:SuggestAppendComboBox}, ResourceId=SuggestMultiSelectItemTemplate}">
        <StackPanel Orientation="Horizontal">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Content="{Binding}"
                      VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- SuggestAppendComboBox Default Style - Uses AppScrollBarStyle for consistent scrollbars -->
    <Style TargetType="{x:Type ctrls:SuggestAppendComboBox}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="ArrowBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="ArrowWidth" Value="10"/>
        <Setter Property="ArrowHeight" Value="8"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrls:SuggestAppendComboBox}">
                    <Border x:Name="OuterBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <!-- Visual States -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PopupStates">
                                <VisualState x:Name="PopupClosed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="0"
                                                         Duration="0:0:0.1"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PopupOpen">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="180"
                                                         Duration="0:0:0.1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Editable text area WITH TOOLTIP -->
                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     FontFamily="Segoe UI"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="{TemplateBinding Padding}"
                                     VerticalContentAlignment="Center"
                                     Foreground="{TemplateBinding Foreground}"
                                     Focusable="True"
                                     SelectionBrush="{DynamicResource MahApps.Brushes.Accent}"
                                     SelectionTextBrush="{DynamicResource MahApps.Brushes.IdealForeground}" >
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconFontAwesome Kind="SearchenginBrands" 
                                                                                Width="12" Height="12" 
                                                                                Foreground="{StaticResource PrimaryBrush}" 
                                                                                Margin="0,0,6,0" 
                                                                                VerticalAlignment="Center"/>
                                                <TextBlock Text="Current Selection" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="toolTipTextBlock"
                                                       FontFamily="Segoe UI" 
                                                       Background="#F5F5F5" 
                                                       Padding="4" 
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="300"
                                                       Text="No selection"/>
                                            <Border Background="{StaticResource TooltipBorderBrush}" 
                                                    CornerRadius="3" 
                                                    Padding="8,6" 
                                                    Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                                                    Width="12"
                                                                                    Height="12"
                                                                                    Foreground="Black"
                                                                                    Margin="0,0,6,0"
                                                                                    VerticalAlignment="Center"/>
                                                    <TextBlock Text="Type to search or select from dropdown" 
                                                               FontSize="11"
                                                               FontStyle="Italic"
                                                               Foreground="Black"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>

                            <!-- DropDown Button WITH TOOLTIP -->
                            <Button x:Name="PART_DropDownButton"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="0,0,4,0"
                                    Focusable="False"
                                    Cursor="Hand" >
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconFontAwesome Kind="ListSolid" 
                                                                                Width="12" Height="12" 
                                                                                Foreground="{StaticResource PrimaryBrush}" 
                                                                                Margin="0,0,6,0" 
                                                                                VerticalAlignment="Center"/>
                                                <TextBlock Text="Show Options" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="Click to show all available options" 
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="ArrowPath"
                                          Data="M 0 0 L 8 0 L 4 4 Z"
                                          Fill="{TemplateBinding ArrowBrush}"
                                          Stretch="Uniform"
                                          Width="{TemplateBinding ArrowWidth}"
                                          Height="{TemplateBinding ArrowHeight}">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ArrowRotate" Angle="0" CenterX="4" CenterY="2"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Button>

                            <!-- Clear button WITH TOOLTIP -->
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="2"
                                    Width="12"
                                    Height="12"
                                    Margin="2,0,4,0"
                                    Visibility="Collapsed"
                                    Background="Transparent"
                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                    BorderThickness="0" >
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconFontAwesome Kind="EraserSolid" 
                                                                                Width="12" Height="12" 
                                                                                Foreground="{StaticResource PrimaryBrush}" 
                                                                                Margin="0,0,6,0" 
                                                                                VerticalAlignment="Center"/>
                                                <TextBlock Text="Clear Selection" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="Click to clear the current selection" 
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Viewbox Width="10" Height="10">
                                    <TextBlock Text="✖" Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Viewbox>
                            </Button>

                            <!-- Popup dropdown - Uses AppScrollBarStyle for consistency -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   HorizontalOffset="0">
                                <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MaxHeight="300"
                                        SnapsToDevicePixels="True">
                                        <!-- Regression fix (ported from AIPowered - same control, same bug):
                                             PART_ListBox used to be wrapped in its own separate
                                             <ScrollViewer>, ON TOP OF the ListBox's own internal
                                             ScrollViewer (already enabled below via the
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" attached
                                             property). Nesting a ScrollViewer around a control that
                                             already hosts its own ScrollViewer is a well-known WPF trap:
                                             PreviewMouseWheel tunnels from the outside in, so the OUTER
                                             ScrollViewer saw every wheel event first - and since its own
                                             content (the ListBox, capped at MaxHeight="250" inside a
                                             MaxHeight="300" Border) rarely had any scrollable range of its
                                             own, the event was swallowed there instead of ever reaching the
                                             ListBox's inner ScrollViewer, so the mouse wheel neither
                                             scrolled the popup nor moved the scrollbar thumb. Removed the
                                             redundant outer ScrollViewer entirely - the ListBox's own
                                             internal ScrollViewer (still Auto-visibility) now receives wheel
                                             input directly and scrolls normally. Moved the ScrollBar style
                                             override from the removed ScrollViewer.Resources onto the
                                             ListBox's own Resources so the themed scrollbar still applies. -->
                                        <ListBox x:Name="PART_ListBox"
                                                 FontFamily="Segoe UI"
                                                 BorderThickness="0"
                                                 Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                                 Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                                 KeyboardNavigation.TabNavigation="Cycle"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MaxHeight="250"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.ScrollUnit="Pixel">
                                            <ListBox.Resources>
                                                <!-- UNIFIED: Using AppScrollBarStyle for all SuggestAppendComboBox controls -->
                                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppScrollBarStyle}"/>
                                            </ListBox.Resources>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" 
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                                    </Trigger>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="IsSelected" Value="True"/>
                                                                            <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}"/>
                                                                    </MultiTrigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.6"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <!-- Triggers for focus, disabled, popup -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                            <Setter TargetName="PART_TextBox" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <Setter TargetName="PART_ClearButton" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <Setter TargetName="ArrowPath" Property="Fill" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>

                        <Trigger SourceName="PART_Popup" Property="IsOpen" Value="True">
                            <Setter TargetName="OuterBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource MahApps.Brushes.Accent}" />
                            <Setter Property="Tag" Value="PopupOpen"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>