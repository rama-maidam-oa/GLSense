<utils:DpiAwareWindow x:Class="GLSense.Views.GLSegmentValues"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:utils="clr-namespace:GLSense.Utilities"
                      xmlns:local="clr-namespace:GLSense.Views"
                      xmlns:ctrls="clr-namespace:GLSense.Controls"
                      xmlns:conv="clr-namespace:GLSense.Converters"
                      xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                      xmlns:viewmodels="clr-namespace:GLSense.ViewModels"
                      Background="#F8F9FA" SizeToContent="Manual"
                      ResizeMode="CanResize"
                      MinWidth="720" MaxWidth="760"
                      MinHeight="750"
                      WindowStyle="None" WindowStartupLocation="CenterOwner"
                     Loaded="Window_Loaded">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters (window-specific) -->
            <conv:WidthPercentageConverter x:Key="WidthPercentageConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <!-- Scrollbar / Thumb styles used by data grids (window-specific) -->
            <Style TargetType="ScrollBar" x:Key="AppScrollBarStyle">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Background" Value="#E0E0E0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style TargetType="Thumb" x:Key="AppScrollThumbStyle">
                <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="LayerGroupSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="Segment Values Configurator" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= Middle Content ================= -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Section 1: Segment & Hierarchies -->
                    <Border Grid.Row="0" Background="White" CornerRadius="6" Margin="0,0,0,8" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconFontAwesome Kind="ChartPieSolid" Width="16" Height="16" Margin="0,0,8,0" Foreground="#2E86AB" VerticalAlignment="Center"/>
                                <TextBlock Text="Segment :" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                            </StackPanel>
                            <ctrls:SuggestAppendComboBox x:Name="cmbSegments" Grid.Column="1" Height="30" HorizontalAlignment="Stretch" ItemsSource="{Binding Segments}" DisplayMemberPath="SegmentName" SelectedItem="{Binding SelectedSegment, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" BorderThickness="1" BorderBrush="#E9ECEF"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <iconPacks:PackIconFontAwesome Kind="SitemapSolid" Width="16" Height="16" Margin="0,0,8,0" Foreground="#2E86AB" VerticalAlignment="Center"/>
                                <TextBlock Text="Hierarchies :" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                            </StackPanel>
                            <ctrls:SuggestAppendComboBox x:Name="cmbHierarchy" Grid.Column="3" Height="30" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding HierarchyItems}" DisplayMemberPath="DisplayDescription" SelectedItem="{Binding SelectedHierarchy, Mode=TwoWay}" Margin="8,0,0,0" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" BorderThickness="1" BorderBrush="#E9ECEF" LostFocus="CmbHierarchy_LostFocus"/>
                        </Grid>
                    </Border>

                    <!-- Header Section 2: Search -->
                    <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="0,0,0,8" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconFontAwesome Kind="SearchenginBrands" Width="16" Height="16" Margin="0,4,8,0" Foreground="#2E86AB" VerticalAlignment="Center"/>
                                <TextBlock Text="Search :" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <ctrls:SuggestAppendComboBox x:Name="cmbSearchType" HorizontalAlignment="Stretch" MinWidth="180" Height="30" Margin="0,0,8,0" ItemsSource="{Binding SearchTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSearchType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" BorderThickness="1" BorderBrush="#E9ECEF"/>
                                <TextBox x:Name="txtSearch" HorizontalAlignment="Stretch" MinWidth="250" Height="30" Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.ToolTip>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <StackPanel>
                                                <TextBlock Text="Filters the data by given value" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </TextBox.ToolTip>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content: Dual DataGrids -->
                    <Border Grid.Row="2" MaxHeight="450" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" MinWidth="220"/>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="1.0*" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="4" Margin="4">
                                <DataGrid x:Name="dgLeft" FontFamily="Segoe UI" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{Binding PagedSegmentValues}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" Background="White" BorderThickness="0.5" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="DgLeft_MouseDoubleClick">
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </Style>
                                        <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                            <Setter Property="Background" Value="#6C757D"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#1B6B93"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                            <Setter Property="Padding" Value="12,10"/>
                                            <Setter Property="Height" Value="38"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                                <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,6,0" Width="10" Height="6" Stretch="Fill" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" Data="M 0 4 L 5 0 L 10 4 Z"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" TargetName="border" Value="#389BC7"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" TargetName="border" Value="#277596"/>
                                                            </Trigger>
                                                            <Trigger Property="SortDirection" Value="Ascending">
                                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 5 0 L 10 4 Z"/>
                                                            </Trigger>
                                                            <Trigger Property="SortDirection" Value="Descending">
                                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 5 4 L 10 0 Z"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#212529"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Height" Value="36"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSummaryAccount}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFF0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                    <Setter Property="Background" Value="#FFE4B5"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F8FF"/>
                                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#9bcee4"/>
                                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Value" Binding="{Binding DisplaySegmentValue}" Width="90" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                                    <Setter Property="ToolTip">
                                                        <Setter.Value>
                                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                                <TextBlock Text="{Binding DisplaySegmentValue}"/>
                                                            </ToolTip>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Description" IsReadOnly="True" Binding="{Binding Description}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                                    <Setter Property="ToolTip">
                                                        <Setter.Value>
                                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                            </ToolTip>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Is-Summary" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource SingleClickCheckBoxStyle}" IsChecked="{Binding IsSummaryChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSummaryAccount}">
                                                        <CheckBox.ToolTip>
                                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                                <TextBlock Text="This is a summary account" TextWrapping="Wrap" MaxWidth="300"/>
                                                            </ToolTip>
                                                        </CheckBox.ToolTip>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <Grid Grid.Column="1">
                                <GridSplitter Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                                    <Button x:Name="btnAdd" Style="{StaticResource AddToRightButtonStyle}" Click="BtnAdd_Click"/>
                                    <Button x:Name="btnBetween" Style="{StaticResource BetweenGridButtonStyle}" Click="BtnBetween_Click"/>
                                    <Button x:Name="btnNotBetween" Style="{StaticResource NotBetweenGridButtonStyle}" Click="BtnNotBetween_Click"/>
                                    <Button x:Name="btnExclude" Style="{StaticResource ExcludeButtonStyle}" Click="BtnExclude_Click"/>
                                    <Button x:Name="btnRemove" Style="{StaticResource RemoveFromRightGridButtonStyle}" Click="BtnRemove_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Column="2" Background="White" CornerRadius="4" Margin="4">
                                <DataGrid x:Name="dgRight" FontFamily="Segoe UI" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{Binding SelectedItemsRight}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True" Background="White" BorderThickness="0.5" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="DgRight_MouseDoubleClick">
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </Style>
                                        <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                            <Setter Property="Background" Value="#6C757D"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#1B6B93"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                            <Setter Property="Padding" Value="12,10"/>
                                            <Setter Property="Height" Value="38"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                                <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,6,0" Width="10" Height="6" Stretch="Fill" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" Data="M 0 4 L 5 0 L 10 4 Z"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" TargetName="border" Value="#389BC7"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Background" TargetName="border" Value="#277596"/>
                                                            </Trigger>
                                                            <Trigger Property="SortDirection" Value="Ascending">
                                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 5 0 L 10 4 Z"/>
                                                            </Trigger>
                                                            <Trigger Property="SortDirection" Value="Descending">
                                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 5 4 L 10 0 Z"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#212529"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Height" Value="36"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F0F8FF"/>
                                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                                    <Setter Property="Foreground" Value="#212529"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Value1" Binding="{Binding Value1}" Width="90" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                                    <Setter Property="ToolTip">
                                                        <Setter.Value>
                                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                                <TextBlock Text="{Binding Value1}"/>
                                                            </ToolTip>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Value2" Binding="{Binding Value2}" Width="90" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                                    <Setter Property="ToolTip">
                                                        <Setter.Value>
                                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                                <TextBlock Text="{Binding Value2}"/>
                                                            </ToolTip>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Value2}" Value="{x:Null}">
                                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                                    <Setter Property="ToolTip">
                                                        <Setter.Value>
                                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                                <TextBlock Text="{Binding Segment}"/>
                                                            </ToolTip>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
        <!-- Footer Section: Paging -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Left Section: Items per page -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="FileLinesSolid" Width="14" Height="14" Foreground="#2E86AB" VerticalAlignment="Center" Margin="0,0,0,0"/>
                    <TextBlock Text="Per Page:" Style="{StaticResource PaginationInfoText}"/>
                    <TextBox x:Name="txtRecordsPerPage" Width="60" Height="28" Style="{StaticResource SmallTextBox}" Text="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="4,0,16,0">
                        <TextBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Enter number of records to display per page" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Value must be greater than 0. For permanent setting, configure in User Settings window" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </StackPanel>
                <!-- Middle Section: Navigation buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- First Page Button -->
                    <Button x:Name="btnFirst" Width="30" Style="{StaticResource PaginationButton}" Click="BtnFirst_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Go to first page" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                        <iconPacks:PackIconFontAwesome Kind="BackwardStepSolid" Width="12" Height="12" Foreground="White"/>
                    </Button>
                    <!-- Previous Page Button -->
                    <Button x:Name="btnPrev" Width="30" Style="{StaticResource PaginationButton}" Click="BtnPrev_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Go to previous page" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                        <iconPacks:PackIconFontAwesome Kind="CaretLeftSolid" Width="12" Height="12" Foreground="White"/>
                    </Button>
                    <!-- Current page display -->
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Page" Style="{StaticResource PaginationInfoText}"/>
                            <TextBox x:Name="txtPage" Width="25" Height="24" Style="{StaticResource SmallTextBox}" Text="{Binding CurrentPage, Mode=OneWay}" TextAlignment="Center" VerticalContentAlignment="Center" Margin="4,0" IsReadOnly="True" Background="Transparent" BorderThickness="0"/>
                            <TextBlock Text="of" Style="{StaticResource PaginationInfoText}"/>
                            <TextBox x:Name="txtTotalPages" Width="50" Height="24" Style="{StaticResource SmallTextBox}" Text="{Binding TotalPages, Mode=OneWay}" TextAlignment="Center" VerticalContentAlignment="Center" Margin="4,0" IsReadOnly="True" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                    <!-- Next Page Button -->
                    <Button x:Name="btnNext" Width="30" Style="{StaticResource PaginationButton}" Click="BtnNext_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Go to next page" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                        <iconPacks:PackIconFontAwesome Kind="CaretRightSolid" Width="12" Height="12" Foreground="White"/>
                    </Button>
                    <!-- Last Page Button -->
                    <Button x:Name="btnLast" Width="30" Style="{StaticResource PaginationButton}" Click="BtnLast_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Go to last page" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                        <iconPacks:PackIconFontAwesome Kind="ForwardStepSolid" Width="12" Height="12" Foreground="White"/>
                    </Button>
                    <!-- Page Range Display -->
                    <TextBox x:Name="txtRange" Height="28" MinWidth="80" MaxWidth="100" Style="{StaticResource SmallTextBox}" VerticalAlignment="Center" VerticalContentAlignment="Center" TextWrapping="NoWrap" IsReadOnly="True" Text="{Binding PageRangeText, Mode=OneWay}" TextAlignment="Center" Margin="2">
                        <TextBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Shows current page's record range (e.g., 1-10, 11-20, etc.)" TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </StackPanel>
                <!-- Right Section: Total items -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="DatabaseSolid" Width="14" Height="14" Foreground="#2E86AB" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBlock Text="Total:" Style="{StaticResource PaginationInfoText}"/>
                    <TextBox x:Name="txtTotalRecords" Width="75" Height="28" Style="{StaticResource SmallTextBox}" Text="{Binding TotalRecords, Mode=OneWay}" IsReadOnly="True" TextAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="4,0">
                        <TextBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Total number of records for the selected segment" TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Footer Section: Options and Actions -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Margin="0,0,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Insert as Multiple Rows Checkbox -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkMultipleRows" Content="Insert as Multiple Rows" Style="{StaticResource ModernCheckBox}" IsEnabled="{Binding IsMultipleRowsEnabled}" IsChecked="{Binding IsMultipleRowsChecked, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2E86AB">
                        <CheckBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Controls how items are inserted into Excel" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="✓ Checked: Each item in new row" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                                <TextBlock Text="✗ Unchecked: All items in single cell" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                </StackPanel>

                <!-- Cell Reference Label and Control -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="Cell Reference:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <local:ExcelRefEditControl x:Name="excelRefEdit" TagName="Segment Values Cell Reference" Height="30" Margin="8,0,0,0" Width="200" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Spacer Column -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button x:Name="btnOK" Style="{StaticResource InsertButtonStyle}" Click="BtnOK_Click" Margin="0,0,8,0">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Insert selected items into Excel at specified cell reference" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Make sure Excel cell reference is correctly selected" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="CmdClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>
