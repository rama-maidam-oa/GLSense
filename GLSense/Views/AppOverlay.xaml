<UserControl x:Class="GLSense.Views.AppOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GLSense.Views"
             xmlns:conv="clr-namespace:GLSense.Converters"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Visibility="Collapsed">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters (control-specific) -->
            <conv:WidthPercentageConverter x:Key="PercentConverter"/>

            <!-- Toast Animation (control-specific) -->
            <Storyboard x:Key="ToastSlideIn">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 From="50" To="0" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>

            <Storyboard x:Key="ToastSlideOut">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 From="0" To="50" Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <QuadraticEase EasingMode="EaseIn"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.3"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootOverlay">
        <!-- Input blocker used when only toast is visible to prevent interaction with underlying UI -->
        <Grid x:Name="ToastInputBlocker" Visibility="Collapsed" Background="Transparent" IsHitTestVisible="True" Focusable="True" Panel.ZIndex="10000" />

        <!-- Toast -->
        <Border x:Name="Toast" Background="#DD333333" CornerRadius="0" Padding="15" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,1,0,0" MaxHeight="{Binding ActualHeight, ElementName=RootOverlay, Converter={StaticResource PercentConverter}, ConverterParameter=0.9}" Panel.ZIndex="10001">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconFontAwesome x:Name="ToastIcon" Grid.Column="0" Kind="CircleCheckSolid" Width="20" Height="20" Foreground="LimeGreen" Margin="0,0,10,0"/>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                    <TextBlock x:Name="ToastMessage" FontFamily="Segoe UI" Foreground="White" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Top"/>
                </ScrollViewer>
                <Button x:Name="BtnCloseToast" FontFamily="Segoe UI" MinWidth="40" Margin="0,0,8,0" Grid.Column="2" Background="Transparent" BorderThickness="0" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Cursor="Hand" Click="BtnCloseToast_Click">
                    <iconPacks:PackIconFontAwesome Kind="XmarkSolid" Width="12" Height="12" Foreground="White"/>
                </Button>
            </Grid>
        </Border>
        <!-- Busy Overlay -->
        <Grid x:Name="BusyOverlay" Background="#80000000" Visibility="Collapsed" Opacity="0" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="10000">
            <Border Background="White" Padding="20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="SpinnerSolid" Spin="True" Width="48" Height="48" Foreground="SteelBlue" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="BusyMessage" Text="Please wait..." FontFamily="Segoe UI" Margin="0,0,0,12" FontSize="15" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BusyElapsed" Text="" FontFamily="Segoe UI" Margin="0,0,0,6" FontSize="13" Foreground="Gray" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <Button x:Name="BtnCancelBusy" Style="{StaticResource CancelButtonStyle}"
                            Visibility="Collapsed" FontFamily="Segoe UI" Margin="0,10,0,0" Click="BtnHideBusy_Click">
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Confirmation Overlay -->
        <Grid x:Name="ConfirmOverlay" Background="#80000000" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="10002">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border x:Name="ConfirmPopup" Background="White" CornerRadius="12" Padding="20"
                        MinWidth="280"
                        MaxWidth="{Binding ActualWidth, ElementName=RootOverlay, Converter={StaticResource PercentConverter}, ConverterParameter=0.95}"
                        MaxHeight="{Binding ActualHeight, ElementName=RootOverlay, Converter={StaticResource PercentConverter}, ConverterParameter=0.8}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <!--
                    Fix (2026-07-15): message + buttons were getting clipped for longer
                    confirm text (e.g. BalanceRefresh.EnsureCompatibilityAsync's workbook
                    compatibility prompt) when this popup is hosted inside a small window
                    like GLWaitWindow. Root cause was twofold: (1) MaxHeight above is a
                    fraction of the host window's *current* height, and small host windows
                    never grew to make room (see AppOverlay.xaml.cs's
                    EnsureOwnerWindowRoomForConfirm/RestoreOwnerWindowSize, called from
                    ShowConfirm/ShowConfirmAsync/HideConfirm) - fixed there. (2) Even with
                    more room, an unbounded StackPanel let a very long message push the
                    button row past the bottom. Splitting into a scrollable message row
                    ("*") + a fixed Auto button row below guarantees Yes/No/Cancel are
                    always fully rendered regardless of message length.
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
                            <TextBlock x:Name="ConfirmText" Text="Are you sure?" FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <Grid Grid.Row="1" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnYes" Style="{StaticResource DynamicContentButton}" Grid.Column="0" Margin="5" Height="32" MinWidth="80" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="CircleCheckSolid" Width="16" Height="16" Foreground="Green" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yes" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNo" Style="{StaticResource DynamicContentButton}" Grid.Column="1" Margin="5" Height="32" MinWidth="80" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="CircleXmarkSolid" Width="16" Height="16" Foreground="Red" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="No" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCancel" Style="{StaticResource DynamicContentButton}" Grid.Column="2" Margin="5" Height="32" MinWidth="80" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="BanSolid" Width="16" Height="16" Foreground="DarkOrange" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cancel" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>