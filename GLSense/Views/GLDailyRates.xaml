<utils:DpiAwareWindow x:Class="GLSense.Views.GLDailyRates" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:GLSense.Views" xmlns:utils="clr-namespace:GLSense.Utilities" xmlns:ctrls="clr-namespace:GLSense.Controls" xmlns:conv="clr-namespace:GLSense.Converters" xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" WindowStyle="None" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" SizeToContent="Manual" MinWidth="640" MaxWidth="700" MinHeight="400" MaxHeight="450" Background="#F8F9FA">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="LabelMinWidth">130</sys:Double>
            <sys:Double x:Key="ControlHeight">32</sys:Double>
            <Thickness x:Key="ControlMargin">6,0</Thickness>
            <Thickness x:Key="LabelMargin">0,0,6,0</Thickness>
            <sys:Double x:Key="RefEditMinWidth">200</sys:Double>
            <sys:Double x:Key="ComboMinWidth">200</sys:Double>
            <conv:NullableDateConverter x:Key="NullableDateConverter"/>
            <SolidColorBrush x:Key="SoftControlBorderBrush" Color="#D6DCE5"/>
            <Style x:Key="DailyRatesDatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource SoftControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4,0,4,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="MoneyCheckDollarSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock x:Name="TxtFuncName" Text="GLSense Daily Rates" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>
        <!-- ================= Main Content ================= -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Grid.IsSharedSizeScope="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Margin="0,0,0,2">
                <StackPanel>
                    <!-- ================= From Currency ================= -->
                    <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="EditorColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="RefColumn"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Currency From :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                            <ctrls:SuggestAppendComboBox x:Name="cmbFromCurrency" Grid.Column="1" Height="{StaticResource ControlHeight}" MinWidth="{StaticResource ComboMinWidth}" HorizontalAlignment="Stretch" ItemsSource="{Binding Currencies}" SelectedItem="{Binding FromCurrencyField.ComboValue, Mode=TwoWay}" Text="{Binding FromCurrencyField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" IsEnabled="{Binding FromCurrencyField.IsComboEnabled}"/>
                            <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" MinWidth="{StaticResource RefEditMinWidth}" HorizontalAlignment="Stretch" Style="{StaticResource CompactRefEditControl}" Text="{Binding FromCurrencyField.RefValue, Mode=TwoWay}" TagName="Daily Rate From Currency Field" Margin="{StaticResource ControlMargin}" IsEnabled="{Binding FromCurrencyField.IsRefEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!-- ================= To Currency ================= -->
                    <Border Style="{StaticResource CompactBorderStyle}" Margin="0,2,0,4" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="EditorColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="RefColumn"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Currency To :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                            <ctrls:SuggestAppendComboBox x:Name="cmbToCurrency" Grid.Column="1" Height="{StaticResource ControlHeight}" MinWidth="{StaticResource ComboMinWidth}" HorizontalAlignment="Stretch" ItemsSource="{Binding Currencies}" SelectedItem="{Binding ToCurrencyField.ComboValue, Mode=TwoWay}" Text="{Binding ToCurrencyField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" IsEnabled="{Binding ToCurrencyField.IsComboEnabled}"/>
                            <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" MinWidth="{StaticResource RefEditMinWidth}" HorizontalAlignment="Stretch" Style="{StaticResource CompactRefEditControl}" Text="{Binding ToCurrencyField.RefValue, Mode=TwoWay}" TagName="Daily Rate To Currency Field" Margin="{StaticResource ControlMargin}" IsEnabled="{Binding ToCurrencyField.IsRefEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!-- ================= Conversion Type ================= -->
                    <Border Style="{StaticResource CompactBorderStyle}" Margin="0,2,0,4" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="EditorColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="RefColumn"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Conversion Type :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtConversion" Grid.Column="1" Grid.ColumnSpan="2" Height="{StaticResource ControlHeight}" HorizontalAlignment="Stretch" Text="{Binding ConversionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" MinWidth="{StaticResource RefEditMinWidth}" Margin="{StaticResource ControlMargin}" Background="Transparent"/>
                        </Grid>
                    </Border>
                    <!-- ================= Currency Date ================= -->
                    <Border Style="{StaticResource CompactBorderStyle}" Margin="0,2,0,4" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="EditorColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="RefColumn"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Currency Date :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dtpDate" Grid.Column="1" Height="{StaticResource ControlHeight}" MinWidth="200" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedDateFormat="Short" SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=False, NotifyOnValidationError=True}" IsEnabled="{Binding DateField.IsComboEnabled}" Margin="{StaticResource ControlMargin}" BorderThickness="1" BorderBrush="{StaticResource SoftControlBorderBrush}" Background="White">
                                <DatePicker.Resources>
                                    <Style TargetType="{x:Type DatePickerTextBox}">
                                        <Setter Property="Control.Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                    <TextBox x:Name="PART_TextBox" Height="{StaticResource ControlHeight}" MinWidth="200" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource SoftControlBorderBrush}" Background="White" Padding="4,0,4,0" Text="{Binding Path=SelectedDate,
                                                RelativeSource={RelativeSource AncestorType={x:Type DatePicker}},
                                                Converter={StaticResource NullableDateConverter},
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=LostFocus}"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                            <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" MinWidth="{StaticResource RefEditMinWidth}" HorizontalAlignment="Stretch" Style="{StaticResource CompactRefEditControl}" Text="{Binding DateField.RefValue, Mode=TwoWay}" TagName="Daily Rate Currency Date Field" Margin="{StaticResource ControlMargin}" IsEnabled="{Binding DateField.IsRefEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!-- ================= Cell Reference ================= -->
                    <Border Style="{StaticResource CompactBorderStyle}" Margin="0,2,0,0" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="EditorColumn"/>
                                <ColumnDefinition Width="*" SharedSizeGroup="RefColumn"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Reference :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                            <local:ExcelRefEditControl x:Name="CellReference" Grid.Column="1" Grid.ColumnSpan="2" Height="{StaticResource ControlHeight}" HorizontalAlignment="Stretch" Style="{StaticResource CompactRefEditControl}" Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TagName="Daily Rate Cell Reference" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" MinWidth="{StaticResource RefEditMinWidth}" Margin="{StaticResource ControlMargin}" Background="Transparent"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <!-- ================= Action Buttons ================= -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="8,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSubmit" Style="{StaticResource InsertButtonStyle}" Click="BtnSubmit_Click" Margin="0,0,6,0">
                </Button>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>