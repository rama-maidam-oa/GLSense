<utils:DpiAwareWindow x:Class="GLSense.Views.GLServerConfiguration" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:utils="clr-namespace:GLSense.Utilities" 
					  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" 
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
					  xmlns:local="clr-namespace:GLSense.Views" WindowStyle="None" WindowStartupLocation="CenterOwner" 
					  SizeToContent="Manual" MinWidth="650" MaxWidth="720" MinHeight="500" MaxHeight="650" ResizeMode="CanResize" Background="#F8F9FA" Width="529">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- DataGrid Selection Highlight Colors (window-specific) -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E6F3FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F0F8FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>
            <!-- Status Message Styles -->
            <Style x:Key="SuccessMessage" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#155724"/>
                <Setter Property="Background" Value="#D4EDDA"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ErrorMessage" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#721C24"/>
                <Setter Property="Background" Value="#F8D7DA"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="DatabaseSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="Instance Configuration" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>
        <!-- ================= Data Grid Section ================= -->
        <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DataGrid x:Name="dgInstances" FontFamily="Segoe UI" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" Background="White" BorderThickness="0" CellEditEnding="DgInstances_CellEditEnding" SelectionChanged="DgInstances_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2E86AB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderBrush" Value="#1B6B93"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,6,0" Width="10" Height="6" Stretch="Fill" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" Data="M 0 4 L 5 0 L 10 4 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="border" Value="#389BC7"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" TargetName="border" Value="#277596"/>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Ascending">
                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 5 0 L 10 4 Z"/>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Descending">
                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 5 4 L 10 0 Z"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F8F9FA"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#212529"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="36"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F8FF"/>
                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E6F3FF"/>
                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="URL Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="Friendly name for the server instance" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="Naming tips:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                                <TextBlock Text="• Use descriptive names" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Example: 'Production Server'" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Avoid special characters" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditableDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <TextBlock Text="Enter a friendly name for this server instance" TextWrapping="Wrap"/>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="URL Address" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="Server connection URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Address}" TextWrapping="Wrap"/>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="Format examples:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                                <TextBlock Text="• http://server.domain.com:port/reporting" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• http://localhost:8080/reporting" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Include protocol (http/https)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditableDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="Enter the complete server URL address" TextWrapping="Wrap"/>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="Required format:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                                <TextBlock Text="• Protocol (http:// or https://)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Server name or IP address" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Port number (if not default)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="• Example: https://api.example.com:8443" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Border>
        <!-- ================= Action Buttons Section ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Status Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus" FontFamily="Segoe UI" Foreground="#6C757D" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnUpdate" Content="Add" Style="{StaticResource DynamicContentButton}" Click="BtnUpdate_Click" Margin="0,0,8,0">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Add a new server configuration" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="Adds a blank row for:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                <TextBlock Text="• New server name" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Server URL/address" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Click in cells to edit values" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnDelete" Content="Delete" Style="{StaticResource DynamicContentButton}" Click="BtnDelete_Click" Margin="0,0,8,0">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Delete selected server configuration" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="Requirements:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                <TextBlock Text="• Select a row first" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Cannot delete all servers" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                <TextBlock Text="• At least one server must remain" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Action cannot be undone" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ================= Toast/Busy Overlay ================= -->
        <local:AppOverlay x:Name="AppOverlayControl" Margin="0" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>