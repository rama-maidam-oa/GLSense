<Window x:Class="GLSense.GLReleaseHistoryBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GLSense Version History"
        Icon="/GLSense;component/Resources/OrbitGLSense.ico"
        Width="810" Height="530"
        MinWidth="730" MinHeight="450"
        MaxWidth="950" MaxHeight="800"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F6"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#82B6CD"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FFF9DB"/>
            <Setter Property="Foreground" Value="#3C3C3C"/>
            <Setter Property="BorderBrush" Value="#FBB41A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style x:Key="BrowserButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#263942"/>
            <Setter Property="BorderBrush" Value="#CBD8DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2E86AB"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2E86AB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1B6B93"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1B6B93"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2E86AB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#1B6B93"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style x:Key="TrimmedCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ReleaseCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5EBEF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DBE4EA"
                BorderThickness="0,0,0,1">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                <Border Width="32" Height="32" Background="#2E86AB" CornerRadius="16" Margin="0,0,12,0">
                    <Path Data="M7,16 L13,22 L25,9"
                              Stroke="White"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GLSense Version History"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#1F2D38"/>
                    <TextBlock Text="Versions adopted on this machine."
                               FontSize="12"
                               Foreground="#6B7883"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="Version catalog"
                       FontSize="11"
                       Foreground="#60727D"
                       Margin="0,0,20,0"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#F4F8FB"
                    BorderBrush="#D9E8EF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="13,10"
                    Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <Border Width="24" Height="24" Background="#2E86AB" CornerRadius="12" DockPanel.Dock="Left" Margin="0,0,9,0">
                        <TextBlock Text="i"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtStatus"
                               Foreground="#536772"
                               FontSize="12.5"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <Run Text="Select a version, then click "/>
                        <Run Text="Load or Remove" FontWeight="SemiBold"/>
                        <Run Text="."/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#D6E0E7"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinHeight="210">
                <DataGrid x:Name="GridReleases"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#FBFCFD"
                          BorderThickness="0"
                          SelectionChanged="GridReleases_SelectionChanged"
                          ToolTip="Every GLSense version adopted on this machine."
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="38"/>
                            <Setter Property="Foreground" Value="#263942"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrentlyLoaded}" Value="True">
                                    <Setter Property="Background" Value="#EAF5FA"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STATUS" Width="97" MinWidth="97">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Status - identifies the version currently running in this Excel session."/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ReleaseCellStyle}">
                                    <Setter Property="Padding" Value="3,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentlyLoaded}" Value="True">
                                            <Setter Property="ToolTip" Value="Running in the active GLSense AppDomain."/>
                                            <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusPill"
                                            Width="86"
                                            Height="24"
                                            Background="#EAF5FA"
                                            BorderBrush="#8FC3D9"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentlyLoaded}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="#2E86AB"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="RUNNING"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#236B89"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="90" MinWidth="90" ElementStyle="{StaticResource TrimmedCellTextStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Version - the version number."/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ReleaseCellStyle}">
                                    <Setter Property="ToolTip" Value="{Binding Version}"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="VERSION DATE" Binding="{Binding ReleaseDate}" Width="160" MinWidth="160" ElementStyle="{StaticResource TrimmedCellTextStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Version Date - when this version was built."/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ReleaseCellStyle}">
                                    <Setter Property="ToolTip" Value="{Binding ReleaseDate}"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="80" MinWidth="80" ElementStyle="{StaticResource TrimmedCellTextStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Source - how this version was obtained."/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ReleaseCellStyle}">
                                    <Setter Property="ToolTip" Value="{Binding Source}"/>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="*" MinWidth="250" ElementStyle="{StaticResource TrimmedCellTextStyle}">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Notes - the recorded note for this version."/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ReleaseCellStyle}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip>
                                                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" MaxWidth="320"/>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <DockPanel Grid.Row="2"
                       Margin="4,9,4,0"
                       LastChildFill="True"
                       ToolTip="The GLSense version currently running in this Excel session.">
                <Border Width="18"
                        Height="18"
                        Background="#2E86AB"
                        CornerRadius="9"
                        DockPanel.Dock="Left"
                        Margin="0,0,7,0">
                    <TextBlock Text="i"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtLoadedStatus"
                           FontSize="11"
                           Foreground="#6B7883"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Background="#F7F9FB" BorderBrush="#DBE4EA" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Loading a version safely restarts the GLSense addin without restarting Excel."
                           FontSize="11.5"
                           Foreground="#6B7883"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLoad"
                            Content="Load"
                            Style="{StaticResource BrowserButton}"
                            IsEnabled="False"
                            Click="BtnLoad_Click"
                            ToolTip="Load the selected version without restarting Excel. Older versions can be loaded intentionally."/>
                    <Button x:Name="BtnRemove"
                            Content="Remove"
                            Style="{StaticResource BrowserButton}"
                            IsEnabled="False"
                            Click="BtnRemove_Click"
                            ToolTip="Permanently remove the selected non-active version from this machine."/>
                    <Button x:Name="BtnCancel"
                            Content="Close"
                            Style="{StaticResource BrowserButton}"
                            Click="BtnCancel_Click"
                            ToolTip="Close this window without changing the loaded version."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
