<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                    xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== SuggestAppendComboBox Multi-Select Template ==================== -->
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type ctrls:SuggestAppendComboBox}, ResourceId=SuggestMultiSelectItemTemplate}">
        <StackPanel Orientation="Horizontal">
            <!-- This is the DataTemplate actually rendered for each multi-select popup
                 row (looked up via TryFindResource(ComponentResourceKey) in
                 SuggestAppendComboBox.cs's UpdateListBoxTemplate) - the FrameworkElementFactory
                 fallback built in that code-behind only runs if THIS resource is missing,
                 so it never executes while this template exists, and Padding changes made
                 there have no visible effect. This CheckBox has no explicit Style, so it
                 picks up GlobalStyles.xaml's implicit (no x:Key) CheckBox style, whose
                 SafeCheckBoxTemplate wires ContentPresenter Margin="{TemplateBinding Padding}" -
                 so setting Padding directly here IS the correct, effective way to add a
                 gap between the check glyph and its text. -->
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Content="{Binding}"
                      Padding="6,0,0,0"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== SuggestAppendComboBox Style ==================== -->
    <Style TargetType="{x:Type ctrls:SuggestAppendComboBox}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <!-- Neither this style nor PART_TextBox set FontSize anywhere, so this was the
             one input control in the app rendering at the ambient/system default
             (larger than intended, and inconsistent across windows) instead of a
             deliberate, consistent value. 12 matches this codebase's existing "compact
             control" convention (see ModernButton in GlobalStyles.xaml) - a size step
             down from the 13 used for primary input text (ModernTextBox/Label/
             ExcelRefEditControl), which reads well for a dense dropdown list.
             CORRECTION: this Setter's value flows into PART_TextBox via normal
             logical-tree inheritance (it's part of this same ControlTemplate), but NOT
             into PART_ListBox/ListBoxItem - WPF Popups are a separate visual tree root
             and do not participate in property-value inheritance from their logical
             parent, so the dropdown list was still rendering at the ambient default
             even after this Setter was added. Fixed by explicitly
             FontSize="{TemplateBinding FontSize}" on PART_ListBox below (see that
             element) - ListBoxItem then inherits correctly from ITS OWN parent
             ListBox, which is now set right. -->
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="ArrowBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="ArrowWidth" Value="10"/>
        <Setter Property="ArrowHeight" Value="8"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrls:SuggestAppendComboBox}">
                    <Border x:Name="OuterBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PopupStates">
                                <VisualState x:Name="PopupClosed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="0"
                                                         Duration="0:0:0.1"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PopupOpen">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="180"
                                                         Duration="0:0:0.1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- TextBox -->
                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     FontFamily="Segoe UI"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="{TemplateBinding Padding}"
                                     VerticalContentAlignment="Center"
                                     Foreground="{TemplateBinding Foreground}"
                                     Focusable="True"
                                     SelectionBrush="{StaticResource PrimaryBrush}" >
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconFontAwesome Kind="MagnifyingGlassSolid"
                                                               Width="12"
                                                               Height="12"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                <TextBlock Text="Current Selection" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="toolTipTextBlock"
                                                       FontFamily="Segoe UI" 
                                                       Background="{StaticResource BackgroundBrush}" 
                                                       Padding="4" 
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="300"
                                                       Text="No selection"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Background="{StaticResource TooltipBorderBrush}" 
                                                    CornerRadius="4" 
                                                    Padding="8,6" 
                                                    Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                                   Width="12"
                                                                   Height="12"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                    <TextBlock Text="Type to search or select from dropdown" 
                                                               FontSize="11"
                                                               FontStyle="Italic"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>

                            <!-- DropDown Button -->
                            <Button x:Name="PART_DropDownButton"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="0,0,4,0"
                                    Focusable="False"
                                    Cursor="Hand" >
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconFontAwesome Kind="ListSolid"
                                                               Width="12"
                                                               Height="12"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                <TextBlock Text="Show Options" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="Click to show all available options" 
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Grid Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="ArrowPath"
                                          Data="M 0 0 L 8 0 L 4 4 Z"
                                          Fill="{TemplateBinding ArrowBrush}"
                                          Stretch="Uniform"
                                          Width="{TemplateBinding ArrowWidth}"
                                          Height="{TemplateBinding ArrowHeight}">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ArrowRotate" Angle="0" CenterX="4" CenterY="2"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Button>

                            <!-- Clear Button -->
                            <Button x:Name="PART_ClearButton"
                                    Grid.Column="2"
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,4,0"
                                    Visibility="Collapsed"
                                    Background="Transparent"
                                    BorderThickness="0" >
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconFontAwesome Kind="SquareXmarkSolid"
                                                               Width="12"
                                                               Height="12"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                <TextBlock Text="Clear Selection" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="Click to clear the current selection" 
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <iconPacks:PackIconFontAwesome Kind="XmarkSolid" Width="12" Height="12" Foreground="{StaticResource PrimaryBrush}"/>
                            </Button>

                            <!-- Popup - FIXED: White background matching window -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   HorizontalOffset="0">
                                <Border Background="{StaticResource WhiteBrush}"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="240"
                                        SnapsToDevicePixels="True">
                                        <!-- Regression fix: PART_ListBox used to be wrapped in its own
                                             separate <ScrollViewer>, ON TOP OF the ListBox's own internal
                                             ScrollViewer (already enabled below via the
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" attached
                                             property). Nesting a ScrollViewer around a control that
                                             already hosts its own ScrollViewer is a well-known WPF trap:
                                             PreviewMouseWheel tunnels from the outside in, so the OUTER
                                             ScrollViewer saw every wheel event first - and since its own
                                             content (the ListBox, capped at MaxHeight="200" inside a
                                             MaxHeight="240" Border) rarely had any scrollable range of its
                                             own, the event was swallowed there instead of ever reaching the
                                             ListBox's inner ScrollViewer, so the mouse wheel neither
                                             scrolled the popup nor moved the scrollbar thumb. Removed the
                                             redundant outer ScrollViewer entirely - the ListBox's own
                                             internal ScrollViewer (still Auto-visibility) now receives wheel
                                             input directly and scrolls normally. Moved the ScrollBar style
                                             override from the removed ScrollViewer.Resources onto the
                                             ListBox's own Resources so the themed scrollbar still applies. -->
                                        <ListBox x:Name="PART_ListBox"
                                                 FontFamily="Segoe UI"
                                                 FontSize="{TemplateBinding FontSize}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 KeyboardNavigation.TabNavigation="Cycle"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MaxHeight="200"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.ScrollUnit="Pixel">
                                            <ListBox.Resources>
                                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AppScrollBarStyle}"/>
                                            </ListBox.Resources>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,6"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" 
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="3"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="#E6F3FF"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter Property="Opacity" Value="0.5"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <!-- ===== TRIGGERS - FIXED: Light border like textbox ===== -->
                    <ControlTemplate.Triggers>
                        <!-- FIXED: Light border when focused - like textbox -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="1" />
                        </Trigger>

                        <!-- Mouse over - light border -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="1" />
                        </Trigger>

                        <!-- Popup open - light border -->
                        <Trigger SourceName="PART_Popup" Property="IsOpen" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="1" />
                            <Setter Property="Tag" Value="PopupOpen"/>
                        </Trigger>

                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBorder" Property="Background" Value="#F5F5F5" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter TargetName="PART_TextBox" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter TargetName="PART_ClearButton" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter TargetName="ArrowPath" Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>