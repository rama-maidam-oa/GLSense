    <!-- ==================== DatePicker Style ==================== -->
    <!-- The stock WPF DatePicker's default (Aero2/Fluent-theme) calendar toggle button
         draws a small vector glyph that several windows' custom DatePickerTextBox
         overrides (which only replace the PART_TextBox portion, not the whole control)
         leave looking tiny/barely visible next to this app's other, consistently-larger
         iconPacks glyphs used everywhere else. Replaces the whole ControlTemplate with a
         bordered Grid + an explicit PART_TextBox/PART_Button pair, using the same
         CalendarDaysSolid FontAwesome icon already used for this app's period/date
         windows, at a fixed, clearly visible size. PART_Popup is left as a bare Popup -
         DatePicker itself creates and assigns the Calendar into it at runtime, so no
         Calendar element needs to be declared here. -->
    <Style x:Key="ModernDatePicker" TargetType="DatePicker">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" Background="Transparent" BorderThickness="0" Margin="6,0,0,0" VerticalContentAlignment="Center" Focusable="{TemplateBinding IsEnabled}"/>
                        <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <iconPacks:PackIconFontAwesome Kind="CalendarDaysSolid" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== TextBox Styles ==================== -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="1"/>
