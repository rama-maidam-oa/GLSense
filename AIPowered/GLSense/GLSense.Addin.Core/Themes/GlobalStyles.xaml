<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                    xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                    xmlns:views="clr-namespace:GLSense.Addin.Core.Views">

    <!-- ==================== Color Resources ==================== -->
    <Color x:Key="PrimaryColor">#2E86AB</Color>
    <Color x:Key="PrimaryDarkColor">#1B6B93</Color>
    <Color x:Key="PrimaryDarkerColor">#165A7A</Color>
    <Color x:Key="SecondaryColor">#6C757D</Color>
    <Color x:Key="SecondaryDarkColor">#5A6268</Color>
    <Color x:Key="SecondaryDarkerColor">#495057</Color>
    <Color x:Key="DangerColor">#EC616E</Color>
    <Color x:Key="DangerDarkColor">#E62E40</Color>
    <Color x:Key="DangerDarkerColor">#D02B3B</Color>
    <Color x:Key="SuccessColor">#28A745</Color>
    <Color x:Key="WarningColor">#FFC107</Color>
    <Color x:Key="InfoColor">#17A2B8</Color>
    <Color x:Key="TextPrimaryColor">#212529</Color>
    <Color x:Key="TextSecondaryColor">#6C757D</Color>
    <Color x:Key="BackgroundColor">#F8F9FA</Color>
    <Color x:Key="BorderColor">#DEE2E6</Color>
    <Color x:Key="BorderLightColor">#E9ECEF</Color>
    <Color x:Key="BorderLightGrayColor">#E0E0E0</Color>
    <Color x:Key="TooltipBackgroundColor">#FFF9DB</Color>
    <Color x:Key="TooltipBorderColor">#FBB41A</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <Color x:Key="WindowTitleBarColor">#2E86AB</Color>

    <!-- ==================== Brush Resources ==================== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkerBrush" Color="{StaticResource PrimaryDarkerColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDarkColor}"/>
    <SolidColorBrush x:Key="SecondaryDarkerBrush" Color="{StaticResource SecondaryDarkerColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}"/>
    <SolidColorBrush x:Key="DangerDarkerBrush" Color="{StaticResource DangerDarkerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{StaticResource TooltipBackgroundColor}"/>
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="{StaticResource TooltipBorderColor}"/>
    <SolidColorBrush x:Key="DataGridSelectedBrush" Color="{StaticResource BorderLightGrayColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="WindowTitleBarBrush" Color="{StaticResource WindowTitleBarColor}"/>

    <!-- ==================== Chrome-Style ToolTip ==================== -->
    <Style x:Key="ChromeStyleToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource TooltipBackgroundBrush}"
                            BorderBrush="{StaticResource TooltipBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            MaxWidth="400">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" 
                                              Opacity="0.15" 
                                              BlurRadius="8" 
                                              ShadowDepth="2" 
                                              Direction="315"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" 
                                    Background="{StaticResource TooltipBorderBrush}"
                                    CornerRadius="4,4,0,0"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="LightbulbRegular"
                                                   Width="12"
                                                   Height="12"
                                                   Foreground="Black"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="TIP"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="Black"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Padding="12,10">
                                <ContentPresenter ContentSource="Content"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SimpleBrowserToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource TooltipBackgroundBrush}"/>
        <Setter Property="Foreground" Value="#3C3C3C"/>
        <Setter Property="BorderBrush" Value="{StaticResource TooltipBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="HasDropShadow" Value="True"/>
    </Style>

    <!-- ==================== Title Bar Styles ==================== -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" x:Name="border">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF30"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF20"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value="Close"/>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                    <TextBlock Text="Click to close this window!"/>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title-bar "X" close icon (transparent/white, title-bar sized - used in the custom
         title bar Grid of every window). Do NOT use this for a visible dialog "Close" action
         button - it is unreadable off the dark title bar background. Use CloseButtonStyle
         below for that instead. -->
    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" x:Name="border">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#BF0F1A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarGridStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource WindowTitleBarBrush}"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <Style x:Key="TitleBarIconStyle" TargetType="iconPacks:PackIconFontAwesome">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="TitleBarTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ==================== Icon Styles (FontAwesome) ==================== -->
    <Style x:Key="SmallIcon" TargetType="iconPacks:PackIconFontAwesome">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="VerySmallIcon" TargetType="iconPacks:PackIconFontAwesome">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MediumIcon" TargetType="iconPacks:PackIconFontAwesome">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LargeIcon" TargetType="iconPacks:PackIconFontAwesome">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==================== Card Styles ==================== -->
    <Style x:Key="LoginCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="Padding" Value="15"/>
    </Style>

    <Style x:Key="ContentBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="15,10"/>
    </Style>

    <Style x:Key="LabelIconBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- ==================== Label Styles ==================== -->
    <Style x:Key="LabelWithIconStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <!-- Blue (PrimaryBrush), not TextPrimaryBrush (dark charcoal) - field-prompt
             labels across the app were an inconsistent mix of blue (HeaderTextBlock,
             used by GLSegmentRef/GLSegmentManager/GLSegmentValues/GLRollerGroups/
             GLLOVs/GLJobsMonitor/GLBalanceConfigurator) and near-black (this style, and
             every plain Label using TextPrimaryBrush). Standardized on blue everywhere. -->
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LabelIconStyle" TargetType="iconPacks:PackIconFontAwesome">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeaderTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ==================== Button Styles ==================== -->
    <!--
    Plain Border+ContentPresenter template, no default chrome hover/pressed overlay -
    used by GLMessageWindow's dynamically-created OK/Yes/No/Cancel buttons (built via
    `new Button { Background = ... }` in code-behind, with hover/pressed colors swapped
    manually in MouseEnter/MouseLeave/PreviewMouseDown/PreviewMouseUp) so those
    already-correct, computed colors render exactly as set instead of being washed out
    by WPF's default Button chrome, which layers its own theme-driven highlight overlay
    on top of Background on hover - that overlay is what made the OK button look like
    it faded to near-transparent/white on hover instead of the intended, slightly
    lighter blue, unlike the Close button (CloseButtonStyle/DynamicContentButton) which
    already uses an explicit template like this one and hovers correctly.
    -->
    <ControlTemplate x:Key="PlainButtonTemplate" TargetType="Button">
        <Border Background="{TemplateBinding Background}"
                CornerRadius="4"
                BorderThickness="0"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}" 
                            CornerRadius="4" 
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDarkerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DynamicContentButton" TargetType="Button">
        <Setter Property="Background" Value="#F8F9FA"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#D0D4D8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#256D8F"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#256D8F"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#1E5775"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#D3D8DC"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#B0B6BC"/>
                            <Setter Property="Foreground" Value="#6C757D"/>
                            <Setter Property="Opacity" Value="0.75"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Visible dialog/footer "Close" action button - based on the regular button style
         (DynamicContentButton), not the title-bar style, so it is actually visible against a
         light window background. -->
    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DynamicContentButton}">
        <Setter Property="Content" Value="Close"/>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                    <TextBlock Text="Click to close this window!"/>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DynamicContentButton}">
        <Setter Property="Content" Value="Cancel"/>
        <Setter Property="MaxWidth" Value="100"/>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                    <TextBlock Text="Click to cancel process!"/>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InsertButtonStyle" TargetType="Button" BasedOn="{StaticResource DynamicContentButton}">
        <Setter Property="Content" Value="Insert"/>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                    <TextBlock Text="Inserts formula or values to the selected cell reference!" TextWrapping="Wrap"/>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button with icon templates -->
    <Style x:Key="AddToRightButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Content">
            <Setter.Value>
                <iconPacks:PackIconFontAwesome Kind="RightLongSolid" Width="20" Height="20" Foreground="White"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Style="{StaticResource ChromeStyleToolTip}">
                    <StackPanel>
                        <TextBlock Text="Adds the selected items to right grid" TextWrapping="Wrap"/>
                        <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Select all in a page by pressing Ctrl+A" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RemoveFromRightGridButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Content">
            <Setter.Value>
                <iconPacks:PackIconFontAwesome Kind="LeftLongSolid" Width="20" Height="20" Foreground="White"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Style="{StaticResource ChromeStyleToolTip}">
                    <StackPanel>
                        <TextBlock Text="Removes the selected items from right grid" TextWrapping="Wrap"/>
                        <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Select all in a page by pressing Ctrl+A" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BetweenGridButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Content">
            <Setter.Value>
                <iconPacks:PackIconFontAwesome Kind="RightLeftSolid" Width="20" Height="20" Foreground="White"/>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Style="{StaticResource ChromeStyleToolTip}">
                    <StackPanel>
                        <TextBlock Text="Adds first and last items from selection as a range to right grid" TextWrapping="Wrap"/>
                        <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Select any 2 items holding Ctrl key or select a range with holding Shift key" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group H (GLSegmentValues) addition - "Not Between" range-exclusion button, sibling
         to BetweenGridButtonStyle above (adds the first/last selected items as an
         excluded range, i.e. old GLSegmentValues.BtnNotBetween_Click ->
         AddBetweenSelection(items, isExclude: true)). Now that this project uses
         FontAwesome (see the FontAwesome icon migration), it has the same dedicated
         "range + ban" overlay glyph FinalWorkingCode's ExcludeButtonStyle-adjacent
         combo icon uses, instead of reusing BetweenGridButtonStyle's plain icon. -->
    <Style x:Key="NotBetweenGridButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Content">
            <Setter.Value>
                <Grid Width="22" Height="22">
                    <iconPacks:PackIconFontAwesome Kind="RightLeftSolid" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                    <iconPacks:PackIconFontAwesome Kind="BanSolid" Width="16" Height="16" Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.85"/>
                </Grid>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Style="{StaticResource ChromeStyleToolTip}">
                    <StackPanel>
                        <TextBlock Text="Adds first and last items from selection as an EXCLUDED range to right grid" TextWrapping="Wrap"/>
                        <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Select any 2 items holding Ctrl key or select a range with holding Shift key" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExcludeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
