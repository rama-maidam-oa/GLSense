    <Style x:Key="ReadOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="#F5F5F5"/>
    </Style>

    <!-- ==================== CheckBox Styles ==================== -->
    <!--
    Plain property-Trigger template (no VisualStateManager/Storyboard transitions) -
    the default Aero2 CheckBox template's built-in animated "CheckStates"
    VisualStateGroup is the source of a "Storyboard was never applied to this object"
    Seek warning that fires whenever a bound CheckBox (many in this app bind IsChecked
    directly at construction time, e.g. GLSegmentRef/GLSegmentManager/GLSegmentValues'
    IsSummaryChecked grid column, GLBalanceConfigurator's ChkSign/ChkZeroes,
    GLUserConfig's RunAsJob/IncludeManualJournal) has its value set/toggled before the
    control has fully finished templating. Removing the VSM/Storyboard machinery
    entirely removes the warning at its source rather than just silencing trace
    output, and keeps the glyph on the same FontAwesome icon set used everywhere else
    in this project. Shared as a keyed resource so both ModernCheckBox (below) and the
    implicit, no-x:Key CheckBox style further down (which catches every CheckBox in
    this app that doesn't reference ModernCheckBox/CompactCheckBox explicitly) apply
    the exact same fix.
    -->
    <ControlTemplate x:Key="SafeCheckBoxTemplate" TargetType="CheckBox">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CheckBoxBorder"
                    Grid.Column="0"
                    Width="16" Height="16"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#ADB5BD"
                    BorderThickness="1.5"
                    CornerRadius="3">
                <iconPacks:PackIconFontAwesome x:Name="CheckGlyph"
                                                Kind="CheckSolid"
                                                Width="10" Height="10"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource SafeCheckBoxTemplate}"/>
    </Style>

    <Style x:Key="CompactCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <!-- Implicit (no x:Key) CheckBox style - applies automatically to every CheckBox
         in this app that doesn't set an explicit Style, e.g. the DataGrid cell
         templates in GLSegmentRef/GLSegmentManager/GLSegmentValues,
         GLBalanceConfigurator's ChkSign/ChkZeroes, GLSegmentFunctions'
         ChkIncludeSegmentValues, GLUserConfig's RunAsJob/IncludeManualJournal, and the
         multi-select item template in Generic.xaml. Only sets Template so these
         CheckBoxes keep whatever font/foreground they already declared inline -
         it exists purely to remove the same Storyboard/VSM warning everywhere,
         not to reskin them. -->
    <Style TargetType="CheckBox">
        <Setter Property="Template" Value="{StaticResource SafeCheckBoxTemplate}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

