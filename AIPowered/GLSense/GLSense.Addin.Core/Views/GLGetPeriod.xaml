<local:DpiAwareWindow x:Class="GLSense.Addin.Core.Views.GLGetPeriod"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sys="clr-namespace:System;assembly=mscorlib"
                      xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                      xmlns:utils="clr-namespace:GLSense.Addin.Core.Utilities"
                      xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                      xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                      WindowStyle="None" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" SizeToContent="Manual"
                      MinWidth="600" MaxWidth="700" MinHeight="360" MaxHeight="450" Background="#F8F9FA">
    <local:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="LabelMinWidth">100</sys:Double>
            <sys:Double x:Key="ControlHeight">32</sys:Double>
            <Thickness x:Key="ControlMargin">6,0</Thickness>
            <Thickness x:Key="LabelMargin">0,0,6,0</Thickness>
            <sys:Double x:Key="RefEditMinWidth">200</sys:Double>
        </ResourceDictionary>
    </local:DpiAwareWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main content: shrinks/grows to fit the form fields -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="CalendarDaysSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="Get Period" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= Middle Content ================= -->
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top" Margin="0,5,0,4">
            <StackPanel>
                <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Ledger :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox x:Name="cmbLedgers" Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding Ledgers}" DisplayMemberPath="LedgerName" SelectedItem="{Binding LedgerField.ComboValue, Mode=TwoWay}" Text="{Binding LedgerField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" IsEnabled="{Binding LedgerField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding LedgerField.RefValue, Mode=TwoWay}" TagName="Periods Ledgers Field" Margin="0,0,0,0" IsEnabled="{Binding LedgerField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Period :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox x:Name="cmbPeriods" Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding Periods}" DisplayMemberPath="PeriodName" SelectedItem="{Binding PeriodField.ComboValue, Mode=TwoWay}" Text="{Binding PeriodField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" IsEnabled="{Binding PeriodField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding PeriodField.RefValue, Mode=TwoWay}" TagName="Periods Period Field" Margin="0,0,0,0" IsEnabled="{Binding PeriodField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Offset :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox x:Name="cmbOffset" Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding OffsetValues}" SelectedItem="{Binding OffsetField.ComboValue, Mode=TwoWay}" Text="{Binding OffsetField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding OffsetField.IsComboEnabled}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding OffsetField.RefValue, Mode=TwoWay}" TagName="Periods Offset Field" Margin="0,0,0,0" IsEnabled="{Binding OffsetField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Result :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtResult" Grid.Column="1" Grid.ColumnSpan="2" Height="{StaticResource ControlHeight}" Style="{StaticResource ReadOnlyTextBox}" Text="{Binding ResultText, Mode=OneWay}" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <StackPanel>
                                        <TextBlock Text="Calculated period start and end dates" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Reference :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <local:ExcelRefEditControl x:Name="CellReference" Grid.Column="1" Grid.ColumnSpan="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TagName="Periods Cell Reference" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Buttons Section ================= -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSubmit" Style="{StaticResource InsertButtonStyle}" Click="BtnSubmit_Click" Margin="0,0,8,0"/>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</local:DpiAwareWindow>
