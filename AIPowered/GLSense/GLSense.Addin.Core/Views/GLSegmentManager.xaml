<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLSegmentManager"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:conv="clr-namespace:GLSense.Addin.Core.Converters"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  mc:Ignorable="d"
                  WindowCaption="Segment Manager"
                  IconSymbol="FilterSolid"
                  SizeToContent="Manual"
                  Width="990" Height="820"
                  MinWidth="940" MaxWidth="1100"
                  MinHeight="750" MaxHeight="900"
                  ResizeMode="CanResize"
                  WindowStyle="SingleBorderWindow"
                  ExtendsContentIntoTitleBar="True"
                  Loaded="Window_Loaded">

    <!--
        GLSegmentManager - master-detail redesign of GLSegmentRef, trialed side by side
        with it (see this file's .xaml.cs header for the full rationale). Same
        SegmentSelectorViewModel, same "Ref" windowName, same GLSegments_SelectedValue
        contract - only the layout differs: a single segment list on the left replaces
        the stacked per-segment Value/Reference row list, and the Value/Reference/
        Hierarchy/Search/dual-grid controls on the right now operate on whichever segment
        is selected in that list instead of whichever row last had keyboard focus.

        Layout (CLAUDE.md section 26 - read that before touching this file's structure):
        the "Segments" list on the left spans every row of the right-hand stack (Value/
        Reference, Hierarchy, Search, the dual DataGrids, and Pagination) via a plain
        Grid.RowSpan, so it always matches that stack's total height with zero bindings
        and zero SizeToContent-dependent tricks. Pagination lives inside the right-hand
        column (matching the DataGrids' width, not the full window), and only the final
        Buttons/Actions footer spans the full window width below everything - matching
        the user's own wireframe.

        SizeToContent="Manual" with a fixed Width/Height (section 26.8): this window used
        to be SizeToContent="WidthAndHeight", matching the convention most other
        DataGrid-containing BaseWindows use (GLCubeDetails, GLUserConfig,
        GLServerConfiguration, GLLOVs, GLRollerGroups - CLAUDE.md section 1.5). But every
        crash/resize regression this window has had (26.3.1-26.3.5, 26.7 item 2) traced
        back to that same root cause: a content-driven window re-measures on EVERY layout
        pass, so anything that transiently changes a DataGridColumn's natural width (the
        DataGridColumnFillHelper Auto-remeasure trick, a segment switch loading longer
        Account descriptions, etc.) can transiently balloon the WHOLE WINDOW before
        settling back down - and that settle-back-down step doesn't always leave the
        DataGrid's columns/scrollbar in the state they started in. GLSegmentValues.xaml
        (this window's non-master-detail sibling, same dual-grid/pagination shape) never
        has any of these problems, precisely because it's SizeToContent="Manual" with a
        fixed Width/Height - its DataGrid columns use plain, native Width="*" and are
        never re-measured by the window at all when data changes. Converted this window
        to match: fixed Width/Height (resizable between the same Min/Max bounds as
        before), dgLeft's "Description" and dgRight's "Segment" columns changed from
        Width="Auto" (driven by the now-removed DataGridColumnFillHelper) to plain
        Width="*", exactly like GLSegmentValues. This also means BaseWindow's
        SizeToContent-only resettle/pump-dispatcher-frame machinery (CLAUDE.md 1.4/1.4e -
        the source of this window's original hang/crash saga) no longer runs for this
        window at all (`OnLoaded`/`OnContentRendered` both skip it when
        `SizeToContent == Manual`), matching GLSegmentValues exactly.

        RootGrid's main-content row and the dual-DataGrid row below are both "*", which
        is completely ordinary WPF star-sizing now that the window has a fixed Height -
        no SizeToContent-driven infinite-measure risk applies to a "*" row under Manual
        sizing (this is exactly the same RootGrid row shape GLSegmentValues.xaml already
        uses: 32 / * / Auto / Auto).
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:SegmentSummaryConverter x:Key="SegmentSummaryConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="{Binding WindowCaption, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="BtnClose_Click"/>
        </Grid>

        <!-- ================= Main Content: Segment list + Detail panel + Pagination ================= -->
        <!-- Segments (Column 0) uses Grid.RowSpan="5" to span every row on the right
             (Column 1) - the standard, bulletproof WPF way to make a sidebar match a
             multi-row content column's total height. This is a hard Grid-arrange
             guarantee, not dependent on SizeToContent/Auto/Star measure quirks and not a
             binding, so it carries none of the risk the two earlier attempts had. -->
        <Grid Grid.Row="1" Margin="10" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Segment List -->
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,8,0" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Segments" Style="{StaticResource HeaderTextBlock}" Margin="4,0,0,8"/>
                    <ListBox x:Name="lstSegments" ItemsSource="{Binding Segments}" SelectedItem="{Binding SelectedSegment, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}"/>
                            <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}"/>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="6" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#F0F8FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E6F3FF"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#2E86AB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Testing feedback (26.7/26.8): tooltip showing the segment's
                                     full name + status, matching the SimpleBrowserToolTip
                                     pattern already used elsewhere in this window (Search box,
                                     Is-Summary checkbox, pagination "Showing:") - useful since
                                     the subtitle line below is truncated with an ellipsis. -->
                                <StackPanel Margin="6,2">
                                    <StackPanel.ToolTip>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SegmentName}" FontWeight="SemiBold"/>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource SegmentSummaryConverter}">
                                                            <Binding Path="Value"/>
                                                            <Binding Path="Reference"/>
                                                            <Binding Path="SelectedValues.Count"/>
                                                            <Binding Path="IsUserSelected"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </StackPanel.ToolTip>
                                    <TextBlock Text="{Binding SegmentName}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SegmentSummaryConverter}">
                                                <Binding Path="Value"/>
                                                <Binding Path="Reference"/>
                                                <Binding Path="SelectedValues.Count"/>
                                                <Binding Path="IsUserSelected"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Value / Reference -->
            <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource WhiteBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SegLabelCol"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Value:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Height="30" Style="{StaticResource ModernTextBox}" Text="{Binding SelectedSegment.Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding SelectedSegment.IsTextEnabled, FallbackValue=False}"/>
                    <TextBlock Grid.Column="2" Text="Reference:" Style="{StaticResource HeaderTextBlock}" Margin="12,0,8,0" VerticalAlignment="Center"/>
                    <local:ExcelRefEditControl Grid.Column="3" Height="30" TagName="{Binding SelectedSegment.SegmentName}" Text="{Binding SelectedSegment.Reference, Mode=TwoWay}" IsEnabled="{Binding SelectedSegment.IsRefEditEnabled, FallbackValue=False}"/>
                </Grid>
            </Border>

            <!-- Hierarchy -->
            <!-- IsEnabled is tied to SelectedSegment.IsTextEnabled - the same flag that
                 already drives the Value textbox above (false exactly when a Reference
                 is active - see SegmentSelectorViewModel.ApplyEnableState/
                 UpdateRefControlsFromReference). Hierarchies/Search/the dual grids below
                 are all meaningless once a cell Reference is driving the segment's
                 value, so they're disabled together with the Value box instead of only
                 the Value box (WPF's IsEnabled naturally cascades to every descendant
                 control in the Border, greying out the combo/textbox/grids/buttons in
                 one binding). -->
            <Border Grid.Column="1" Grid.Row="1" IsEnabled="{Binding SelectedSegment.IsTextEnabled, FallbackValue=True}" Background="{StaticResource WhiteBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SegLabelCol"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Hierarchies:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ctrls:SuggestAppendComboBox x:Name="cmbHierarchy" Grid.Column="1" Height="30" HorizontalAlignment="Stretch" ItemsSource="{Binding HierarchyItems}" DisplayMemberPath="DisplayDescription" SelectedItem="{Binding SelectedHierarchy, Mode=TwoWay}" VerticalAlignment="Center" Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" LostFocus="CmbHierarchy_LostFocus"/>
                </Grid>
            </Border>

            <!-- Search -->
            <Border Grid.Column="1" Grid.Row="2" IsEnabled="{Binding SelectedSegment.IsTextEnabled, FallbackValue=True}" Background="{StaticResource WhiteBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SegLabelCol"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ctrls:SuggestAppendComboBox x:Name="cmbSearchType" Grid.Column="1" MinWidth="170" Height="30" Margin="0,0,8,0" ItemsSource="{Binding SearchTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSearchType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}"/>
                    <TextBox x:Name="txtSearch" Grid.Column="2" Height="30" Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Filters the data by given value" TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Dual DataGrids -->
            <!-- Regression fix (kept from an earlier session): this Border is capped at
                 MaxHeight="450" so a large dataset scrolls internally (dgLeft/dgRight both
                 have their own VerticalScrollBarVisibility="Auto") instead of growing this
                 Auto row - and therefore the whole window - without bound. -->
            <Border Grid.Column="1" Grid.Row="3" MaxHeight="450" IsEnabled="{Binding SelectedSegment.IsTextEnabled, FallbackValue=True}" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8">
                <Grid>
                    <!-- Right grid no longer shows a "Segment" column (it's always the
                         currently-selected segment - redundant to repeat on every row), so
                         it only needs to fit Value1/Value2; the freed-up width goes to the
                         left grid instead (was 1.2*/1.0*). Rebalanced 1.8*/0.6* -> 1.71*/0.69*
                         (MinWidth 260/160 -> 235/185) to shift ~25px from the left grid to
                         the right grid, on top of the window's own Width="1040"->"990"
                         (-50px) reduction above - then a further 1.71*/0.69* -> 1.68*/0.72*
                         (MinWidth 235/185 -> 225/195) to shift another ~10px left-to-right,
                         per follow-up feedback. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*" MinWidth="215"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="0.75*" MinWidth="205"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left DataGrid -->
                    <Border Grid.Column="0" Background="{StaticResource WhiteBrush}" CornerRadius="4" Margin="4">
                        <DataGrid x:Name="dgLeft" ItemsSource="{Binding PagedSegmentValues}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" Background="{StaticResource WhiteBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="DgLeft_MouseDoubleClick">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                    <Setter Property="Background" Value="#6C757D"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#1B6B93"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSummaryAccount}" Value="True">
                                            <Setter Property="Background" Value="#FFFFF0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                                            <Setter Property="Background" Value="#FFE4B5"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F8FF"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#9bcee4"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <!-- Width="*" (not Auto/DataGridColumnFillHelper - see this
                                     file's Window.SizeToContent="Manual" comment above and
                                     GLSegmentValues.xaml's identical column setup): this window
                                     now has a fixed Width, so native star-width columns size
                                     correctly without the infinite-measure risk that motivated
                                     DataGridColumnFillHelper elsewhere. Per-cell ToolTip added
                                     (matching GLSegmentValues exactly) so a truncated Value/
                                     Description still shows its full text on hover. -->
                                <DataGridTextColumn Header="Value" Binding="{Binding DisplaySegmentValue}" Width="100" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding DisplaySegmentValue}"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Description" IsReadOnly="True" Binding="{Binding Description}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="300"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Is-Summary" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSummaryChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSummaryAccount}">
                                                <CheckBox.ToolTip>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="This is a summary account" TextWrapping="Wrap" MaxWidth="300"/>
                                                    </ToolTip>
                                                </CheckBox.ToolTip>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Action Buttons Column -->
                    <Grid Grid.Column="1">
                        <GridSplitter Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button x:Name="btnAdd" Style="{StaticResource AddToRightButtonStyle}" Click="BtnAdd_Click"/>
                            <Button x:Name="btnBetween" Style="{StaticResource BetweenGridButtonStyle}" Click="BtnBetween_Click"/>
                            <Button x:Name="btnNotBetween" Style="{StaticResource NotBetweenGridButtonStyle}" Click="BtnNotBetween_Click"/>
                            <Button x:Name="btnExclude" Style="{StaticResource ExcludeButtonStyle}" Click="BtnExclude_Click"/>
                            <Button x:Name="btnRemove" Style="{StaticResource RemoveFromRightGridButtonStyle}" Click="BtnRemove_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Right DataGrid -->
                    <Border Grid.Column="2" Background="{StaticResource WhiteBrush}" CornerRadius="4" Margin="4">
                        <DataGrid x:Name="dgRight" ItemsSource="{Binding SelectedItemsRight}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True" Background="{StaticResource WhiteBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="DgRight_MouseDoubleClick">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                    <Setter Property="Background" Value="#6C757D"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#1B6B93"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F8FF"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="#212529"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value1" Binding="{Binding Value1}" Width="90" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding Value1}"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Width="*" (was a fixed 90, with a "Segment" column after
                                     it) - now that "Segment" is removed (testing feedback:
                                     redundant, since the right grid only ever shows the
                                     currently-selected segment's values), Value2 absorbs the
                                     freed-up width instead of leaving it blank. -->
                                <DataGridTextColumn Header="Value2" Binding="{Binding Value2}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding Value2}"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- Pagination - sits under the DataGrids' width (Column 1 only), matching
                 the user's wireframe, not the full window width. Labels/icons/pill/
                 tooltip match GLSegmentValues.xaml's own Paging Footer verbatim, per the
                 user's request to keep pagination wording consistent across both
                 segment-picker windows. -->
            <Border Grid.Column="1" Grid.Row="4" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome Kind="FileLinesSolid" Width="14" Height="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Per Page:" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtRecordsPerPage" Width="75" Height="26" Style="{StaticResource CompactTextBox}" Text="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="6,0,24,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnFirst" Style="{StaticResource FirstPageButtonStyle}" Click="BtnFirst_Click"/>
                        <Button x:Name="btnPrev" Style="{StaticResource PreviousPageButtonStyle}" Click="BtnPrev_Click"/>
                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Page" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding CurrentPage}" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="of" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock Text="{Binding TotalPages}" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="btnNext" Style="{StaticResource NextPageButtonStyle}" Click="BtnNext_Click"/>
                        <Button x:Name="btnLast" Style="{StaticResource LastPageButtonStyle}" Click="BtnLast_Click"/>
                        <TextBlock Text="Showing:" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center" Margin="16,0,4,0"/>
                        <TextBlock Text="{Binding PageRangeText}" Style="{StaticResource HeaderTextBlock}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Record range currently displayed in the left grid" TextWrapping="Wrap"/>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome Kind="DatabaseSolid" Width="14" Height="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="32,0,6,0"/>
                        <TextBlock Text="Total:" Style="{StaticResource HeaderTextBlock}" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TotalRecords}" Style="{StaticResource HeaderTextBlock}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Buttons Section - spans the FULL window width below both Segments and the
             detail/pagination stack (matches the user's wireframe). -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,8" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnClearDefaults" Content="Clear Defaults" Style="{StaticResource DynamicContentButton}" Click="BtnClearDefaults_Click" Margin="0,0,6,0">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Clear default values" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnOK" Content="Ok" Style="{StaticResource DynamicContentButton}" Click="BtnOK_Click" Margin="0,0,6,0">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Save and apply changes" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="CmdClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
