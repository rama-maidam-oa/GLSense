<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLLoginDetails"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:core="clr-namespace:GLSense.Addin.Core"
                  mc:Ignorable="d"
                  WindowCaption="GLSense Login Details"
                  IconSymbol="CircleInfoSolid"
                  SizeToContent="Manual"
                  MinHeight="260" MaxHeight="400"
                  MinWidth="460" MaxWidth="580"
                  ResizeMode="CanResize"
                  WindowStyle="None"
                  Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="CircleInfoSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="GLSense Login Details" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= Content Section ================= -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="20" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- User Row -->
                <Border Grid.Row="0" Grid.Column="0" Background="#F8F9FA" CornerRadius="4" Padding="8,6" Margin="0,0,12,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome
                            Kind="UserRegular"
                            Margin="0,4,0,0"
                            Style="{StaticResource SmallIcon}"
                            Foreground="#2E86AB"
                            VerticalAlignment="Center"/>
                        <TextBlock Text="User:"
                                   Style="{StaticResource HeaderTextBlock}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <TextBox x:Name="TxtUser"
                         Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding LoginUserName, Source={x:Static core:AppState.Instance}}"
                         IsReadOnly="True"
                         d:Text=" "
                         Margin="0,0,0,12">
                    <TextBox.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <StackPanel>
                                <TextBlock Text="User logged in:" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LoginUserName, Source={x:Static core:AppState.Instance}}"
                                           FontFamily="Segoe UI"
                                           Background="#F5F5F5"
                                           Padding="4"
                                           Margin="0,6,0,0"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MaxWidth="300"
                                           d:Text=" "/>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- URL Row -->
                <Border Grid.Row="1" Grid.Column="0" Background="#F8F9FA" CornerRadius="4" Padding="8,6" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconFontAwesome
                            Kind="LinkSolid"
                            Style="{StaticResource SmallIcon}"
                            Foreground="#2E86AB"
                            Margin="0,4,0,0"
                            VerticalAlignment="Center"/>
                        <TextBlock Text="URL:"
                                   Style="{StaticResource HeaderTextBlock}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <TextBox x:Name="TxtURL"
                         Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding LoginUrl, Source={x:Static core:AppState.Instance}}"
                         d:Text=" "
                         IsReadOnly="True">
                    <TextBox.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <StackPanel>
                                <TextBlock Text="Instance logged in:" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LoginUrl, Source={x:Static core:AppState.Instance}}"
                                           FontFamily="Segoe UI"
                                           Background="#F5F5F5"
                                           Padding="4"
                                           Margin="0,6,0,0"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MaxWidth="300"
                                           d:Text=" "/>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </Grid>
        </Border>

        <!-- ================= Buttons Section ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="10,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CmdClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</views:BaseWindow>
