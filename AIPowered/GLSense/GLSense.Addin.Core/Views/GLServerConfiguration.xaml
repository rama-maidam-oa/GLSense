<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLServerConfiguration"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  mc:Ignorable="d"
                  WindowCaption="Instance Configuration"
                  IconSymbol="DatabaseSolid"
                  SizeToContent="WidthAndHeight"
                  MinWidth="640" MaxWidth="720"
                  MinHeight="410" MaxHeight="650"
                  ResizeMode="CanResize"
                  WindowStyle="None">    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- DataGrid Selection Highlight Colors (window-specific) -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E6F3FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F0F8FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="{Binding WindowCaption, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="BtnClose_Click"/>
        </Grid>

        <!-- ================= Data Grid Section ================= -->
        <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,10,10,8">
            <DataGrid x:Name="dgInstances" FontFamily="Segoe UI" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" Background="{StaticResource WhiteBrush}" BorderThickness="0" GridLinesVisibility="None" CellEditEnding="DgInstances_CellEditEnding" SelectionChanged="DgInstances_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                        <Setter Property="Background" Value="#E0E0E0"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                    <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                        <Setter Property="Background" Value="#6C757D"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2E86AB"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#1B6B93"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#F8F9FA"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#212529"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Height" Value="36"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F8FF"/>
                                <Setter Property="BorderBrush" Value="#2E86AB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E6F3FF"/>
                                <Setter Property="BorderBrush" Value="#2E86AB"/>
                                <Setter Property="Foreground" Value="#212529"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="URL Name" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <StackPanel>
                                                <TextBlock Text="Friendly name for the server instance" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="URL Address" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <StackPanel>
                                                <TextBlock Text="Server connection URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Address}" TextWrapping="Wrap"/>
                                                <TextBlock Text="Example: http://server.domain.com:port/reporting" FontSize="11" FontStyle="Italic" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= Action Buttons Section ================= -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,10" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Status Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnUpdate" Content="Add" Style="{StaticResource DynamicContentButton}" Click="BtnUpdate_Click" Margin="0,0,8,0">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Add / save server configuration" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnDelete" Content="Delete" Style="{StaticResource DynamicContentButton}" Click="BtnDelete_Click" Margin="0,0,8,0">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Delete selected server configuration" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Toast/Busy Overlay ================= -->
        <local:AppOverlay x:Name="AppOverlayControl" Margin="0" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
