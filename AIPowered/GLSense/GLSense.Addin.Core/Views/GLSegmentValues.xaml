<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLSegmentValues"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:conv="clr-namespace:GLSense.Addin.Core.Converters"
                  mc:Ignorable="d"
                  Background="#F8F9FA"
                  SizeToContent="Manual"
                  Width="840" Height="740"
                  MinWidth="800" MaxWidth="880"
                  MinHeight="700" MaxHeight="760"
                  ResizeMode="CanResize"
                  WindowStyle="None"
                  WindowStartupLocation="CenterOwner"
                  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:WidthPercentageConverter x:Key="WidthPercentageConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header =================
             Ported from FinalWorkingCode's own bespoke HeaderBar-styled Border (replacing
             AIPowered's earlier TitleBarGridStyle/TitleBarIconStyle/TitleBarTextStyle/
             TitleBarCloseButtonStyle idiom, same convention already established by pilot
             windows 1/2 - GLWaitWindow/GLMessageWindow - in this same porting pass). Drag
             wiring kept as this project's own pre-existing TitleBar_MouseLeftButtonDown
             handler (see .xaml.cs) rather than FinalWorkingCode's
             EnhancedDragDropHelper.EnableWindowDrag(this), which doesn't exist in this
             project (same reasoning as GLWaitWindow/GLMessageWindow's ports). -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="LayerGroupSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="Segment Values Configurator" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= Middle Content ================= -->
        <!-- Previously the whole section (Segment&Hierarchy row + Search row + Dual DataGrids)
             was wrapped in one outer ScrollViewer. That made the top two rows scroll away
             together with the grid content, so scrolling the data also hid the Segment/
             Hierarchy pickers and Search box. Those two rows are fixed-height (Auto) and never
             need to scroll; only the Dual DataGrids row should scroll, and it already has its
             own internal per-DataGrid ScrollViewer (ScrollViewer.VerticalScrollBarVisibility on
             dgLeft/dgRight) plus a MaxHeight="450" cap on its Border, so no outer ScrollViewer
             is needed there either. Removed the outer ScrollViewer entirely and made this a
             plain Grid with Segment&Hierarchy/Search as fixed siblings above the DataGrids row. -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Segment & Hierarchy -->
            <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Segment:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ctrls:SuggestAppendComboBox x:Name="cmbSegments" Grid.Column="1" Height="30" HorizontalAlignment="Stretch" ItemsSource="{Binding Segments}" DisplayMemberPath="SegmentName" SelectedItem="{Binding SelectedSegment, Mode=TwoWay}" VerticalAlignment="Center" Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}"/>
                    <TextBlock Grid.Column="2" Text="Hierarchy:" Style="{StaticResource HeaderTextBlock}" Margin="12,0,8,0" VerticalAlignment="Center"/>
                    <ctrls:SuggestAppendComboBox x:Name="cmbHierarchy" Grid.Column="3" Height="30" HorizontalAlignment="Stretch" ItemsSource="{Binding HierarchyItems}" DisplayMemberPath="DisplayDescription" SelectedItem="{Binding SelectedHierarchy, Mode=TwoWay}" VerticalAlignment="Center" Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" LostFocus="CmbHierarchy_LostFocus"/>
                </Grid>
            </Border>

            <!-- Search -->
            <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ctrls:SuggestAppendComboBox x:Name="cmbSearchType" Grid.Column="1" MinWidth="170" Height="30" Margin="0,0,8,0" ItemsSource="{Binding SearchTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSearchType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}"/>
                    <TextBox x:Name="txtSearch" Grid.Column="2" Height="30" Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Filters the data by given value" TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Dual DataGrids -->
            <Border Grid.Row="2" MaxHeight="450" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="220"/>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="1.0*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left DataGrid -->
                    <Border Grid.Column="0" Background="{StaticResource WhiteBrush}" CornerRadius="4" Margin="4">
                        <DataGrid x:Name="dgLeft" ItemsSource="{Binding PagedSegmentValues}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" Background="{StaticResource WhiteBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="DgLeft_MouseDoubleClick">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                    <Setter Property="Background" Value="#6C757D"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#1B6B93"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <!-- Custom template (matches FinalWorkingCode): the default WPF header
                                         template reserves extra space for the sort-arrow glyph even when
                                         not sorted, which was clipping "Is-Summary". This template gives
                                         the sort arrow its own Auto column so the header text gets the
                                         full remaining width. -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,6,0" Width="10" Height="6" Stretch="Fill" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" Data="M 0 4 L 5 0 L 10 4 Z"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSummaryAccount}" Value="True">
                                            <Setter Property="Background" Value="#FFFFF0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                                            <Setter Property="Background" Value="#FFE4B5"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F8FF"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#9bcee4"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <!-- Width was "Auto" on Description, which sizes to its longest
                                     content instead of filling the grid - that's what forced the
                                     horizontal scrollbar to appear even when the grid had plenty of
                                     unused width. Fixed to "*" (matches FinalWorkingCode) so
                                     Description absorbs all remaining space instead of pushing the
                                     grid wider than it needs to be; Is-Summary widened 90->100 to
                                     show its full header text without truncation. Also added a
                                     ToolTip bound to each column's own value on Value/Description,
                                     matching FinalWorkingCode, so hovering a truncated cell shows
                                     its full text. -->
                                <DataGridTextColumn Header="Value" Binding="{Binding DisplaySegmentValue}" Width="90" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding DisplaySegmentValue}"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Description" IsReadOnly="True" Binding="{Binding Description}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="300"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Is-Summary" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource SingleClickCheckBoxStyle}" IsChecked="{Binding IsSummaryChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSummaryAccount}">
                                                <CheckBox.ToolTip>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="This is a summary account" TextWrapping="Wrap" MaxWidth="300"/>
                                                    </ToolTip>
                                                </CheckBox.ToolTip>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Action Buttons Column -->
                    <Grid Grid.Column="1">
                        <GridSplitter Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button x:Name="btnAdd" Style="{StaticResource AddToRightButtonStyle}" Click="BtnAdd_Click"/>
                            <Button x:Name="btnBetween" Style="{StaticResource BetweenGridButtonStyle}" Click="BtnBetween_Click"/>
                            <Button x:Name="btnNotBetween" Style="{StaticResource NotBetweenGridButtonStyle}" Click="BtnNotBetween_Click"/>
                            <Button x:Name="btnExclude" Style="{StaticResource ExcludeButtonStyle}" Click="BtnExclude_Click"/>
                            <Button x:Name="btnRemove" Style="{StaticResource RemoveFromRightGridButtonStyle}" Click="BtnRemove_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Right DataGrid -->
                    <Border Grid.Column="2" Background="{StaticResource WhiteBrush}" CornerRadius="4" Margin="4">
                        <DataGrid x:Name="dgRight" ItemsSource="{Binding SelectedItemsRight}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True" Background="{StaticResource WhiteBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="DgRight_MouseDoubleClick">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                    <Setter Property="Background" Value="#6C757D"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#1B6B93"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <!-- Custom template (matches FinalWorkingCode): the default WPF header
                                         template reserves extra space for the sort-arrow glyph even when
                                         not sorted, which was clipping "Is-Summary". This template gives
                                         the sort arrow its own Auto column so the header text gets the
                                         full remaining width. -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,6,0" Width="10" Height="6" Stretch="Fill" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" Data="M 0 4 L 5 0 L 10 4 Z"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F8FF"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="#212529"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value1" Binding="{Binding Value1}" Width="90" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Value2" Binding="{Binding Value2}" Width="90" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Width="*" (not Auto/FillHelper - see GLSegmentValues.xaml.cs
                                     constructor comment): this window is SizeToContent="Manual"
                                     with a fixed Width, so native star-width columns size
                                     correctly here without the infinite-measure risk that
                                     motivates DataGridColumnFillHelper elsewhere. -->
                                <DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Paging Footer -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Padding="14,8" Margin="10,0,10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="FileLinesSolid" Width="14" Height="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Per Page:" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtRecordsPerPage" Width="75" Height="26" Style="{StaticResource CompactTextBox}" Text="{Binding PageSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="6,0,24,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnFirst" Style="{StaticResource FirstPageButtonStyle}" Click="BtnFirst_Click"/>
                    <Button x:Name="btnPrev" Style="{StaticResource PreviousPageButtonStyle}" Click="BtnPrev_Click"/>
                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="8,4" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Page" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CurrentPage}" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="of" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Text="{Binding TotalPages}" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="btnNext" Style="{StaticResource NextPageButtonStyle}" Click="BtnNext_Click"/>
                    <Button x:Name="btnLast" Style="{StaticResource LastPageButtonStyle}" Click="BtnLast_Click"/>
                    <TextBlock Text="Showing:" Style="{StaticResource HeaderTextBlock}" FontSize="11" VerticalAlignment="Center" Margin="16,0,4,0"/>
                    <TextBlock Text="{Binding PageRangeText}" Style="{StaticResource HeaderTextBlock}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Record range currently displayed in the left grid" TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="DatabaseSolid" Width="14" Height="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="32,0,6,0"/>
                    <TextBlock Text="Total:" Style="{StaticResource HeaderTextBlock}" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TotalRecords}" Style="{StaticResource HeaderTextBlock}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Options and Actions Footer -->
        <Border Grid.Row="3" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,10" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Write to Multiple Rows/Columns Checkbox + Overwrite/Insert + By Rows/By Columns, one line -->
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkMultipleRows" Content="Write to Multiple Rows/Columns" Style="{StaticResource ModernCheckBox}" IsEnabled="{Binding IsMultipleRowsEnabled}" IsChecked="{Binding IsMultipleRowsChecked, Mode=TwoWay}" VerticalAlignment="Center">
                        <CheckBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Write to Multiple Rows/Columns" FontWeight="Bold" Foreground="Black"/>
                                    <Separator Margin="0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="✓ Checked: Each item in its own cell (By Rows/By Columns below)" FontSize="11" FontStyle="Italic" Foreground="Black" TextWrapping="Wrap" MaxWidth="220"/>
                                            <TextBlock Text="✗ Unchecked: All items in single cell" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>

                    <!-- Overwrite / Insert - disabled together with the Multiple Rows checkbox
                         above (bound to the same IsMultipleRowsEnabled), forced back to Overwrite
                         whenever that happens (see Vm_PropertyChanged in code-behind). Overwrite
                         (default) matches this window's original behavior: write directly into
                         the existing cells. Insert opens space for the incoming values first by
                         shifting existing content down. Ported from FinalWorkingCode's identical
                         GLSegmentValues.xaml. -->
                    <RadioButton x:Name="rbOverwrite" Content="Overwrite" Style="{StaticResource ModernRadioButton}" GroupName="SegmentValuesWriteModeGroup" IsEnabled="{Binding IsMultipleRowsEnabled}" IsChecked="True" VerticalAlignment="Center" Margin="28,0,0,0"/>
                    <RadioButton x:Name="rbInsert" Content="Insert" Style="{StaticResource ModernRadioButton}" GroupName="SegmentValuesWriteModeGroup" IsEnabled="{Binding IsMultipleRowsEnabled}" Margin="16,0,0,0" VerticalAlignment="Center">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Inserts new row(s) at the cell reference, shifting existing content down, instead of overwriting it." TextWrapping="Wrap" MaxWidth="260"/>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <!-- By Rows / By Columns - orientation for the multi-cell write path only.
                         Ported from FinalWorkingCode's identical GLSegmentValues.xaml. -->
                    <RadioButton x:Name="rbByRows" Content="By Rows" Style="{StaticResource ModernRadioButton}" GroupName="SegmentValuesOrientationGroup" IsEnabled="{Binding IsMultipleRowsEnabled}" IsChecked="True" VerticalAlignment="Center" Margin="28,0,0,0"/>
                    <RadioButton x:Name="rbByColumns" Content="By Columns" Style="{StaticResource ModernRadioButton}" GroupName="SegmentValuesOrientationGroup" IsEnabled="{Binding IsMultipleRowsEnabled}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Row 1, left corner: Cell Reference -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="Cell Reference:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                    <local:ExcelRefEditControl x:Name="excelRefEdit" TagName="Segment Values Cell Reference" Height="30" Width="180" Margin="2,0,0,0" VerticalAlignment="Center" Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Row 1, right corner: Action Buttons -->
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,15,0,0">
                    <Button x:Name="btnOK" Style="{StaticResource InsertButtonStyle}" Click="BtnOK_Click" Margin="0,0,8,0"/>
                    <Button x:Name="CmdClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
