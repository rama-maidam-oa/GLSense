<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLLOVs"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:conv="clr-namespace:GLSense.Addin.Core.Converters"
                  mc:Ignorable="d"
                  WindowCaption="GLSense LOVs"
                  IconSymbol="ListCheckSolid"
                  SizeToContent="Manual"
                  MinWidth="550" MaxWidth="750"
                  MinHeight="750"
                  ResizeMode="CanResize"
                  WindowStyle="None"
                  Background="#F8F9FA"
                  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Generic.xaml (not GlobalStyles.xaml alone) - merges GlobalStyles.xaml
                     internally, and also carries SuggestAppendComboBox's own Style/Template.
                     WPF's automatic "fall back to the defining assembly's Themes/Generic.xaml"
                     mechanism for that control proved unreliable in this Excel-hosted
                     environment (see GLLogin.xaml's comment for the full investigation) -
                     merging it explicitly here puts the style in this window's own page
                     resources instead of depending on that fallback. -->
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

            <!-- Watermark TextBox Style (window-specific, ported from FinalWorkingCode's
                 GLLOVs.xaml) - AIPowered's Comments TextBox had no hint text at all when
                 empty; FinalWorkingCode shows an italic placeholder explaining what
                 happens if the field is left blank. Overlays a TextBlock via
                 PART_ContentHost's template and toggles its visibility based on
                 Text/IsFocused, since plain TextBox has no built-in placeholder support. -->
            <Style x:Key="WatermarkTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Top" Padding="{TemplateBinding Padding}"/>
                                <!-- MaxWidth is required here even though this window is now
                                     SizeToContent="Manual": kept as cheap, harmless insurance
                                     against the infinite-width remeasure bug this guarded
                                     against under the previous SizeToContent="WidthAndHeight"
                                     mode (CLAUDE.md section 10.1) - a hard MaxWidth forces wrapping/a
                                     stable desired size regardless of available measure space. -->
                                <TextBlock x:Name="WatermarkText" Text="Add your comments here. The entered text will be added as an Excel cell comment. If left blank, the selected ledger name is used instead." Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="8,4" MaxWidth="480" VerticalAlignment="Top" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="WatermarkText" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <!-- FinalWorkingCode's Ledger combo lives inside the header itself (unlike every
             other window in this plan, where it's a body row) - ported that structure
             here: Auto/*/Auto columns so the title sits left, the Ledger combo is
             right-aligned in the middle column, and the close button stays rightmost. -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="ListCheckSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="GLSense LOVs" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <!-- Ledger Selection in the middle/right area -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                    <Label Content="Ledger:" Foreground="White" FontFamily="Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ctrls:SuggestAppendComboBox x:Name="cmbLedgers" Width="400" Height="28" ItemsSource="{Binding Ledgers}" DisplayMemberPath="LedgerName" SelectedItem="{Binding LOV_SelectedLedger, Mode=TwoWay}" VerticalAlignment="Center" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529"/>
                </StackPanel>
                <!-- Close Button -->
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= Main Content: LOVs DataGrid + Comments ================= -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LOVs DataGrid -->
            <!-- MinHeight/MaxHeight kept (CLAUDE.md sections 6.1/8.2) - FinalWorkingCode has no cap
                 here at all, but this codebase's DataGrid-in-a-"*"-row windows need this
                 floor/ceiling pair for reasons specific to this add-in's own layout history. -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Margin="0,0,0,8" MinHeight="250" MaxHeight="400">
                <DataGrid x:Name="dgLovs" FontFamily="Segoe UI" ItemsSource="{Binding LOVRows}" SelectedItem="{Binding SelectedLov, Mode=TwoWay}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Background="White" IsReadOnly="True" SelectionUnit="FullRow" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single">
                    <!-- Override system selection colors -->
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>
                        <!-- local scrollbar styles scoped to this DataGrid (ensure visible, consistent look) -->
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                        <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                            <Setter Property="Background" Value="#6C757D"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2E86AB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderBrush" Value="#1B6B93"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="FontSize" Value="12"/>
                            <!-- Sort-arrow ControlTemplate (ported from FinalWorkingCode): the
                                 default WPF DataGridColumnHeader template reserves extra
                                 internal space for the sort-arrow glyph even when the column
                                 isn't sorted, clipping header text at narrow widths. This
                                 template puts the sort arrow in its own Auto column so the
                                 ContentPresenter gets the full remaining width. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,6,0" Width="10" Height="6" Stretch="Fill" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" Data="M 0 4 L 5 0 L 10 4 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="border" Value="#389BC7"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" TargetName="border" Value="#277596"/>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Ascending">
                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 5 0 L 10 4 Z"/>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Descending">
                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 5 4 L 10 0 Z"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F8F9FA"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#212529"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="36"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Segment">
                                    <Setter Property="Background" Value="#FFFFF0"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F8FF"/>
                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#9bcee4"/>
                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Available LOVs" Binding="{Binding Name}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Category}" FontStyle="Italic"/>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="Click to select this list of values" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                                                <TextBlock Text="Category: " FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding Category}" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Items Count" Binding="{Binding ItemsCount}" Width="1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <!-- Amber callout styling ported from FinalWorkingCode, but the
                                                 headline text KEEPS AIPowered's own live-count MultiBinding
                                                 ("{0} item(s) available for '{1}'", CLAUDE.md section 10.2) instead
                                                 of reverting to FinalWorkingCode's static
                                                 "Number of values in this list" text. -->
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} item(s) available for '{1}'">
                                                                <Binding Path="ItemsCount"/>
                                                                <Binding Path="Name"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Click to select this list of values" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1*" Visibility="Collapsed"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Comments Section -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Margin="0,0,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Comments" Style="{StaticResource HeaderLabel}" Grid.Row="0" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtComments" Grid.Row="1" Style="{StaticResource WatermarkTextBox}" Height="50" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top">
                        <TextBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Add comments that will be attached as an Excel cell comment. If left blank the selected ledger name is used." TextWrapping="Wrap"/>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="8,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Cell Reference -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Reference:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                    <local:ExcelRefEditControl x:Name="excelRefEdit" TagName="LOV's Cell Reference" Width="220" Height="30" VerticalAlignment="Center" Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CmdSubmit" Style="{StaticResource InsertButtonStyle}" Margin="0,0,8,0" Click="CmdSubmit_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Insert selected list of values into Excel at the specified cell reference" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="CmdClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
