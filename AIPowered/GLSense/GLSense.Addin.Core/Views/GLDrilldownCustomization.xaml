<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLDrilldownCustomization"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                  mc:Ignorable="d"
                  WindowStyle="None"
                  SizeToContent="Manual"
                  Width="1250" Height="850"
                  MinWidth="1250" MaxWidth="1500"
                  MinHeight="850"
                  ResizeMode="CanResize"
                  Background="#F8F9FA">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Info box style for the Save explanation label, matching the same
                 colored-pill status-message convention used elsewhere (e.g.
                 GLServerConfiguration's SuccessMessage/ErrorMessage styles), just with an
                 "info" blue instead of success green, since this is a standing explanation
                 rather than a transient result. -->
            <Style x:Key="SaveInfoMessage" TargetType="Border">
                <Setter Property="Background" Value="#D1ECF1"/>
                <Setter Property="BorderBrush" Value="#BEE5EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="GearsSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="GLSense Drilldown Customization" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= WebView2 Section ================= -->
        <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Margin="0,2,0,0">
            <wpf:WebView2 x:Name="webView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>

        <!-- ================= Close Button Section ================= -->
        <Border Grid.Row="2" Background="Transparent" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SaveInfoMessage}" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <TextBlock Text="By clicking Save, these customizations are stored in this workbook's memory - they travel with the workbook whenever it is shared or shipped to other users."
                               FontSize="12" FontWeight="SemiBold" Foreground="#0C5460" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnSaveLocally" Content="Save" Margin="0,0,8,0" Style="{StaticResource DynamicContentButton}" Click="BtnSaveLocally_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="By clicking Save, these customizations are stored in this workbook's memory. They stay with the workbook - including when it's shared or shipped to other users." FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Margin="0" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</views:BaseWindow>
