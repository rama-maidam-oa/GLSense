<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLAbout"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  mc:Ignorable="d"
                  WindowCaption="About Orbit GLSense"
                  IconSymbol="CircleInfoSolid"
                  SizeToContent="WidthAndHeight"
                  MinWidth="450" MaxWidth="650"
                  MinHeight="500" MaxHeight="620"
                  ResizeMode="CanResize"
                  WindowStyle="SingleBorderWindow"
                  ExtendsContentIntoTitleBar="True"
                  Loaded="AboutWindow_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- System Color Overrides for Selection (window-specific) -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E6F3FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F0F8FF"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>
            <!-- Simple indeterminate-only ProgressBar template (window-specific) -->
            <Style x:Key="IndeterminateOnlyProgressBar" TargetType="ProgressBar">
                <Setter Property="Background" Value="#E9ECEF"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                                <Grid ClipToBounds="True" Height="{TemplateBinding Height}">
                                    <!-- Moving stripe -->
                                    <Rectangle x:Name="IndeterminateStripe" Height="{TemplateBinding Height}" Width="160" RadiusX="4" RadiusY="4" HorizontalAlignment="Left" Opacity="1">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#2E86AB" Offset="0"/>
                                                <GradientStop Color="#1B6B93" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform x:Name="IndeterminateTransform" X="0"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="IndeterminateStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="IndeterminateTransform" Storyboard.TargetProperty="X" From="-200" To="600" Duration="0:0:1.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="IndeterminateStoryboard"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsIndeterminate" Value="False">
                                    <Setter TargetName="IndeterminateStripe" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="{Binding WindowCaption, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="BtnClose_Click"/>
        </Grid>

        <!-- ================= Combined Content Section ================= -->
        <Grid Grid.Row="1" Margin="10,10,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Company & Product Info -->
                <RowDefinition Height="*"/>
                <!-- Instance Compatibility (main content: absorbs extra space) -->
                <RowDefinition Height="Auto"/>
                <!-- Progress Bar (collapses to zero when hidden) -->
            </Grid.RowDefinitions>

            <!-- ================= Company & Product Info Section ================= -->
            <Border Grid.Row="0" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Company Logo (matches FinalWorkingCode: Images\orbit_logo.png, ported
                         into this project's own Images folder - see .csproj Resource item) -->
                    <Border Grid.Column="0" Width="200" Height="100" Background="White" CornerRadius="8" Margin="0,0,16,0">
                        <Image Source="/GLSense.Addin.Core;component/Images/orbit_logo.png" Stretch="Uniform"/>
                    </Border>
                    <!-- Product Details -->
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <TextBlock Text="Orbit GLSense" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <!-- Version -->
                        <TextBlock x:Name="txtVersion" FontSize="12" FontFamily="Segoe UI" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6">
                            <TextBlock.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Current GLSense version"/>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <!-- Description -->
                        <TextBlock Text="Financial Analytics and Reporting Tool" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <!-- Build Date -->
                        <TextBlock x:Name="txtBuildDate" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6">
                            <TextBlock.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Date when this version was released"/>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <!-- Support Link -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="For Support please contact : " FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="txtSupportLink" Text="https://www.orbitanalytics.com" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource PrimaryBrush}" TextDecorations="Underline" Cursor="Hand" MouseLeftButtonDown="SupportLink_MouseLeftButtonDown">
                                <TextBlock.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <TextBlock Text="Click to open support website"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Instance Compatibility Section ================= -->
            <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                        <TextBlock Text="Shows configured server instances and their compatibility status"/>
                    </ToolTip>
                </Border.ToolTip>
                <DataGrid x:Name="dgInstances" FontFamily="Segoe UI" MinHeight="200" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" Background="{StaticResource WhiteBrush}" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                        <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                            <Setter Property="Background" Value="#6C757D"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2E86AB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderBrush" Value="#1B6B93"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderBrush" Value="#F8F9FA"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#212529"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="36"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F8FF"/>
                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E6F3FF"/>
                                    <Setter Property="BorderBrush" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Instance" Binding="{Binding Instance}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <TextBlock Text="{Binding Instance}"/>
                                            </ToolTip>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Compatible Column - ICONS ONLY -->
                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Compatible" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="Compatibility status with current system"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Green Tick -->
                                        <iconPacks:PackIconFontAwesome Kind="CircleCheckSolid" Width="18" Height="18" Foreground="#10B981">
                                            <iconPacks:PackIconFontAwesome.Style>
                                                <Style TargetType="iconPacks:PackIconFontAwesome">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompatible}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconFontAwesome.Style>
                                        </iconPacks:PackIconFontAwesome>
                                        <!-- Red Cross -->
                                        <iconPacks:PackIconFontAwesome Kind="CircleXmarkSolid" Width="18" Height="18" Foreground="#EF4444">
                                            <iconPacks:PackIconFontAwesome.Style>
                                                <Style TargetType="iconPacks:PackIconFontAwesome">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompatible}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconFontAwesome.Style>
                                        </iconPacks:PackIconFontAwesome>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ================= Progress Bar Section ================= -->
            <Border Grid.Row="2" Background="Transparent" Margin="0">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" x:Name="progressPanel" Visibility="Visible">
                    <ProgressBar x:Name="progressBar" Style="{StaticResource IndeterminateOnlyProgressBar}" IsIndeterminate="True" Height="20" Foreground="#2E86AB" Background="#E9ECEF" BorderThickness="1" BorderBrush="#DEE2E6"/>
                    <TextBlock x:Name="txtProgress" FontFamily="Segoe UI" Text="Checking instance compatibility..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Footer with Copyright ================= -->
        <!-- Matches FinalWorkingCode: footer also carries its own Close button (in addition
             to the title bar's), not just the copyright text. -->
        <Border Grid.Row="2" Background="Transparent" Margin="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Copyright © 2015 Orbit Analytics. All Rights Reserved." FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= App Overlay ================= -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
