<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLSegmentDiscovery"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  mc:Ignorable="d"
                  WindowCaption="GLSense Segment Values Discover"
                  IconSymbol="FilterSolid"
                  SizeToContent="WidthAndHeight"
                  MinWidth="660" MaxWidth="700"
                  MinHeight="345" MaxHeight="520"
                  ResizeMode="CanResize"
                  WindowStyle="None"
                  >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- SizeToContent="WidthAndHeight" (see GLGetPeriod.xaml for the full
             reasoning): the earlier "Width"-only + fixed Min/MaxHeight + dead "*"
             spacer row workaround traded the collapse-until-resize bug for a visible
             dead gap between content and buttons. BaseWindow's Window.ContentRendered
             resettle (CLAUDE.md 1.4e) now fixes the collapse symptom generically, so
             this window can shrink-to-fit its content like FinalWorkingCode's does. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="GLSense Segment Values Discover" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="BtnClose_Click"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,10,10,4">
            <StackPanel>
                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Segment Value :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="120" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSegmentValue" Grid.Column="1" Style="{StaticResource ReadOnlyTextBox}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <StackPanel>
                                        <TextBlock Text="Displays the selected segment value to be written to Excel" TextWrapping="Wrap"/>
                                        <TextBlock Text="This value will be populated based on:" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                        <TextBlock Text="• Number of selected Excel rows/cells" FontSize="11" FontStyle="Italic" Margin="0,2,0,0"/>
                                        <TextBlock Text="• Selected direction (Up/Down/Left/Right)" FontSize="11" FontStyle="Italic" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </Grid>
                </Border>

                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Direction Options :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="120" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <RadioButton x:Name="rbUp" Content="Up" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" IsChecked="True" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbDown" Content="Down" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbRight" Content="Right" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbLeft" Content="Left" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbDownAll" Content="Down All" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                            <RadioButton x:Name="rbRightAll" Content="Right All" Style="{StaticResource ModernRadioButton}" GroupName="DirectionGroup" Margin="20,0,0,0" Checked="DirectionRadio_Checked"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Include Options :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="120" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <CheckBox x:Name="chkParent" Content="Parent" Style="{StaticResource ModernCheckBox}" IsChecked="True"/>
                            <CheckBox x:Name="chkChild" Content="Child" Style="{StaticResource ModernCheckBox}" IsChecked="True" Margin="30,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Output Options :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="120" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <RadioButton x:Name="rbOverwrite" Content="Overwrite" Style="{StaticResource ModernRadioButton}" GroupName="OutputGroup" IsChecked="True"/>
                            <RadioButton x:Name="rbInsert" Content="Insert" Style="{StaticResource ModernRadioButton}" GroupName="OutputGroup" Margin="30,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Range Selected :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="120" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtRangeSelected" Grid.Column="1" Style="{StaticResource ReadOnlyTextBox}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,10" Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSubmit" Style="{StaticResource InsertButtonStyle}" Click="BtnSubmit_Click" Margin="0,0,8,0"/>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Toast/Busy Overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
