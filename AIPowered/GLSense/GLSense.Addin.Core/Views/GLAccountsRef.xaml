<UserControl x:Class="GLSense.Addin.Core.Views.GLAccountsRef" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Center"
             x:Name="glAccountsControl" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Grid disabled style (control-specific) -->
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0" SnapsToDevicePixels="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Main container with unified border -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Background="White" CornerRadius="4" BorderThickness="1" BorderBrush="#E9ECEF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- TextBox WITH TOOLTIP -->
                <TextBox x:Name="txtBox" Grid.Column="0" FontFamily="Segoe UI" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,6" Foreground="#212529" FontSize="13" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}" x:Name="accountsToolTip">
                            <StackPanel x:Name="toolTipPanel">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="FileInvoiceDollarSolid" Width="12" Height="12" Foreground="#2E86AB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Selected GL Accounts" FontWeight="SemiBold"/>
                                </StackPanel>
                                <!-- Tooltip text updated in code-behind -->
                                <TextBlock x:Name="toolTipTextBlock" FontFamily="Segoe UI" Background="#F5F5F5" Padding="4" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300" Text="No accounts selected"/>
                                <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Click the hand pointer icon to select accounts" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
                <!-- Edit Button WITH ENHANCED TOOLTIP -->
                <Button x:Name="btnEdit" Grid.Column="1" Margin="0" Padding="4" BorderThickness="0" Background="Transparent" Cursor="Hand" Click="BtnEdit_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{x:Null}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#2E86AB"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#808080"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="HandPointerSolid" Width="12" Height="12" Foreground="#2E86AB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Select GL Accounts" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Click to open accounts selection window" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <iconPacks:PackIconFontAwesome Kind="HandPointerSolid" Width="16" Height="16"/>
                </Button>
                <!-- Clear Button WITH ENHANCED TOOLTIP -->
                <Button x:Name="btnClear" Grid.Column="2" Margin="0" Padding="4" BorderThickness="0" Background="Transparent" Cursor="Hand" Click="BtnClear_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{x:Null}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#6C757D"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#808080"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="EraserSolid" Width="12" Height="12" Foreground="#6C757D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear Accounts" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Click to clear the selected accounts" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <iconPacks:PackIconFontAwesome Kind="EraserSolid" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
