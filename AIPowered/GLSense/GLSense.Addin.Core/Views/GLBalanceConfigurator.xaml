<UserControl x:Class="GLSense.Addin.Core.Views.GLBalanceConfigurator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
             xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
             xmlns:conv="clr-namespace:GLSense.Addin.Core.Converters"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
             Background="#F8F9FA"
             MinWidth="600"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Generic.xaml (not GlobalStyles.xaml alone) - merges GlobalStyles.xaml
                     internally, and also carries SuggestAppendComboBox's own Style/Template.
                     WPF's automatic "fall back to the defining assembly's Themes/Generic.xaml"
                     mechanism for that control proved unreliable in this Excel-hosted
                     environment (see GLLogin.xaml's comment for the full investigation) -
                     merging it explicitly here puts the style in this UserControl's own
                     resources instead of depending on that fallback. -->
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:WidthPercentageConverter x:Key="WidthPercentageConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:FieldDependencyEnableConverter x:Key="FieldDependencyEnableConverter"/>
            <conv:MultiBooleanAndConverter x:Key="MultiBooleanAndConverter"/>
            <conv:BalanceTypeDatePeriodConverter x:Key="BalanceTypeDatePeriodConverter"/>
            <conv:JournalValidationConverter x:Key="JournalValidationConverter"/>
            <conv:NullableDateConverter x:Key="NullableDateConverter"/>

            <!-- Compact button variants for the Saved Configurations row (Save New/Update/
                 Delete/Confirm/Cancel) and the bottom Insert/Cancel row - based on the shared
                 DynamicContentButton/InsertButtonStyle/CloseButtonStyle (Themes/GlobalStyles.xaml)
                 but shorter, matching this dialog's compact field rows. Ported from
                 FinalWorkingCode's identical local styles. -->
            <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource DynamicContentButton}">
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Padding" Value="12,4"/>
            </Style>
            <Style x:Key="CompactInsertButtonStyle" TargetType="Button" BasedOn="{StaticResource InsertButtonStyle}">
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Padding" Value="12,4"/>
            </Style>
            <Style x:Key="CompactCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CloseButtonStyle}">
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Padding" Value="12,4"/>
            </Style>

            <!-- Balance-Configurator-local styles. These are not shared/registered in the
                 project's Themes\GlobalStyles.xaml because this migration's already-ported
                 windows use a different visual convention for headers/labels/combos (WPF-UI
                 SymbolIcon-based BaseWindow title bars, inline-styled rows - see e.g.
                 Views\GLGetPeriod.xaml) than this UserControl, which draws its own
                 self-contained header/close button (it has no BaseWindow title bar - it is
                 hosted as plain Window.Content by Views\ConfiguratorPaneHost.cs, itself
                 reparented into the host's task pane). Scoping these locally mirrors exactly
                 what the old monolith's GLBalanceConfigurator.xaml already did (it also
                 defined ConfigLabelStyle/ConfigRowStyle/BlueCircleExpanderStyle locally on
                 top of its merged dictionary) rather than inventing a new shared-theme
                 pattern. Brushes referenced below (PrimaryBrush/TextPrimaryBrush/etc.) all
                 come from the merged GlobalStyles.xaml dictionary. -->
            <Style x:Key="ConfigLabelStyle" TargetType="Label">
                <!-- Width intentionally NOT set here anymore: the label column is now
                     Auto + SharedSizeGroup (see each row's Grid.ColumnDefinitions), so
                     it shrink-wraps to the widest label text across all rows instead of
                     a fixed 190 that left a big dead gap after short labels. A 1px right
                     margin keeps a hairline gap before the combo even for the longest
                     label ("Account Assignment(s):"). -->
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,1,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <!-- Blue (PrimaryBrush), not TextPrimaryBrush - standardized every
                     field-prompt label in the app on blue (see HeaderTextBlock/
                     SectionHeaderStyle in GlobalStyles.xaml), this window's own labels
                     were the last ones still on the dark/near-black brush. -->
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            </Style>

            <!-- Professional Row Style -->
            <!-- Margin bumped from "0,3" to "0,8" - the field rows (Ledger/Activity/
                 Balance Type/etc.) were packed too tightly together while the
                 collapsed "Get Balance Function Parameters" accordion at the bottom
                 left a large block of unused vertical space. Widening the per-row
                 margin here (applies uniformly to all ~14 rows via this shared style)
                 uses that spare space to give the field list real breathing room,
                 matching FinalWorkingCode's effectively taller row rhythm (which
                 layers a CompactCombo/CompactRefEditControl Height="30"+Margin
                 bottom="6" on top of the same row margin). -->
            <Style x:Key="ConfigRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Custom Expander Style with proper stretching -->
            <Style x:Key="BlueCircleExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderSite"
                                              Grid.Row="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Cursor="Hand"
                                              Padding="12,10">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                                            <Ellipse Fill="{StaticResource PrimaryBrush}"
                                                     Stroke="{StaticResource PrimaryBrush}"
                                                     StrokeThickness="1"/>
                                            <Path x:Name="Arrow"
                                                  Data="M 5 7 L 9 11 L 13 7"
                                                  Stroke="White"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Grid>
                                        <ContentPresenter Grid.Column="1"
                                                          Margin="8,0,0,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          ContentSource="Header"/>
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Row="1"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ContentSource="Content"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="9" CenterY="9"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0">
        <Grid MinWidth="600" VerticalAlignment="Stretch">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= Header ================= -->
                <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="6,6,0,0" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome Kind="MoneyCheckDollarSolid" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Balance Configurator" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnCancelBottom_Click"/>
                    </Grid>
                </Border>

                <!-- ================= Saved Configurations (collapsed by default) ================= -->
                <Expander Grid.Row="1"
                          x:Name="SavedConfigurationsExpander"
                          Style="{StaticResource BlueCircleExpanderStyle}"
                          IsExpanded="False"
                          Background="White"
                          BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,8">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <iconPacks:PackIconFontAwesome Kind="BookmarkSolid" Width="14" Height="14" Foreground="#2E86AB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SavedConfigurationsHeaderText}" Style="{StaticResource SectionHeaderStyle1}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="12,8,12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ctrls:SuggestAppendComboBox x:Name="CmbSavedConfigurations"
                                                     Grid.Column="0"
                                                     Style="{StaticResource CompactCombo}"
                                                     ItemsSource="{Binding SavedConfigurations}"
                                                     DisplayMemberPath="ConfigName"
                                                     SelectedItem="{Binding SelectedSavedConfig, Mode=TwoWay}"
                                                     Margin="0,0,8,0"/>

                        <Button x:Name="btnSaveNewConfig"
                                Grid.Column="1"
                                Style="{StaticResource CompactActionButton}"
                                Content="Save New"
                                Margin="0,0,4,0"
                                Click="BtnSaveNewConfig_Click"/>

                        <Button x:Name="btnUpdateConfig"
                                Grid.Column="2"
                                Style="{StaticResource CompactActionButton}"
                                Content="Update"
                                Margin="0,0,4,0"
                                IsEnabled="False"
                                Click="BtnUpdateConfig_Click"/>

                        <Button x:Name="btnDeleteConfig"
                                Grid.Column="3"
                                Style="{StaticResource CompactActionButton}"
                                Content="Delete"
                                IsEnabled="False"
                                Click="BtnDeleteConfig_Click"/>

                        <StackPanel x:Name="SaveNamePanel"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <TextBox x:Name="TxtNewConfigName"
                                     Width="220"
                                     MaxLength="32"
                                     Style="{StaticResource CompactTextBox}"
                                     Margin="0,0,8,0"/>
                            <Button Style="{StaticResource CompactActionButton}" Content="Confirm" Margin="0,0,4,0" Click="BtnConfirmSaveNewConfig_Click"/>
                            <Button Style="{StaticResource CompactActionButton}" Content="Cancel" Click="BtnCancelSaveNewConfig_Click"/>
                        </StackPanel>
                    </Grid>
                </Expander>

                <!-- ================= Main Controls Section ================= -->
                <Border Grid.Row="2" Style="{StaticResource ContentBorderStyle}" Margin="0,0,0,8">
                    <!-- MaxHeight bumped from 500 to 620: widening ConfigRowStyle's row
                         margin (0,3 -> 0,8, see that style's comment above) to fix the
                         "controls too close together" spacing complaint made each row
                         taller, and with up to ~12 rows simultaneously visible (Ledger/
                         Activity/BalanceType/Period/EndPeriod(CTD)/Currency/CurrencyType/
                         ActualFlag/Budget-or-Encumbrance/JournalSource/JournalCategory/
                         AccountAssignments) the old 500px cap could clip the last row
                         (Account Assignment(s) was reported rendering only partially
                         visible) instead of just letting the ScrollViewer scroll. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="620">
                        <!-- IsSharedSizeScope: makes every row's Auto-width label column
                             (SharedSizeGroup="ConfigLabelCol") size to the single widest
                             label across all rows, so combos/refedits still line up at a
                             common x position even though the column is no longer a fixed
                             190px. -->
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- Row 0: Ledger -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <!-- Label column: Auto + SharedSizeGroup (scope declared on the
                                         parent StackPanel below) instead of a fixed 190 - this makes
                                         the column shrink-to-fit the WIDEST label across all ~15 rows
                                         ("Account Assignment(s):") automatically, so short labels like
                                         "Ledger:" don't leave a big dead gap before their combo starts,
                                         while every row's combo/refedit still lines up at the same x
                                         (all rows share the same computed column width). -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabelCol"/>
                                    <!-- Combo gets the lion's share of the remaining width; RefEdit
                                         is fixed+narrower per request ("increase combo size, reduce
                                         refedit width"). -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Ledger:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbLedgers"
                                                             Grid.Column="1"
                                                             IsMultiSelect="True"
                                                             Height="28"
                                                             Background="White"
                                                             Foreground="#212529"
                                                             ItemsSource="{Binding Ledgers}"
                                                             DisplayMemberPath="LedgerName"
                                                             SelectedItem="{Binding LedgerField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding LedgerField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding LedgerField.IsComboEnabled}"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefLedger"
                                                           Grid.Column="2"
                                                           Height="28"
                                                           Text="{Binding LedgerField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Ledgers Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="LedgerField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 1: Activity -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <!-- Label column: Auto + SharedSizeGroup (scope declared on the
                                         parent StackPanel below) instead of a fixed 190 - this makes
                                         the column shrink-to-fit the WIDEST label across all ~15 rows
                                         ("Account Assignment(s):") automatically, so short labels like
                                         "Ledger:" don't leave a big dead gap before their combo starts,
                                         while every row's combo/refedit still lines up at the same x
                                         (all rows share the same computed column width). -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabelCol"/>
                                    <!-- Combo gets the lion's share of the remaining width; RefEdit
                                         is fixed+narrower per request ("increase combo size, reduce
                                         refedit width"). -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Activity:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbActivity"
                                                             Grid.Column="1"
                                                             Height="28"
                                                             Background="White"
                                                             Foreground="#212529"
                                                             ItemsSource="{Binding Activities}"
                                                             SelectedItem="{Binding ActivityField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding ActivityField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding ActivityField.IsComboEnabled}"
                                                             DisplayMemberPath="DisplayName"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefActivity"
                                                           Grid.Column="2"
                                                           Height="28"
                                                           Text="{Binding ActivityField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Activity Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="ActivityField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 2: Balance Type -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <!-- Label column: Auto + SharedSizeGroup (scope declared on the
                                         parent StackPanel below) instead of a fixed 190 - this makes
                                         the column shrink-to-fit the WIDEST label across all ~15 rows
                                         ("Account Assignment(s):") automatically, so short labels like
                                         "Ledger:" don't leave a big dead gap before their combo starts,
                                         while every row's combo/refedit still lines up at the same x
                                         (all rows share the same computed column width). -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabelCol"/>
                                    <!-- Combo gets the lion's share of the remaining width; RefEdit
                                         is fixed+narrower per request ("increase combo size, reduce
                                         refedit width"). -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Balance Type:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbBT"
                                                             Grid.Column="1"
                                                             Height="28"
                                                             Background="White"
                                                             Foreground="#212529"
                                                             ItemsSource="{Binding BalanceTypes, UpdateSourceTrigger=PropertyChanged}"
                                                             SelectedItem="{Binding BalanceTypeField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding BalanceTypeField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding BalanceTypeField.IsComboEnabled}"
                                                             DisplayMemberPath="Name"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefBalanceType"
                                                           Grid.Column="2"
                                                           Height="28"
                                                           Text="{Binding BalanceTypeField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Balance Type Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="BalanceTypeField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 3: Start Date - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsStartEndVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <!-- Label column: Auto + SharedSizeGroup (scope declared on the
                                         parent StackPanel below) instead of a fixed 190 - this makes
                                         the column shrink-to-fit the WIDEST label across all ~15 rows
                                         ("Account Assignment(s):") automatically, so short labels like
                                         "Ledger:" don't leave a big dead gap before their combo starts,
                                         while every row's combo/refedit still lines up at the same x
                                         (all rows share the same computed column width). -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabelCol"/>
                                    <!-- Combo gets the lion's share of the remaining width; RefEdit
                                         is fixed+narrower per request ("increase combo size, reduce
                                         refedit width"). -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Start Date:" Style="{StaticResource ConfigLabelStyle}"/>
                                <DatePicker x:Name="dtpStartDate"
            Grid.Column="1"
            Margin="0,0,8,0"
            Height="28"
            VerticalAlignment="Center"
            SelectedDateFormat="Short"
            CalendarOpened="DatePicker_CalendarOpenedEx"
            SelectedDate="{Binding StartDateSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=False, NotifyOnValidationError=True}">
                                    <DatePicker.IsEnabled>
                                        <MultiBinding Converter="{StaticResource BalanceTypeDatePeriodConverter}">
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="StartDateField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </DatePicker.IsEnabled>
                                    <!-- Tooltip will be set in code-behind -->
                                    <DatePicker.Resources>
                                        <Style TargetType="{x:Type DatePickerTextBox}">
                                            <Setter Property="Control.Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                        <TextBox x:Name="PART_TextBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 Padding="4,0,0,0"
                                 Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, Converter={StaticResource NullableDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                                <views:ExcelRefEditControl x:Name="RefStartDate"
                                                           Grid.Column="2"
                                                           Height="28"
                                                           Text="{Binding StartDateField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Start Date Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="StartDateField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 4: End Date - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsStartEndVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <!-- Label column: Auto + SharedSizeGroup (scope declared on the
                                         parent StackPanel below) instead of a fixed 190 - this makes
                                         the column shrink-to-fit the WIDEST label across all ~15 rows
                                         ("Account Assignment(s):") automatically, so short labels like
                                         "Ledger:" don't leave a big dead gap before their combo starts,
                                         while every row's combo/refedit still lines up at the same x
                                         (all rows share the same computed column width). -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabelCol"/>
                                    <!-- Combo gets the lion's share of the remaining width; RefEdit
                                         is fixed+narrower per request ("increase combo size, reduce
                                         refedit width"). -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="End Date:" Style="{StaticResource ConfigLabelStyle}"/>
                                <DatePicker x:Name="dtpEndDate"
            Grid.Column="1"
            Margin="0,0,8,0"
            Height="28"
            VerticalAlignment="Center"
            SelectedDateFormat="Short"
            CalendarOpened="DatePicker_CalendarOpenedEx"
            SelectedDate="{Binding EndDateSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=False, NotifyOnValidationError=True}">
                                    <DatePicker.IsEnabled>
                                        <MultiBinding Converter="{StaticResource BalanceTypeDatePeriodConverter}">
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="EndDateField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </DatePicker.IsEnabled>
                                    <!-- Tooltip will be set in code-behind -->
                                    <DatePicker.Resources>
                                        <Style TargetType="{x:Type DatePickerTextBox}">
                                            <Setter Property="Control.Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                        <TextBox x:Name="PART_TextBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 Padding="4,0,0,0"
                                 Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, Converter={StaticResource NullableDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                                <views:ExcelRefEditControl x:Name="RefEndDate"
                                                           Grid.Column="2"
                                                           Height="28"
                                                           Text="{Binding EndDateField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator End Date Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="EndDateField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 5: Period - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsPeriodVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <!-- Label column: Auto + SharedSizeGroup (scope declared on the
                                         parent StackPanel below) instead of a fixed 190 - this makes
                                         the column shrink-to-fit the WIDEST label across all ~15 rows
                                         ("Account Assignment(s):") automatically, so short labels like
                                         "Ledger:" don't leave a big dead gap before their combo starts,
                                         while every row's combo/refedit still lines up at the same x
                                         (all rows share the same computed column width). -->
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabelCol"/>
                                    <!-- Combo gets the lion's share of the remaining width; RefEdit
                                         is fixed+narrower per request ("increase combo size, reduce
                                         refedit width"). -->
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
