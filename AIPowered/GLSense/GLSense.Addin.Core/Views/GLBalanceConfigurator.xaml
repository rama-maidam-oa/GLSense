                                        <Setter Property="Text" Value="Click to expand balance parameters"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.IsExpanded, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="True">
                                                <Setter Property="Text" Value="Click to collapse balance parameters"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToolTip>
                    </Expander.ToolTip>

                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <iconPacks:PackIconFontAwesome Kind="CodeSolid" Width="14" Height="14" Foreground="#2E86AB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Get Balance Function Parameters" Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <!-- Content that fills available space -->
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Border BorderBrush="#E9ECEF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White"
                                Margin="2"
                                Padding="0"
                                VerticalAlignment="Stretch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="8"
                                          VerticalAlignment="Stretch">
                                <RichTextBox x:Name="BalanceParametersBox"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Padding="4"
                                             FontSize="11"
                                             FontFamily="Segoe UI"
                                             Background="Transparent"
                                             VerticalAlignment="Stretch"
                                             conv:RichTextBoxHelper.BindableDocument="{Binding ParameterDisplayText}">
                                    <RichTextBox.Resources>
                                        <Style TargetType="FlowDocument">
                                            <Setter Property="PagePadding" Value="4"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                        </Style>
                                        <Style TargetType="Paragraph">
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                        </Style>
                                    </RichTextBox.Resources>
                                    <RichTextBox.Document>
                                        <FlowDocument PagePadding="4,0,4,0"/>
                                    </RichTextBox.Document>
                                </RichTextBox>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Expander>
            </Grid>

            <!-- Toast / Busy overlay -->
            <views:AppOverlay x:Name="AppOverlayControl"
                              Grid.ColumnSpan="3"
                              Margin="0"
                              Grid.Row="0"
                              Grid.RowSpan="7"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="Collapsed"
                              DataContext="{x:Null}"
                              Panel.ZIndex="10"/>
        </Grid>
    </ScrollViewer>
</UserControl>
