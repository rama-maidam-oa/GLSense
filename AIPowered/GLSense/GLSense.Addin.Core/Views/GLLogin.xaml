<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLLogin"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:Controls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  mc:Ignorable="d"
                  WindowCaption="GLSense Login"
                  IconSymbol="KeySolid"
                  SizeToContent="WidthAndHeight"
                  MinWidth="450" MaxWidth="450"
                  MinHeight="750" MaxHeight="900"
                  ResizeMode="CanResize"
                  WindowStyle="None"
                  >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0"
              Style="{StaticResource TitleBarGridStyle}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <iconPacks:PackIconFontAwesome Grid.Column="0"
                           Style="{StaticResource TitleBarIconStyle}"
                           Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource TitleBarTextStyle}"
                       Text="{Binding WindowCaption, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="2"
                    x:Name="CloseButton"
                    Style="{StaticResource TitleBarCloseButtonStyle}"
                    Content="&#xE8BB;"
                    Click="CloseButton_Click"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Form Section -->
            <Border Grid.Row="0"
                    Style="{StaticResource LoginCardStyle}"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Instance Label -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Background="Transparent"
                            Style="{StaticResource LabelWithIconStyle}"
                            Margin="0,0,10,8">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome Kind="GlobeSolid"
                                           Style="{StaticResource LabelIconStyle}"/>
                            <TextBlock Text="Instance :"
                                       Style="{StaticResource LabelTextStyle}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Server ComboBox -->
                    <Controls:SuggestAppendComboBox x:Name="cmbServer"
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Height="32"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,0,8"
                                                    ItemsSource="{Binding ServerList}"
                                                    Background="{StaticResource WhiteBrush}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    DisplayMemberPath="Name"
                                                    SelectedItem="{Binding SelectedServer, Mode=TwoWay}"/>

                    <!-- URL Label -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="Transparent"
                            Style="{StaticResource LabelWithIconStyle}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome Kind="LinkSolid"
                                           Style="{StaticResource LabelIconStyle}"/>
                            <TextBlock Text="URL :"
                                       Style="{StaticResource LabelTextStyle}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- URL TextBox -->
                    <TextBox x:Name="txtServer"
                             Grid.Row="1"
                             Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"
                             Text="{Binding SelectedServer.Address, Mode=OneWay}"
                             Background="{StaticResource WhiteBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             TextWrapping="NoWrap">
                        <TextBox.ToolTip>
                            <ToolTip Style="{StaticResource ChromeStyleToolTip}">
                                <TextBlock Text="This URL is read-only and automatically updates based on your instance selection."
                                           TextWrapping="Wrap"
                                           MaxWidth="300"/>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>
            </Border>

            <!-- WebView2 Section -->
            <Border Grid.Row="1"
                    Style="{StaticResource LoginCardStyle}"
                    Padding="0"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <wpf:WebView2 x:Name="webView"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
            </Border>

            <!-- Buttons Section -->
            <Border Grid.Row="2"
                    Background="{StaticResource WhiteBrush}"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnClose"
                            Grid.Column="1"
                            Style="{StaticResource DynamicContentButton}"
                            Content="Close"
                            Click="BtnClose_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay -->
        <local:AppOverlay x:Name="AppOverlayControl"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Visibility="Collapsed"
                          Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>