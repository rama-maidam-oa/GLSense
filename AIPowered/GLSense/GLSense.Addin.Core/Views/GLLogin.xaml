<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLLogin"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:Controls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  mc:Ignorable="d"
                  Background="#F8F9FA"
                  SizeToContent="Manual"
                  Width="540"
                  MinWidth="480" MaxWidth="600"
                  MinHeight="750" MaxHeight="820"
                  ResizeMode="CanResize"
                  WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Merges Generic.xaml directly (which itself merges GlobalStyles.xaml -
                     see Themes\Generic.xaml's own MergedDictionaries) instead of merging
                     GlobalStyles.xaml alone. cmbServer's SuggestAppendComboBox style lives
                     in Generic.xaml and is normally found via WPF's automatic
                     "no local style -> fall back to the defining assembly's
                     Themes/Generic.xaml" mechanism (the ThemeInfo attribute in
                     AssemblyInfo.cs). Diagnostic logging (GLLogin.GLLogin_Loaded) proved
                     that automatic fallback was returning no style at all for cmbServer
                     here (Template stayed NULL, OnApplyTemplate never even fired) - this
                     window is the very first one ever constructed in the process, before
                     any other WPF style lookup has run against this custom, App.xaml-less
                     Application, which is the most likely reason it's the one place this
                     surfaced. Merging Generic.xaml here puts the style directly in this
                     window's own page resources, so it's found on the normal implicit-
                     style lookup path and no longer depends on that automatic fallback. -->
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="RightToBracketSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="Orbit GLSense Login" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- ================= Form + WebView Section ================= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Form Section -->
            <Border Grid.Row="0" Style="{StaticResource LoginCardStyle}" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Instance Row -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Background="White"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,0,10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                            <iconPacks:PackIconFontAwesome Kind="GlobeSolid"
                                           Style="{StaticResource SmallIcon}"
                                           Foreground="#2E86AB"/>
                            <TextBlock Text="Instance:" Style="{StaticResource HeaderTextBlock}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Server ComboBox -->
                    <Controls:SuggestAppendComboBox x:Name="cmbServer"
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Height="32"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,0,8"
                                                    ItemsSource="{Binding ServerList}"
                                                    ArrowBrush="#2E86AB"
                                                    ArrowWidth="10"
                                                    ArrowHeight="8"
                                                    Background="White"
                                                    Foreground="#212529"
                                                    DisplayMemberPath="Name"
                                                    SelectedItem="{Binding SelectedServer, Mode=TwoWay}"/>

                    <!-- URL Row -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="White"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome Kind="LinkSolid"
                                           Style="{StaticResource SmallIcon}"
                                           Foreground="#2E86AB"/>
                            <TextBlock Text="URL:" Style="{StaticResource HeaderTextBlock}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- URL TextBox -->
                    <TextBox x:Name="txtServer"
                             Grid.Row="1"
                             Grid.Column="1"
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"
                             Text="{Binding SelectedServer.Address, Mode=OneWay}"
                             Background="{StaticResource WhiteBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Height="32"
                             TextWrapping="NoWrap">
                        <TextBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="This URL is read-only and automatically updates based on your instance selection."
                                           TextWrapping="Wrap"
                                           MaxWidth="300"/>
                            </ToolTip>
                        </TextBox.ToolTip>
                    </TextBox>
                </Grid>
            </Border>

            <!-- WebView2 Section -->
            <Border Grid.Row="1"
                    Style="{StaticResource LoginCardStyle}"
                    Padding="0"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <wpf:WebView2 x:Name="webView"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
            </Border>
        </Grid>

        <!-- ================= Buttons Section ================= -->
        <Border Grid.Row="2"
                Background="{StaticResource WhiteBrush}"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderLightBrush}"
                Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- ================= App Overlay ================= -->
        <local:AppOverlay x:Name="AppOverlayControl"
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Visibility="Collapsed"
                          Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
