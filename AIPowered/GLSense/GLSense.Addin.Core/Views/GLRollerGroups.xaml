<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLRollerGroups"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:conv="clr-namespace:GLSense.Addin.Core.Converters"
                  mc:Ignorable="d"
                  WindowCaption="Segment Rollup Groups"
                  IconSymbol="CubesSolid"
                  SizeToContent="Manual"
                  MinWidth="800" MaxWidth="840"
                  MinHeight="790"
                  ResizeMode="CanResize"
                  WindowStyle="None"
                  Background="#F8F9FA"
                  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Generic.xaml (not GlobalStyles.xaml alone) - merges GlobalStyles.xaml
                     internally, and also carries SuggestAppendComboBox's own Style/Template.
                     WPF's automatic "fall back to the defining assembly's Themes/Generic.xaml"
                     mechanism for that control proved unreliable in this Excel-hosted
                     environment (see GLLogin.xaml's comment for the full investigation) -
                     merging it explicitly here puts the style in this window's own page
                     resources instead of depending on that fallback. -->
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:TitleRowValueConverter x:Key="TitleRowValueConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="LayerGroupSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="Segment Rollup Groups" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= Main Content ================= -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Segment & Search -->
            <!-- Wrapped in a ScrollViewer (matches FinalWorkingCode) so these fields remain
                 reachable instead of clipped/collapsed when the window can't fully fit on
                 screen - e.g. at 150%+ DPI scaling or on lower resolution displays. -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <StackPanel>
                <Border Background="{StaticResource WhiteBrush}" CornerRadius="8" Margin="0,0,0,8" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome Kind="ChartPieSolid" Width="14" Height="14" Foreground="#2E86AB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Segment:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                        </StackPanel>
                        <ctrls:SuggestAppendComboBox x:Name="cmbSegments" Grid.Column="1" Height="30" HorizontalAlignment="Stretch" ItemsSource="{Binding Segments}" DisplayMemberPath="SegmentName" SelectedItem="{Binding SelectedSegment, Mode=TwoWay}" VerticalAlignment="Center" Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}"/>
                    </Grid>
                </Border>

                <Border Background="{StaticResource WhiteBrush}" CornerRadius="8" Margin="0,0,0,0" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome Kind="SearchenginBrands" Width="14" Height="14" Foreground="#2E86AB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Search:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <ctrls:SuggestAppendComboBox x:Name="cmbSearchType" Width="Auto" MinWidth="150" Height="30" Margin="0,0,8,0" ItemsSource="{Binding SearchTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSearchType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}"/>
                            <TextBox x:Name="txtSearch" Width="Auto" MinWidth="280" Height="30" Style="{StaticResource ModernTextBox}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <TextBlock Text="Filters the data by given value" TextWrapping="Wrap"/>
                                    </ToolTip>
                                </TextBox.ToolTip>
                            </TextBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- Dual DataGrids -->
            <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="220"/>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="1.0*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left DataGrid -->
                    <Border Grid.Column="0" Background="{StaticResource WhiteBrush}" CornerRadius="4" Margin="4">
                        <DataGrid x:Name="dgLeft" FontFamily="Segoe UI" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow" Background="{StaticResource WhiteBrush}" BorderThickness="0.5" GridLinesVisibility="None" CanUserSortColumns="False" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="DgLeft_MouseDoubleClick" IsReadOnly="True" SelectionChanged="dgLeft_SelectionChanged">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                    <Setter Property="Background" Value="#6C757D"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>

                                <!-- Style to completely remove borders for title row cells -->
                                <Style x:Key="TitleRowCellStyle" TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryFlag}" Value="RG">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <!-- Custom element style for title rows to span content -->
                                <Style x:Key="TitleRowElementStyle" TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryFlag}" Value="RG">
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                            <Setter Property="Padding" Value="12,8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SummaryFlag}" Value="False">
                                            <Setter Property="Foreground" Value="#212529"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <!-- Modern DataGrid Text Style for normal rows -->
                                <Style x:Key="ModernDataGridText" TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#1B6B93"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E9ECEF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryFlag}" Value="RG">
                                            <Setter Property="Background" Value="#9AA3AD"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F8FF"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="#212529"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#E9ECEF"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryFlag}" Value="RG">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="#212529"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value" Width="*" CellStyle="{StaticResource TitleRowCellStyle}">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource TitleRowValueConverter}">
                                            <Binding/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="Foreground" Value="#212529"/>

                                            <Style.Triggers>
                                                <!-- Title row text - white foreground to match close button -->
                                                <DataTrigger Binding="{Binding SummaryFlag}" Value="RG">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    <Setter Property="TextAlignment" Value="Left"/>

                                                    <!-- Tooltip for Roller Group Headers -->
                                                    <Setter Property="ToolTip">
                                                        <Setter.Value>
                                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                                <StackPanel>
                                                                    <TextBlock Text="Roller Group: Contains related segment values"
                                                          FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#212529"/>
                                                                    <TextBlock Text="Click to expand/collapse or double-click to select all items"
                                                         TextWrapping="Wrap" Foreground="#212529"/>
                                                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12"
                                          Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                            <StackPanel>
                                                                                <TextBlock Text="Examples:" FontSize="11" FontWeight="SemiBold"
                                             Foreground="Black"/>
                                                                                <TextBlock Text="• Cash (header)" FontSize="11" FontStyle="Italic"
                                             Foreground="Black" Margin="0,2,0,0"/>
                                                                                <TextBlock Text="• Petty Cash, Bank Accounts (items)"
                                             FontSize="11" FontStyle="Italic" Foreground="Black"
                                             Margin="0,2,0,0"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"
                            IsReadOnly="True" CellStyle="{StaticResource TitleRowCellStyle}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="Foreground" Value="#212529"/>

                                            <!-- Default tooltip -->
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#212529"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <!-- Hide description for title rows -->
                                                <DataTrigger Binding="{Binding SummaryFlag}" Value="RG">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Action Buttons Column -->
                    <Grid Grid.Column="1">
                        <GridSplitter Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button x:Name="btnAdd" Style="{StaticResource AddToRightButtonStyle}" Click="BtnAdd_Click"/>
                            <Button x:Name="btnRemove" Style="{StaticResource RemoveFromRightGridButtonStyle}" Click="BtnRemove_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Right DataGrid -->
                    <Border Grid.Column="2" Background="{StaticResource WhiteBrush}" CornerRadius="4" Margin="4">
                        <DataGrid x:Name="dgRight" FontFamily="Segoe UI" ItemsSource="{Binding SelectedItemsRight}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True" Background="{StaticResource WhiteBrush}" BorderThickness="0.5" GridLinesVisibility="None" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="DgRight_MouseDoubleClick">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                                <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                    <Setter Property="Background" Value="#6C757D"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#1B6B93"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F8FF"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="BorderBrush" Value="#2E86AB"/>
                                            <Setter Property="Foreground" Value="#212529"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value1}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding Value1}"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                        <TextBlock Text="{Binding Segment}"/>
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,6,0,0" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Write to Multiple Rows/Columns Checkbox + Overwrite/Insert + By Rows/By Columns, one line -->
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkMultipleRows" Content="Write to Multiple Rows/Columns"
                              Style="{StaticResource ModernCheckBox}"
                              IsEnabled="{Binding IsMultipleRowsEnabled}"
                              IsChecked="{Binding IsMultipleRowsChecked, Mode=TwoWay}"
                              VerticalAlignment="Center" FontWeight="SemiBold"
                              Foreground="#2E86AB">
                        <CheckBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Controls how roller groups are inserted into Excel" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12"
                                  Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="✓ Checked: Each item in its own cell (By Rows/By Columns below)"
                                     FontSize="11" FontStyle="Italic" Foreground="Black" TextWrapping="Wrap" MaxWidth="220"/>
                                                <TextBlock Text="✗ Unchecked: All items in single Excel cell"
                                     FontSize="11" FontStyle="Italic" Foreground="Black"
                                     Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>

                    <!-- Overwrite / Insert - disabled together with the Multiple Rows checkbox
                         above (bound to the same IsMultipleRowsEnabled), forced back to Overwrite
                         whenever that happens (see Vm_PropertyChanged in code-behind). Ported from
                         FinalWorkingCode's identical GLRollerGroups.xaml. -->
                    <RadioButton x:Name="rbOverwrite" Content="Overwrite" Style="{StaticResource ModernRadioButton}" GroupName="RollerGroupsWriteModeGroup" IsEnabled="{Binding IsMultipleRowsEnabled}" IsChecked="True" FontWeight="SemiBold" Foreground="#2E86AB" VerticalAlignment="Center" Margin="28,0,0,0"/>
                    <RadioButton x:Name="rbInsert" Content="Insert" Style="{StaticResource ModernRadioButton}" GroupName="RollerGroupsWriteModeGroup" IsEnabled="{Binding IsMultipleRowsEnabled}" Margin="16,0,0,0" FontWeight="SemiBold" Foreground="#2E86AB" VerticalAlignment="Center">
                        <RadioButton.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Inserts new row(s) at the cell reference, shifting existing content down, instead of overwriting it." TextWrapping="Wrap" MaxWidth="260"/>
                            </ToolTip>
                        </RadioButton.ToolTip>
                    </RadioButton>

                    <!-- By Rows / By Columns - orientation for the multi-cell write path only.
                         Ported from FinalWorkingCode's identical GLRollerGroups.xaml. -->
                    <RadioButton x:Name="rbByRows" Content="By Rows" Style="{StaticResource ModernRadioButton}" GroupName="RollerGroupsOrientationGroup" IsEnabled="{Binding IsMultipleRowsEnabled}" IsChecked="True" FontWeight="SemiBold" Foreground="#2E86AB" VerticalAlignment="Center" Margin="28,0,0,0"/>
                    <RadioButton x:Name="rbByColumns" Content="By Columns" Style="{StaticResource ModernRadioButton}" GroupName="RollerGroupsOrientationGroup" IsEnabled="{Binding IsMultipleRowsEnabled}" Margin="16,0,0,0" FontWeight="SemiBold" Foreground="#2E86AB" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Row 1, left corner: Cell Reference -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="Reference:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                    <local:ExcelRefEditControl x:Name="excelRefEdit" TagName="Roller Groups Cell Reference" Height="30" Width="175" VerticalAlignment="Center" Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Row 1, right corner: Action Buttons -->
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,15,0,0">
                    <Button x:Name="btnOK" Style="{StaticResource InsertButtonStyle}" Width="90" Click="BtnOK_Click" Margin="0,0,8,0">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Insert selected roller groups into Excel at specified cell reference" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12"
                                  Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="Will insert:" FontSize="11" FontWeight="SemiBold" Foreground="Black"/>
                                                <TextBlock Text="• Selected roller group items"
                                     FontSize="11" FontStyle="Italic" Foreground="Black"
                                     Margin="0,2,0,0"/>
                                                <TextBlock Text="• Based on multiple rows checkbox setting"
                                     FontSize="11" FontStyle="Italic" Foreground="Black"
                                     Margin="0,2,0,0"/>
                                                <TextBlock Text="• Into selected Excel cell/range"
                                     FontSize="11" FontStyle="Italic" Foreground="Black"
                                     Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="CmdClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
