<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLSegmentFunctions"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:sys="clr-namespace:System;assembly=mscorlib"
                  mc:Ignorable="d"
                  WindowCaption="GLSense Get Segment"
                  IconSymbol="FilterSolid"
                  SizeToContent="WidthAndHeight"
                  MinWidth="640" MaxWidth="660"
                  MinHeight="350" MaxHeight="520"
                  ResizeMode="CanResize"
                  WindowStyle="SingleBorderWindow"
                  ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <sys:Double x:Key="LabelMinWidth">120</sys:Double>
            <sys:Double x:Key="ControlHeight">32</sys:Double>
            <Thickness x:Key="ControlMargin">6,0</Thickness>
            <Thickness x:Key="LabelMargin">0,0,6,0</Thickness>
            <sys:Double x:Key="RefEditMinWidth">200</sys:Double>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- SizeToContent="WidthAndHeight" (see GLGetPeriod.xaml for the general
             reasoning - BaseWindow's ContentRendered resettle, CLAUDE.md 1.4e, fixes
             the collapse-until-resize symptom generically now). This window doubly
             needs WidthAndHeight rather than the earlier "Width"-only + dead spacer
             row workaround: its ParentChildSection/AttributesSection/ResultSection/
             IncludeValuesSection are conditionally Collapsed in code-behind depending
             on the selected function type, so its content height genuinely varies -
             exactly the case 1.4's own guidance says should stay on WidthAndHeight
             rather than being forced into a fixed Min/MaxHeight range. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>
            <TextBlock x:Name="TxtFuncName" Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="Get Segment" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="BtnClose_Click"/>
        </Grid>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,10,10,4">
            <StackPanel>
                <!-- Ledger Selection -->
                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Ledger :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox x:Name="cmbLedgers" Grid.Column="1" Height="{StaticResource ControlHeight}"
                                                     ItemsSource="{Binding Ledgers}" DisplayMemberPath="LedgerName"
                                                     SelectedItem="{Binding LedgerField.ComboValue, Mode=TwoWay}"
                                                     Text="{Binding LedgerField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center" Margin="{StaticResource ControlMargin}"
                                                     Background="White" Foreground="#212529"
                                                     IsEnabled="{Binding LedgerField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}"
                                                   Text="{Binding LedgerField.RefValue, Mode=TwoWay}"
                                                   TagName="Segments Ledgers Field"
                                                   IsEnabled="{Binding LedgerField.IsRefEnabled}"
                                                   MinWidth="{StaticResource RefEditMinWidth}"
                                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Segment Name -->
                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Segment Name :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox Grid.Column="1" Height="{StaticResource ControlHeight}"
                                                     ItemsSource="{Binding Segments}" DisplayMemberPath="SegmentName"
                                                     SelectedItem="{Binding SegmentField.ComboValue, Mode=TwoWay}"
                                                     Text="{Binding SegmentField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"
                                                     IsEnabled="{Binding SegmentField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}"
                                                   Text="{Binding SegmentField.RefValue, Mode=TwoWay}"
                                                   IsEnabled="{Binding SegmentField.IsRefEnabled}"
                                                   MinWidth="{StaticResource RefEditMinWidth}"
                                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Segment Values -->
                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Segment Values :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox Grid.Column="1" Height="{StaticResource ControlHeight}"
                                                     ItemsSource="{Binding SegmentValues}" DisplayMemberPath="SegmentValue"
                                                     SelectedItem="{Binding SegmentValueField.ComboValue, Mode=TwoWay}"
                                                     Text="{Binding SegmentValueField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"
                                                     IsEnabled="{Binding SegmentValueField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}"
                                                   Text="{Binding SegmentValueField.RefValue, Mode=TwoWay}"
                                                   IsEnabled="{Binding SegmentValueField.IsRefEnabled}"
                                                   MinWidth="{StaticResource RefEditMinWidth}"
                                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Parent / Child -->
                <Border x:Name="ParentChildSection" Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" Visibility="Hidden"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource ControlMargin}" HorizontalAlignment="Left">
                            <CheckBox x:Name="ChkIncludeParent" Content="Next Parent" Style="{StaticResource ModernCheckBox}"
                                      IsChecked="{Binding IsParentChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <CheckBox x:Name="ChkIncludeChild" Content="Next Child" Style="{StaticResource ModernCheckBox}"
                                      IsChecked="{Binding IsChildChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Attributes -->
                <Border x:Name="AttributesSection" Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Attributes :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox x:Name="cmbAttributes" Grid.Column="1" Height="{StaticResource ControlHeight}"
                                                     ItemsSource="{Binding AttributeTypes}" DisplayMemberPath="DisplayName"
                                                     SelectedItem="{Binding AttributeField.ComboValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Text="{Binding AttributeField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding AttributeField.IsComboEnabled}" VerticalAlignment="Center"
                                                     Margin="{StaticResource ControlMargin}" Background="White" Foreground="#212529"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}"
                                                   Text="{Binding AttributeField.RefValue, Mode=TwoWay}"
                                                   TagName="Segments Attribute Field"
                                                   IsEnabled="{Binding AttributeField.IsRefEnabled}"
                                                   MinWidth="{StaticResource RefEditMinWidth}"
                                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Result -->
                <Border x:Name="ResultSection" Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Result :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtResult" Grid.Column="1" Style="{StaticResource ReadOnlyTextBox}"
                                 Height="{StaticResource ControlHeight}"
                                 Text="{Binding ResultText, Mode=OneWay}"
                                 Margin="{StaticResource ControlMargin}" VerticalAlignment="Center">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Displays the calculated result based on your selections" TextWrapping="Wrap"/>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                        <StackPanel x:Name="IncludeValuesSection" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkIncludeSegmentValues" VerticalAlignment="Center"
                                      Content="Include Segment Values"
                                      IsChecked="{Binding IsParentValueChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cell Reference -->
                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Reference :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <local:ExcelRefEditControl x:Name="CellReference" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Height="{StaticResource ControlHeight}"
                                                   Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   TagName="Segments Cell Reference"
                                                   Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,10" Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSubmit" Style="{StaticResource InsertButtonStyle}" Click="BtnSubmit_Click" Margin="0,0,8,0"/>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
