<local:DpiAwareWindow x:Class="GLSense.Addin.Core.Views.GLSegmentFunctions" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:sys="clr-namespace:System;assembly=mscorlib" 
					  xmlns:utils="clr-namespace:GLSense.Addin.Core.Utilities" 
					  xmlns:local="clr-namespace:GLSense.Addin.Core.Views" 
					  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls" 
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
					  WindowStyle="None" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" SizeToContent="Height" 
					  MinHeight="350" MaxHeight="490" MinWidth="640" MaxWidth="700" Background="#F8F9FA">
    <local:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Define consistent widths for labels and controls -->
            <sys:Double x:Key="LabelMinWidth">120</sys:Double>
            <sys:Double x:Key="ControlHeight">32</sys:Double>
            <Thickness x:Key="ControlMargin">6,0</Thickness>
            <Thickness x:Key="LabelMargin">0,0,6,0</Thickness>
            <sys:Double x:Key="RefEditMinWidth">200</sys:Double>
        </ResourceDictionary>
    </local:DpiAwareWindow.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="SlidersSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock x:Name="TxtFuncName" Text="Get Segment" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ================= Main Content ================= -->
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
            <StackPanel>
                <!-- Ledger Selection (first row from old 9-row layout) -->
                <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,8" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Ledger :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox x:Name="cmbLedgers" Grid.Column="1" Height="{StaticResource ControlHeight}"
                                                     ItemsSource="{Binding Ledgers}" DisplayMemberPath="LedgerName"
                                                     SelectedItem="{Binding LedgerField.ComboValue, Mode=TwoWay}"
                                                     Text="{Binding LedgerField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center" Margin="{StaticResource ControlMargin}"
                                                     ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8"
                                                     Background="White" Foreground="#212529"
                                                     IsEnabled="{Binding LedgerField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}"
                                                   Style="{StaticResource CompactRefEditControl}"
                                                   Text="{Binding LedgerField.RefValue, Mode=TwoWay}"
                                                   TagName="Periods Ledgers Field"
                                                   IsEnabled="{Binding LedgerField.IsRefEnabled}"
                                                   MinWidth="{StaticResource RefEditMinWidth}"
                                                   Margin="0,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Segment Name -->
                <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,8" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Segment Name :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox Grid.Column="1" Height="{StaticResource ControlHeight}"
                                                     ItemsSource="{Binding Segments}" DisplayMemberPath="SegmentName"
                                                     SelectedItem="{Binding SegmentField.ComboValue, Mode=TwoWay}"
                                                     Text="{Binding SegmentField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"
                                                     IsEnabled="{Binding SegmentField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}"
                                                   Style="{StaticResource CompactRefEditControl}"
                                                   Text="{Binding SegmentField.RefValue, Mode=TwoWay}"
                                                   IsEnabled="{Binding SegmentField.IsRefEnabled}"
                                                   MinWidth="{StaticResource RefEditMinWidth}"
                                                   Margin="0,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Segment Values -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,8" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Segment Values :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox Grid.Column="1" Height="{StaticResource ControlHeight}"
                                                     ItemsSource="{Binding SegmentValues}" DisplayMemberPath="SegmentValue"
                                                     SelectedItem="{Binding SegmentValueField.ComboValue, Mode=TwoWay}"
                                                     Text="{Binding SegmentValueField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"
                                                     IsEnabled="{Binding SegmentValueField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}"
                                                   Style="{StaticResource CompactRefEditControl}"
                                                   Text="{Binding SegmentValueField.RefValue, Mode=TwoWay}"
                                                   IsEnabled="{Binding SegmentValueField.IsRefEnabled}"
                                                   MinWidth="{StaticResource RefEditMinWidth}"
                                                   Margin="0,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Parent / Child -->
                <Border x:Name="ParentChildSection" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,8" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" Visibility="Hidden"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource ControlMargin}" HorizontalAlignment="Left">
                            <CheckBox x:Name="ChkIncludeParent" Content="Next Parent" Style="{StaticResource ModernCheckBox}"
                                      IsChecked="{Binding IsParentChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <CheckBox x:Name="ChkIncludeChild" Content="Next Child" Style="{StaticResource ModernCheckBox}"
                                      IsChecked="{Binding IsChildChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Attributes -->
                <Border x:Name="AttributesSection" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,8" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Attributes :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox x:Name="cmbAttributes" Grid.Column="1" Height="{StaticResource ControlHeight}"
                                                     ItemsSource="{Binding AttributeTypes}" DisplayMemberPath="DisplayName"
                                                     SelectedItem="{Binding AttributeField.ComboValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Text="{Binding AttributeField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding AttributeField.IsComboEnabled}" VerticalAlignment="Center"
                                                     Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8"
                                                     Background="White" Foreground="#212529"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}"
                                                   Style="{StaticResource CompactRefEditControl}"
                                                   Text="{Binding AttributeField.RefValue, Mode=TwoWay}"
                                                   TagName="Segments Attribute Field"
                                                   IsEnabled="{Binding AttributeField.IsRefEnabled}"
                                                   MinWidth="{StaticResource RefEditMinWidth}"
                                                   Margin="0,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Result -->
                <Border x:Name="ResultSection" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,8" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Result :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtResult" Grid.Column="1" Style="{StaticResource ReadOnlyTextBox}"
                                 Height="{StaticResource ControlHeight}"
                                 Text="{Binding ResultText, Mode=OneWay}"
                                 Margin="{StaticResource ControlMargin}" VerticalAlignment="Center">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <StackPanel>
                                        <TextBlock Text="Displays the calculated result based on your selections" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                        <StackPanel x:Name="IncludeValuesSection" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkIncludeSegmentValues" VerticalAlignment="Center"
                                      Content="Include Segment Values"
                                      IsChecked="{Binding IsParentValueChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cell Reference -->
                <Border Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,0" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Reference :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <local:ExcelRefEditControl x:Name="CellReference" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Height="{StaticResource ControlHeight}"
                                                   Style="{StaticResource CompactRefEditControl}"
                                                   Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   TagName="Segments Cell Reference"
                                                   Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Buttons ================= -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="8,4" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSubmit" Style="{StaticResource InsertButtonStyle}" Click="BtnSubmit_Click" Margin="0,0,8,0"/>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- ================= Overlay ================= -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="3" Panel.ZIndex="10" Visibility="Collapsed" DataContext="{x:Null}"/>
    </Grid>
</local:DpiAwareWindow>
