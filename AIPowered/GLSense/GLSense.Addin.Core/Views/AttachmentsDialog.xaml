<views:BaseWindow x:Class="GLSense.Addin.Core.Views.AttachmentsDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  WindowStyle="None"
                  WindowStartupLocation="Manual"
                  SizeToContent="Manual"
                  MinWidth="340" MaxWidth="600"
                  MinHeight="400" MaxHeight="700"
                  ResizeMode="CanResize"
                  Background="#F8F9FA"
                  ShowInTaskbar="False"
                  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content: Checked List -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="PaperclipSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="Select Attachments to Download" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- Content: Checked ListBox -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderThickness="1" Margin="0,0,0,4">
            <Border.ToolTip>
                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                    <TextBlock Text="Select attachments to download by checking the boxes"/>
                </ToolTip>
            </Border.ToolTip>
            <!--
            MinHeight (not Auto): unlike GLMessageWindow/GLLoginDetails/GLDailyRates/
            GLGetPeriod*'s fixed-size content, this ScrollViewer wraps a genuinely
            variable-length attachment list, so it needs to keep real "*"-row fill/
            scroll semantics rather than being converted to Auto (which would remove
            its ability to scroll instead of growing the window unboundedly for a long
            attachment list). The same root cause still applies though: a bare "*" row
            collapses toward 0 during SizeToContent's infinite-availSize measurement
            pass, so a MinHeight here (mirroring the MinWidth="220" fix already used on
            GLSegmentRef/GLSegmentManager/GLSegmentValues' dual-DataGrid columns for
            the identical reason) stops that pathological first-pass collapse while
            still letting it grow/scroll normally for however many attachments there
            actually are.
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="220">
                <ListBox x:Name="AttachmentsListBox" Margin="0,4,0,0" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding}" Style="{StaticResource ModernCheckBox}">
                                <CheckBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <TextBlock Text="Check to include this file in download"/>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource DynamicContentButton}" Content="Download Selected" Click="CmdExecute_Click" Margin="0,0,10,0">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock Text="Download all checked attachments"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- App Overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="10"/>
    </Grid>
</views:BaseWindow>
