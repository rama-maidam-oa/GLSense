<views:BaseWindow x:Class="GLSense.Addin.Core.Views.AttachmentsDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  mc:Ignorable="d"
                  WindowCaption="Select Attachments to Download"
                  IconSymbol="PaperclipSolid"
                  WindowStartupLocation="CenterOwner"
                  SizeToContent="WidthAndHeight"
                  MinWidth="340" MaxWidth="600"
                  MinHeight="400" MaxHeight="700"
                  ResizeMode="CanResize"
                  WindowStyle="None"
                  ShowInTaskbar="False"
                  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="Select Attachments to Download" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="BtnClose_Click"/>
        </Grid>

        <!-- Content: Checked ListBox -->
        <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,10,10,4">
            <Border.ToolTip>
                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                    <TextBlock Text="Select attachments to download by checking the boxes"/>
                </ToolTip>
            </Border.ToolTip>
            <!--
            MinHeight (not Auto): unlike GLMessageWindow/GLLoginDetails/GLDailyRates/
            GLGetPeriod*'s fixed-size content, this ScrollViewer wraps a genuinely
            variable-length attachment list, so it needs to keep real "*"-row fill/
            scroll semantics rather than being converted to Auto (which would remove
            its ability to scroll instead of growing the window unboundedly for a long
            attachment list). The same root cause still applies though: a bare "*" row
            collapses toward 0 during SizeToContent's infinite-availSize measurement
            pass, so a MinHeight here (mirroring the MinWidth="220" fix already used on
            GLSegmentRef/GLSegmentManager/GLSegmentValues' dual-DataGrid columns for
            the identical reason) stops that pathological first-pass collapse while
            still letting it grow/scroll normally for however many attachments there
            actually are.
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MinHeight="220">
                <ListBox x:Name="AttachmentsListBox" Margin="0,4,0,0" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding}" Style="{StaticResource ModernCheckBox}">
                                <CheckBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <TextBlock Text="Check to include this file in download"/>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,10" Padding="8,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource InsertButtonStyle}" Content="Download Selected" Click="CmdExecute_Click" Margin="0,0,10,0">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock Text="Download all checked attachments"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</views:BaseWindow>
