<local:DpiAwareWindow x:Class="GLSense.Addin.Core.Views.GLWaitWindow" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:utils="clr-namespace:GLSense.Addin.Core.Utilities" 
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
					  xmlns:local="clr-namespace:GLSense.Addin.Core.Views" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
					  SizeToContent="Height" Width="420" MinHeight="180" MaxHeight="350" WindowStyle="None"
					  AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <local:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:DpiAwareWindow.Resources>
    <!-- Shadow Effect -->
    <Border Margin="16" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.2" Color="Black"/>
        </Border.Effect>
        <!-- Main Content -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Content -->
                    <RowDefinition Height="*"/>
                    <!--
                    Spacer row (2026-07-15 fix): contributes 0 height in the normal
                    SizeToContent="Height" auto-measure pass (Star rows measure as 0 with
                    infinite available height), so it's invisible day-to-day. It only
                    matters when AppOverlay.EnsureOwnerWindowRoomForConfirm temporarily
                    switches this window to a taller, manually-sized Height while a confirm
                    popup is showing (e.g. BalanceRefresh.EnsureCompatibilityAsync) - without
                    this row, that extra height had nowhere to go and rendered as dead blank
                    space below the Cancel button, since AppOverlayControl only spanned the
                    two Auto rows above. Now AppOverlayControl spans this row too, so its
                    dimmed background/popup properly cover the full enlarged window instead.
                    -->
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="10,10,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Left side with icon and title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome Kind="RotateSolid" Style="{StaticResource LargeIcon}"/>
                            <TextBlock x:Name="txtTitle" Text="Refreshing Data" Style="{StaticResource TitleHeaderTextBlock}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Content -->
                <Border Grid.Row="1" Padding="20,16,20,16" CornerRadius="0,0,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Process Label -->
                            <RowDefinition Height="*"/>
                            <!-- Scrollable Content -->
                            <RowDefinition Height="Auto"/>
                            <!-- Time & Button -->
                        </Grid.RowDefinitions>
                        <!-- Process Name -->
                        <TextBlock x:Name="ProcessNameLabel" FontFamily="Segoe UI" Grid.Row="0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Text="Loading data..." HorizontalAlignment="Left"/>
                        <!-- Scrollable middle section -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"/>
                                    <!-- Spacing -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Progress Bar -->
                                    <RowDefinition Height="20"/>
                                    <!-- Spacing -->
                                </Grid.RowDefinitions>
                                <!-- Progress Bar -->
                                <ProgressBar x:Name="ProgressBarControl" Grid.Row="1" Style="{StaticResource ModernProgressBar}" IsIndeterminate="True" Visibility="Visible"/>
                            </Grid>
                        </ScrollViewer>
                        <!-- Bottom Row: Time and Cancel Button -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Elapsed Time -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Using Clock icon for elapsed time -->
                                <iconPacks:PackIconFontAwesome Kind="ClockSolid" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="ElapsedTimeLabel" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="Time Elapsed: 00:00"/>
                            </StackPanel>
                            <!-- Cancel Button -->
                            <Button x:Name="BtnCancel" Grid.Column="1" Style="{StaticResource ProgressButton}" Width="80" Click="BtnCancel_Click" ToolTip="Cancel operation">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconFontAwesome Kind="CircleXmarkSolid" Width="10" Height="10" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Cancel" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <!-- Overlay -->
                <local:AppOverlay x:Name="AppOverlayControl" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Border>
</local:DpiAwareWindow>
