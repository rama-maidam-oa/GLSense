<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLUserConfig"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:conv="clr-namespace:GLSense.Addin.Core.Converters"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  mc:Ignorable="d"
                  WindowCaption="GLSense User Preferences"
                  IconSymbol="UserGearSolid"
                  SizeToContent="Manual"
                  MinHeight="430" MaxHeight="520" MinWidth="550" MaxWidth="630"
                  ResizeMode="CanResize"
                  WindowStyle="None"
                  Background="#F8F9FA"
                  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1">
    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="UserGearSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="GLSense User Preferences" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- TAB CONTROL -->
        <!-- Wrapped in a ScrollViewer (matches FinalWorkingCode) so content remains reachable
             instead of clipped/collapsed when the window can't fully fit on screen - e.g. at
             150%+ DPI scaling or on lower resolution displays. -->
        <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <TabControl x:Name="MainTabControl" HorizontalContentAlignment="Left" Style="{StaticResource ModernTabControl}" ItemContainerStyle="{StaticResource TabItemStyle}" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="DrillDowns">
                    <Border Style="{StaticResource CompactCardStyle}" Padding="6" Margin="0,4,0,0">
                        <DataGrid x:Name="dgDrillDowns" FontFamily="Segoe UI" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Background="White" BorderThickness="0" GridLinesVisibility="None" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}" RowStyle="{StaticResource ModernDataGridRowWithBorder}" CellStyle="{StaticResource ModernDataGridCell}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DrillDowns" Binding="{Binding Name}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource ModernDataGridTextBlock}"/>
                                <DataGridTemplateColumn Header="Run as Job" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding RunAsJob, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRunAsJob}" Style="{StaticResource ModernDataGridCheckBoxColumn}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Include Manual Journals (SubLedger Drilldown only) -->
                                <DataGridTemplateColumn Header="Include Manual Journals" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IncludeManualJournal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanEditManualJournals}"
                                                      Visibility="{Binding ShowManualJournalsColumn, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      Style="{StaticResource ModernDataGridCheckBoxColumn}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
                <TabItem Header="Options">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <StackPanel Margin="4">
                            <!-- Consolidated Options Card -->
                            <Border Style="{StaticResource CompactCardStyle}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- 1.) No Data/Missing Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="No Data/Missing :" Style="{StaticResource TextBlockLabelStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ctrls:SuggestAppendComboBox x:Name="CmbOptions" Grid.Column="1" HorizontalAlignment="Stretch" Height="30" Margin="8,0,0,0" Foreground="Black" DisplayMemberPath="Value" Loaded="CmbOptions_Loaded"/>
                                    </Grid>
                                    <!-- 2.) Refresh Cells Row -->
                                    <Grid Grid.Row="1" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Range Cells :" Style="{StaticResource TextBlockLabelStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ctrls:NumericSpinner x:Name="SpinnerRefreshCells" Grid.Column="1" Minimum="1" Maximum="100" HintText="Minimum 1, maximum 100." HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="28" Margin="8,0,0,0" ValueChanged="SpinnerRefreshCells_ValueChanged"/>
                                    </Grid>
                                    <!-- 3.) Records per page Row -->
                                    <Grid Grid.Row="2" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Records per page :" Style="{StaticResource TextBlockLabelStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ctrls:NumericSpinner x:Name="SpinnerRecordsPerPage" Grid.Column="1" Minimum="1" Maximum="1000" HintText="Minimum 1, maximum 1000." Step="10" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="28" Margin="8,0,0,0" ValueChanged="SpinnerRecordsPerPage_ValueChanged"/>
                                    </Grid>
                                    <!-- 4.) Validate Cube Checkbox -->
                                    <CheckBox x:Name="ChkValidateCube" Grid.Row="3" Content="Live Data Check" Style="{StaticResource CompactCheckBox}" Margin="0,10,0,12" HorizontalAlignment="Left" Checked="ChkValidateCube_Checked" Unchecked="ChkValidateCube_Unchecked">
                                        <CheckBox.ToolTip>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <TextBlock Text="When enabled, cube validation will be performed while selecting the cube." FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300"/>
                                            </ToolTip>
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                    <!-- 5.) Suppress zeroes Checkbox -->
                                    <CheckBox x:Name="ChkZeroes" Grid.Row="4" Content="Suppress zeroes in Balance Drilldown" Style="{StaticResource CompactCheckBox}" Margin="0,0,0,12" HorizontalAlignment="Left" Checked="ChkZeroes_Checked" Unchecked="ChkZeroes_Unchecked"/>
                                    <!-- 6.) Overwrite drilldown metadata Checkbox - default unchecked -->
                                    <CheckBox x:Name="ChkOverwriteDrilldownMetadata" Grid.Row="5" Content="Overwrite drilldown metadata with locally saved" Style="{StaticResource CompactCheckBox}" Margin="0,0,0,0" HorizontalAlignment="Left" Checked="ChkOverwriteDrilldownMetadata_Checked" Unchecked="ChkOverwriteDrilldownMetadata_Unchecked">
                                        <CheckBox.ToolTip>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <TextBlock Text="When enabled, drilldowns will use the drilldown metadata saved locally (via Save Locally) instead of fetching it fresh." FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300"/>
                                            </ToolTip>
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <!-- BUTTONS -->
        <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- RESET BUTTON - Left aligned -->
                <Button Grid.Column="0" Content="Reset" Style="{StaticResource DynamicContentButton}" Click="CmdReset_Click">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock Text="Reset all preferences to default values." FontWeight="SemiBold"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <!-- spacer -->
                <Grid Grid.Column="1"/>
                <!-- SAVE and CLOSE BUTTONS - Right aligned -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Save" Margin="0,0,8,0" Style="{StaticResource DynamicContentButton}" Click="CmdSave_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Save preferences." FontWeight="SemiBold"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
    </Border>
</views:BaseWindow>
