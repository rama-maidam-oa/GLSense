<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLUserConfig"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:conv="clr-namespace:GLSense.Addin.Core.Converters"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  mc:Ignorable="d"
                  WindowCaption="GLSense User Preferences"
                  IconSymbol="GearSolid"
                  SizeToContent="WidthAndHeight"
                  MinWidth="500" MaxWidth="600"
                  MinHeight="400" MaxHeight="560"
                  ResizeMode="CanResize"
                  WindowStyle="SingleBorderWindow"
                  ExtendsContentIntoTitleBar="True"
                  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Style="{StaticResource TitleBarGridStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconFontAwesome Grid.Column="0" Style="{StaticResource TitleBarIconStyle}" Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource TitleBarTextStyle}" Text="{Binding WindowCaption, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" Click="BtnClose_Click"/>
        </Grid>

        <!-- TAB CONTROL -->
        <!-- Wrapped in a ScrollViewer (matches FinalWorkingCode) so content remains reachable
             instead of clipped/collapsed when the window can't fully fit on screen - e.g. at
             150%+ DPI scaling or on lower resolution displays. -->
        <ScrollViewer Grid.Row="1" Margin="10,10,10,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Border Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}">
            <TabControl x:Name="MainTabControl" HorizontalContentAlignment="Left" Style="{StaticResource ModernTabControl}" ItemContainerStyle="{StaticResource ModernTabItem}" SelectionChanged="MainTabControl_SelectionChanged" Margin="8">
                <TabItem Header="DrillDowns">
                    <Border Background="{StaticResource WhiteBrush}" CornerRadius="4" Padding="4" Margin="0,8,0,0">
                        <DataGrid x:Name="dgDrillDowns" FontFamily="Segoe UI" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Background="{StaticResource WhiteBrush}" BorderThickness="0" GridLinesVisibility="None" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E86AB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#1B6B93"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Height" Value="38"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                    <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Height" Value="36"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DrillDowns" Binding="{Binding Name}" Width="Auto" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Run as Job" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding RunAsJob, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRunAsJob}" Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Include Manual Journals (SubLedger Drilldown only) -->
                                <DataGridTemplateColumn Header="Include Manual Journals" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IncludeManualJournal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanEditManualJournals}"
                                                      Visibility="{Binding ShowManualJournalsColumn, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      Style="{StaticResource ModernCheckBox}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
                <TabItem Header="Options">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                        <Border Background="{StaticResource WhiteBrush}" CornerRadius="4" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 1.) No Data/Missing Row -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="No Data/Missing :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ctrls:SuggestAppendComboBox x:Name="CmbOptions" Grid.Column="1" HorizontalAlignment="Stretch" Height="30" Margin="8,0,0,0" Foreground="Black" DisplayMemberPath="Value" Loaded="CmbOptions_Loaded"/>
                                </Grid>
                                <!-- 2.) Refresh Cells Row -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Range Cells :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ctrls:NumericSpinner x:Name="SpinnerRefreshCells" Grid.Column="1" Minimum="1" Maximum="100" HintText="Minimum 1, maximum 100." HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="28" Margin="8,0,0,0" ValueChanged="SpinnerRefreshCells_ValueChanged"/>
                                </Grid>
                                <!-- 3.) Records per page Row -->
                                <Grid Grid.Row="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Records per page :" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ctrls:NumericSpinner x:Name="SpinnerRecordsPerPage" Grid.Column="1" Minimum="1" Maximum="1000" HintText="Minimum 1, maximum 1000." Step="10" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="28" Margin="8,0,0,0" ValueChanged="SpinnerRecordsPerPage_ValueChanged"/>
                                </Grid>
                                <!-- 4.) Validate Cube Checkbox -->
                                <CheckBox x:Name="ChkValidateCube" Grid.Row="3" Content="Live Data Check" Style="{StaticResource CompactCheckBox}" Margin="0,10,0,12" HorizontalAlignment="Left" Checked="ChkValidateCube_Checked" Unchecked="ChkValidateCube_Unchecked">
                                    <CheckBox.ToolTip>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="When enabled, cube validation will be performed while selecting the cube." FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300"/>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <!-- 5.) Suppress zeroes Checkbox -->
                                <CheckBox x:Name="ChkZeroes" Grid.Row="4" Content="Suppress zeroes in Balance Drilldown" Style="{StaticResource CompactCheckBox}" Margin="0,0,0,12" HorizontalAlignment="Left" Checked="ChkZeroes_Checked" Unchecked="ChkZeroes_Unchecked"/>
                                <!-- 6.) Overwrite drilldown metadata Checkbox - default unchecked -->
                                <CheckBox x:Name="ChkOverwriteDrilldownMetadata" Grid.Row="5" Content="Overwrite drilldown metadata with locally saved" Style="{StaticResource CompactCheckBox}" Margin="0,0,0,0" HorizontalAlignment="Left" Checked="ChkOverwriteDrilldownMetadata_Checked" Unchecked="ChkOverwriteDrilldownMetadata_Unchecked">
                                    <CheckBox.ToolTip>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="When enabled, drilldowns will use the drilldown metadata saved locally (via Save Locally) instead of fetching it fresh." FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300"/>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
        </ScrollViewer>

        <!-- BUTTONS -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,10" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- RESET BUTTON - Left aligned -->
                <Button Grid.Column="0" Content="Reset" Style="{StaticResource DynamicContentButton}" Click="CmdReset_Click">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock Text="Reset all preferences to default values." FontWeight="SemiBold"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                <!-- SAVE and CLOSE BUTTONS - Right aligned -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Save" Margin="0,0,8,0" Style="{StaticResource DynamicContentButton}" Click="CmdSave_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Save preferences." FontWeight="SemiBold"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
