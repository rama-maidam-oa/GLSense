<views:BaseWindow x:Class="GLSense.Addin.Core.Views.GLJobsMonitor"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:views="clr-namespace:GLSense.Addin.Core.Views"
                  xmlns:ctrls="clr-namespace:GLSense.Addin.Core.Controls"
                  xmlns:conv="clr-namespace:GLSense.Addin.Core.Converters"
                  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
                  mc:Ignorable="d"
                  WindowCaption="GLSense Processed Jobs"
                  IconSymbol="ClipboardListSolid"
                  SizeToContent="WidthAndHeight"
                  MinWidth="800" MaxWidth="900"
                  MinHeight="700" MaxHeight="850"
                  ResizeMode="CanResize"
                  WindowStyle="SingleBorderWindow"
                  ExtendsContentIntoTitleBar="True"
                  Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GLSense.Addin.Core;component/Themes/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters (window-specific) -->
            <conv:WidthPercentageConverter x:Key="WidthPercentageConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0"
              Style="{StaticResource TitleBarGridStyle}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <iconPacks:PackIconFontAwesome Grid.Column="0"
                           Style="{StaticResource TitleBarIconStyle}"
                           Kind="{Binding IconSymbol, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"/>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource TitleBarTextStyle}"
                       Text="{Binding WindowCaption, RelativeSource={RelativeSource AncestorType=views:BaseWindow}}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="2"
                    x:Name="CloseButton"
                    Style="{StaticResource TitleBarCloseButtonStyle}"
                    Content="&#xE8BB;"
                    Click="BtnClose_Click"/>
        </Grid>

        <!-- ================= Search Controls Section ================= -->
        <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" CornerRadius="8" Margin="10,10,10,8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search:" Style="{StaticResource HeaderTextBlock}" Margin="0,0,8,0"/>
                </StackPanel>

                <!-- Search ComboBox -->
                <ctrls:SuggestAppendComboBox x:Name="cmbSearchType" Grid.Column="1" Width="Auto" MinWidth="200" Height="30" Margin="8,0,8,0"
                                              ItemsSource="{Binding SearchTypes}" DisplayMemberPath="DisplayName"
                                              SelectedItem="{Binding SelectedSearchType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Background="{StaticResource WhiteBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                              BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}"/>

                <!-- Search TextBox -->
                <TextBox x:Name="txtSearch" Grid.Column="2" Height="30" Style="{StaticResource ModernTextBox}"
                         Margin="0,0,8,0" HorizontalAlignment="Stretch" MinWidth="280"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock Text="Enter text to filter jobs list" TextWrapping="Wrap"/>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>

                <!-- Refresh Button -->
                <Button x:Name="btnRefresh" Grid.Column="3" Style="{StaticResource DynamicContentButton}"
                        Content="Refresh" Padding="12,0" Click="BtnRefresh_Click">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock Text="Refresh the jobs list with latest status" TextWrapping="Wrap"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
            </Grid>
        </Border>

        <!-- ================= Main Content: Jobs DataGrid ================= -->
        <!-- MinHeight added (matches the AttachmentsDialog/GLSegmentValues fix): a bare
             "*" row collapses toward 0 during SizeToContent's infinite-availSize
             measurement pass, which is the same root cause behind the "rows collapsed"
             symptom seen on other SizeToContent windows. MinHeight stops that
             pathological first-pass collapse while still letting the grid grow/scroll
             normally. -->
        <Border Grid.Row="2" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,8" MinHeight="300">
            <DataGrid x:Name="dgJobs"
                      ItemsSource="{Binding JobsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeColumns="True"
                      Background="{StaticResource WhiteBrush}"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Loaded="DgJobs_Loaded">

                <!-- Override system selection colors -->
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>

                    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                        <Setter Property="Background" Value="#E0E0E0"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Style>

                    <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                        <Setter Property="Background" Value="#6C757D"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2E86AB"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="#1B6B93"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="FontSize" Value="12"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- RowStyle with consistent hover/selected/checkbox-selected formatting -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#F8F9FA"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#212529"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Height" Value="36"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DgJobsRow_PreviewMouseLeftButtonDown"/>
                        <Style.Triggers>
                            <!-- Checkbox selected state -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#FFF8E1"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F8FF"/>
                                <Setter Property="BorderBrush" Value="#2E86AB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#9bcee4"/>
                                <Setter Property="BorderBrush" Value="#2E86AB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{Binding Foreground,
                            RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Checkbox column -->
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="chkSelectAll"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Checked="ChkSelectAll_Checked"
                                      Unchecked="ChkSelectAll_Unchecked"
                                      Style="{StaticResource ModernCheckBox}">
                                <CheckBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <TextBlock Text="Select/Deselect all jobs in the list" TextWrapping="Wrap"/>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="chkSelectJob"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ModernCheckBox}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="Select this job for batch operations (delete/download)" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Process ID -->
                    <DataGridTextColumn Header="Process ID"
                        IsReadOnly="True"
                        Binding="{Binding ProcessId}"
                        Width="1.2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="{Binding ProcessId}"/>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Name -->
                    <DataGridTextColumn Header="Name"
                                        IsReadOnly="True"
                                        Binding="{Binding Name}"
                                        Width="3*"
                                        MinWidth="230">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Job Type -->
                    <DataGridTextColumn Header="Type"
                            IsReadOnly="True"
                            Binding="{Binding JobType}"
                            Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Phase -->
                    <DataGridTextColumn Header="Phase"
                            IsReadOnly="True"
                            Binding="{Binding Phase}"
                            Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                <Setter Property="Foreground" Value="{Binding PhaseColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status -->
                    <DataGridTextColumn Header="Status"
                            IsReadOnly="True"
                            Binding="{Binding Status}"
                            Width="1.5*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}">
                                <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Date -->
                    <DataGridTextColumn Header="Date"
                            IsReadOnly="True"
                            Binding="{Binding DisplayDate}"
                            Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModernDataGridText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Download Icon -->
                    <DataGridTemplateColumn Header="Download" Width="1.1*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <iconPacks:PackIconFontAwesome Kind="{Binding DownloadIconKind}"
                                           Width="16"
                                           Height="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding DownloadIconColor}">
                                    <iconPacks:PackIconFontAwesome.ToolTip>
                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                            <TextBlock Text="{Binding DownloadTooltip}" TextWrapping="Wrap"/>
                                        </ToolTip>
                                    </iconPacks:PackIconFontAwesome.ToolTip>
                                </iconPacks:PackIconFontAwesome>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Actions -->
        <Border Grid.Row="3" Background="{StaticResource WhiteBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderLightBrush}" Margin="10,0,10,10" Padding="16">
            <Grid>
                <!-- Left Side: Delete Buttons -->
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button x:Name="btnDelete" Content="Delete" Style="{StaticResource DynamicContentButton}" Margin="0,0,8,0"
                            Click="BtnDelete_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Delete selected jobs from the system" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnDeleteAll" Content="Delete All" Style="{StaticResource DynamicContentButton}"
                            Click="BtnDeleteAll_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Delete all jobs from the system (use with caution)" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>

                <!-- Right Side: Download + Close -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="btnDownloadLogs" Content="Download Logs" Style="{StaticResource DynamicContentButton}" Margin="0,0,8,0"
                         Click="BtnDownloadLogs_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Download execution logs for selected jobs" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnDownloadOutputs" Content="Download Output(s)" Style="{StaticResource DynamicContentButton}" Margin="0,0,8,0"
                           Click="BtnDownloadOutputs_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Download output files/results from selected jobs" TextWrapping="Wrap"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}"
                    Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.RowSpan="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</views:BaseWindow>
