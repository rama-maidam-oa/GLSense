        private void UpdateEndPeriods()
        {
            EndPeriods.Clear();
            if (SelectedPeriod != null)
            {
                var nextPeriods = Periods.SkipWhile(p => p.PeriodName != SelectedPeriod.PeriodName).Skip(1);
                foreach (var p in nextPeriods)
                {
                    EndPeriods.Add(p);
                }
            }
        }

