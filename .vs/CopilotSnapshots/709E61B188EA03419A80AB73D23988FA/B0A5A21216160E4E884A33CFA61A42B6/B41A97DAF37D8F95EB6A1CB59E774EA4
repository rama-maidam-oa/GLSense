<utils:DpiAwareWindow x:Class="GLSense.Views.GLDailyRates" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:sys="clr-namespace:System;assembly=mscorlib" 
					  xmlns:local="clr-namespace:GLSense.Views" 
					  xmlns:utils="clr-namespace:GLSense.Utilities" 
					  xmlns:ctrls="clr-namespace:GLSense.Controls" 
					  xmlns:conv="clr-namespace:GLSense.Converters" 
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
					  WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" SizeToContent="WidthAndHeight" 
					  MinWidth="600" MaxWidth="700" MinHeight="320" MaxHeight="420" Background="#F8F9FA">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Define consistent widths for labels and controls - EXACTLY like GLGetPeriod -->
            <sys:Double x:Key="LabelMinWidth">130</sys:Double>
            <sys:Double x:Key="ControlHeight">32</sys:Double>
            <Thickness x:Key="ControlMargin">6,0</Thickness>
            <Thickness x:Key="LabelMargin">0,0,6,0</Thickness>
            <sys:Double x:Key="RefEditMinWidth">200</sys:Double>
            <!-- Converters (window-specific) -->
            <conv:NullableDateConverter x:Key="NullableDateConverter"/>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- For labels -->
            <ColumnDefinition Width="*"/>
            <!-- For combo boxes / text boxes -->
            <ColumnDefinition Width="Auto"/>
            <!-- For ref edit controls -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="MoneyCheckDollarSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock x:Name="TxtFuncName" Text="GLSense Daily Rates" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>
        <!-- ================= Main Content ================= -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= From Currency ================= -->
            <Border Grid.Row="0" Style="{StaticResource CompactBorderStyle}" Margin="0,10,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Currency From :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                    <ctrls:SuggestAppendComboBox x:Name="cmbFromCurrency" Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding Currencies}" SelectedItem="{Binding FromCurrencyField.ComboValue, Mode=TwoWay}" Text="{Binding FromCurrencyField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" IsEnabled="{Binding FromCurrencyField.IsComboEnabled}"/>
                    <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding FromCurrencyField.RefValue, Mode=TwoWay}" TagName="Daily Rate From Currency Field" Margin="0,0,0,0" IsEnabled="{Binding FromCurrencyField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ================= Scrollable Content ================= -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,2">
                <StackPanel>
                <!-- ================= To Currency ================= -->
                <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Currency To :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <ctrls:SuggestAppendComboBox x:Name="cmbToCurrency" Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding Currencies}" SelectedItem="{Binding ToCurrencyField.ComboValue, Mode=TwoWay}" Text="{Binding ToCurrencyField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" IsEnabled="{Binding ToCurrencyField.IsComboEnabled}"/>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding ToCurrencyField.RefValue, Mode=TwoWay}" TagName="Daily Rate To Currency Field" Margin="0,0,0,0" IsEnabled="{Binding ToCurrencyField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- ================= Conversion Types ================= -->
                <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Conversion Type :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtConversion" Grid.Column="1" Height="{StaticResource ControlHeight}" Text="{Binding ConversionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <StackPanel>
                                        <TextBlock Text="Enter the desired conversion type" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                        <ContentControl Grid.Column="2" Width="{StaticResource RefEditMinWidth}" Visibility="Hidden"/>
                    </Grid>
                </Border>
                <!-- ================= Conversion date as on ================= -->
                <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Currency Date :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <DatePicker x:Name="dtpDate" Grid.Column="1" Height="{StaticResource ControlHeight}" VerticalAlignment="Center" SelectedDateFormat="Short" SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=False, NotifyOnValidationError=True}" IsEnabled="{Binding DateField.IsComboEnabled}" Margin="{StaticResource ControlMargin}" BorderThickness="0.5" BorderBrush="Gray" Background="White" SelectedDateChanged="DtpDate_SelectedDateChanged">
                            <DatePicker.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Select a desired date by clicking the calendar icon"/>
                                </ToolTip>
                            </DatePicker.ToolTip>
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DatePickerTextBox">
                                                <TextBox x:Name="TextBox" Height="{StaticResource ControlHeight}" BorderBrush="White" Text="{Binding Path=SelectedDate, 
                                                                RelativeSource={RelativeSource AncestorType=DatePicker},
                                                                Converter={StaticResource NullableDateConverter},
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                        <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding DateField.RefValue, Mode=TwoWay}" TagName="Daily Rate Currency Date Field" Margin="0,0,0,0" IsEnabled="{Binding DateField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- ================= Cell Reference ================= -->
                <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Reference :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                        <local:ExcelRefEditControl x:Name="CellReference" Grid.Column="1" Grid.ColumnSpan="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TagName="Daily Rate Cell Reference" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Action Buttons ================= -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent" Margin="0,2,0,0" Padding="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSubmit" Style="{StaticResource InsertButtonStyle}" Click="BtnSubmit_Click" Margin="0,0,8,0">

                </Button>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>