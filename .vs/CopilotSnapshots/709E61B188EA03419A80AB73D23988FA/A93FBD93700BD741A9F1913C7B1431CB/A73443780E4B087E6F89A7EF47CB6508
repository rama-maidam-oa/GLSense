<utils:DpiAwareWindow x:Class="GLSense.Views.GLCubeDetails" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:local="clr-namespace:GLSense.Views" 
					  xmlns:utils="clr-namespace:GLSense.Utilities" 
					  xmlns:ctrls="clr-namespace:GLSense.Controls" 
					  xmlns:conv="clr-namespace:GLSense.Converters" 
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
					  Background="#F8F9FA" SizeToContent="WidthAndHeight" MinWidth="750" MaxWidth="850" MinHeight="500" MaxHeight="650" 
					  WindowStyle="None" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters (window-specific) -->
            <conv:WidthPercentageConverter x:Key="WidthPercentageConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="CubesSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock Text="GLSense Cube Details" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>
        <!-- ================= Main Content: Controls + Cube DataGrid ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- ================= Controls Section ================= -->
                <Border Background="White" CornerRadius="8" Margin="0,0,0,4" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Cube Selection Label -->
                        <Label Grid.Column="0" Content="Cubes:" Foreground="#2E86AB" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Cube Selection ComboBox -->
                        <ctrls:SuggestAppendComboBox x:Name="cmbCubes" Grid.Column="1" Width="Auto" MinWidth="200" MaxWidth="500" Height="30" VerticalAlignment="Center" HorizontalAlignment="Stretch" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" BorderThickness="1" BorderBrush="#E9ECEF" Margin="0,0,10,0">
                            <ctrls:SuggestAppendComboBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <TextBlock Text="Select a cube to view its details" TextWrapping="Wrap"/>
                                </ToolTip>
                            </ctrls:SuggestAppendComboBox.ToolTip>
                        </ctrls:SuggestAppendComboBox>
                        <CheckBox x:Name="chkValidateCube" Grid.Column="2" Content="Validate Cube" VerticalAlignment="Center" Margin="0,0,25,0" Style="{StaticResource CompactCheckBox}" Checked="ChkValidateCube_Changed" Unchecked="ChkValidateCube_Changed"/>
                        <Button x:Name="btnValidateCube" Grid.Column="3" Content="Validate" MinWidth="100" Style="{StaticResource DynamicContentButton}" Click="BtnValidateCube_Click"/>
                    </Grid>
                </Border>
                <!-- ================= Main Content: Cube DataGrid ================= -->
                <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E9ECEF" Margin="0,0,0,4">
                    <DataGrid x:Name="dgCubes" FontFamily="Segoe UI" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" BorderThickness="0" GridLinesVisibility="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <!-- Override system selection colors and use local scroll styles -->
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#212529"/>
                            <!-- local scrollbar styles scoped to this DataGrid (ensure visible, consistent look) -->
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}">
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Style>
                            <Style TargetType="Thumb" BasedOn="{StaticResource AppScrollThumbStyle}">
                                <Setter Property="Background" Value="#6C757D"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2E86AB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderBrush" Value="#1B6B93"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Height" Value="38"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <!-- PRODUCTION Row Style -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#F8F9FA"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#212529"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Height" Value="36"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F8FF"/>
                                        <Setter Property="BorderBrush" Value="#2E86AB"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#9bcee4"/>
                                        <Setter Property="BorderBrush" Value="#2E86AB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <!-- CellStyle with Transparent background (CRITICAL FIX) -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{Binding Foreground, 
                                        RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <!-- Your columns remain the same -->
                            <DataGridTemplateColumn Header="" Width="42">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <iconPacks:PackIconFontAwesome Kind="TriangleExclamationSolid" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="DarkOrange" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <iconPacks:PackIconFontAwesome.ToolTip>
                                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                    <StackPanel>
                                                        <TextBlock Text="⚠ Warning" FontWeight="SemiBold" Foreground="DarkOrange"/>
                                                        <TextBlock Text="This cube has validation warnings" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </iconPacks:PackIconFontAwesome.ToolTip>
                                        </iconPacks:PackIconFontAwesome>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Ledger Name as TemplateColumn -->
                            <DataGridTemplateColumn Header="Ledger Name" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LedgerName}" Padding="12,8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                    <TextBlock Text="{Binding LedgerName}" TextWrapping="Wrap"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                    </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Last Refreshed Date as TemplateColumn -->
                            <DataGridTemplateColumn Header="Last Refreshed Date" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastRefreshedDate}" Padding="12,8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                    <TextBlock Text="{Binding LastRefreshedDate}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                    </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Time Zone as TemplateColumn -->
                            <DataGridTemplateColumn Header="Time Zone" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeZone}" Padding="12,8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <TextBlock.ToolTip>
                                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                    <TextBlock Text="{Binding TimeZone}"/>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                    </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <!-- ================= Footer Actions ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E9ECEF" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Status Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" x:Name="statusPanel">
                    <Border Background="#E3F2FD" CornerRadius="4" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFontAwesome Kind="InfoSolid" x:Name="statusIcon" Width="14" Height="14" VerticalAlignment="Center" Foreground="#2E86AB"/>
                            <TextBlock x:Name="lblCubeStatus" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#2E86AB"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnOK" Style="{StaticResource DynamicContentButton}" Content="Ok" Margin="0,0,8,0" Click="BtnOK_Click">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <TextBlock Text="Accept and close"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" Margin="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>