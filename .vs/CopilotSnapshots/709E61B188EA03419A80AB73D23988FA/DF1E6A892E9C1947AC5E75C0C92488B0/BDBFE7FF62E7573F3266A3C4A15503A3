<utils:DpiAwareWindow x:Class="GLSense.Views.GLSegmentFunctions" 
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
					  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
					  xmlns:sys="clr-namespace:System;assembly=mscorlib" 
					  xmlns:utils="clr-namespace:GLSense.Utilities" 
					  xmlns:local="clr-namespace:GLSense.Views" 
					  xmlns:ctrls="clr-namespace:GLSense.Controls" 
					  xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
					  WindowStyle="None" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" SizeToContent="WidthAndHeight" 
					  MinHeight="300" MaxHeight="550" MinWidth="600" MaxWidth="700" Background="#F8F9FA">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Define consistent widths for labels and controls -->
            <sys:Double x:Key="LabelMinWidth">120</sys:Double>
            <sys:Double x:Key="ControlHeight">32</sys:Double>
            <Thickness x:Key="ControlMargin">6,0</Thickness>
            <Thickness x:Key="LabelMargin">0,0,6,0</Thickness>
            <sys:Double x:Key="RefEditMinWidth">200</sys:Double>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Grid Margin="10">
        <!-- FIXED GRID STRUCTURE -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- For labels -->
            <ColumnDefinition Width="*"/>
            <!-- For combo boxes -->
            <ColumnDefinition Width="Auto"/>
            <!-- For ref edit controls -->
        </Grid.ColumnDefinitions>
        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="SlidersSolid" Style="{StaticResource LargeIcon}"/>
                    <TextBlock x:Name="TxtFuncName" Text="Get Segment" Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnClose_Click"/>
            </Grid>
        </Border>
        <!-- ================= Ledger Selection ================= -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,5,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Ledger :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                <ctrls:SuggestAppendComboBox x:Name="cmbLedgers" Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding Ledgers}" DisplayMemberPath="LedgerName" SelectedItem="{Binding LedgerField.ComboValue, Mode=TwoWay}" Text="{Binding LedgerField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529" IsEnabled="{Binding LedgerField.IsComboEnabled}"/>
                <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding LedgerField.RefValue, Mode=TwoWay}" TagName="Periods Ledgers Field" Margin="0,0,0,0" IsEnabled="{Binding LedgerField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- ================= Segment Name ================= -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,5,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Segment Name :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                <ctrls:SuggestAppendComboBox Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding Segments}" DisplayMemberPath="SegmentName" SelectedItem="{Binding SegmentField.ComboValue, Mode=TwoWay}" Text="{Binding SegmentField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center" IsEnabled="{Binding SegmentField.IsComboEnabled}"/>
                <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding SegmentField.RefValue, Mode=TwoWay}" IsEnabled="{Binding SegmentField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- ================= Segment Values ================= -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Segment Values :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                <ctrls:SuggestAppendComboBox Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding SegmentValues}" DisplayMemberPath="SegmentValue" SelectedItem="{Binding SegmentValueField.ComboValue, Mode=TwoWay}" Text="{Binding SegmentValueField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center" IsEnabled="{Binding SegmentValueField.IsComboEnabled}"/>
                <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding SegmentValueField.RefValue, Mode=TwoWay}" IsEnabled="{Binding SegmentValueField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- ================= Parent / Child ================= -->
        <Border x:Name="ParentChildSection" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Empty label for alignment -->
                <Label Grid.Column="0" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" Visibility="Hidden"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource ControlMargin}" HorizontalAlignment="Left">
                    <CheckBox x:Name="ChkIncludeParent" Content="Next Parent" Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsParentChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,20,0">
                        <CheckBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Gets the immediate next parent value in the hierarchy" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="✓ Checked: Returns immediate parent" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                                <TextBlock Text="✗ Unchecked: Returns segment itself (default)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <CheckBox x:Name="ChkIncludeChild" Content="Next Child" Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsChildChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center">
                        <CheckBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Gets the immediate next child value in the hierarchy" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="✓ Checked: Returns immediate child" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                                <TextBlock Text="✗ Unchecked: Returns segment itself (default)" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ================= Attributes ================= -->
        <Border x:Name="AttributesSection" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Attributes :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                <ctrls:SuggestAppendComboBox x:Name="cmbAttributes" Grid.Column="1" Height="{StaticResource ControlHeight}" ItemsSource="{Binding AttributeTypes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding AttributeField.ComboValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Text="{Binding AttributeField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AttributeField.IsComboEnabled}" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}" ArrowBrush="#2E86AB" ArrowWidth="10" ArrowHeight="8" Background="White" Foreground="#212529"/>
                <local:ExcelRefEditControl Grid.Column="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding AttributeField.RefValue, Mode=TwoWay}" TagName="Segments Attribute Field" IsEnabled="{Binding AttributeField.IsRefEnabled}" MinWidth="{StaticResource RefEditMinWidth}" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- ================= Result ================= -->
        <Border x:Name="ResultSection" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Result :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                <TextBox x:Name="txtResult" Grid.Column="1" Style="{StaticResource ReadOnlyTextBox}" Height="{StaticResource ControlHeight}" Text="{Binding ResultText, Mode=OneWay}" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center">
                    <TextBox.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <StackPanel>
                                <TextBlock Text="Displays the calculated result based on your selections" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
                <StackPanel x:Name="IncludeValuesSection" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <CheckBox x:Name="ChkIncludeSegmentValues" VerticalAlignment="Center" Content="Include Segment Values" IsChecked="{Binding IsParentValueChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernCheckBox}">
                        <CheckBox.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Includes segment description along with value in result" TextWrapping="Wrap"/>
                                    <Border Background="#FBB41A" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconFontAwesome Kind="LightbulbRegular" Width="12" Height="12" Foreground="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="✓ Checked: Returns '1000-Cash'" FontSize="11" FontStyle="Italic" Foreground="Black"/>
                                                <TextBlock Text="✗ Unchecked: Returns '1000'" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,2,0,0"/>
                                                <TextBlock Text="Example: For segment 1000 with description 'Cash'" FontSize="11" FontStyle="Italic" Foreground="Black" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </CheckBox.ToolTip>
                    </CheckBox>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ================= Cell Reference ================= -->
        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompactBorderStyle}" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Reference :" Style="{StaticResource HeaderLabel}" MinWidth="{StaticResource LabelMinWidth}" Margin="{StaticResource LabelMargin}" VerticalAlignment="Center"/>
                <local:ExcelRefEditControl x:Name="CellReference" Grid.Column="1" Grid.ColumnSpan="2" Height="{StaticResource ControlHeight}" Style="{StaticResource CompactRefEditControl}" Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TagName="Segments Cell Reference" Margin="{StaticResource ControlMargin}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- ================= Action Buttons Section ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="#E9ECEF" Grid.ColumnSpan="2" Padding="8,4" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnSubmit" Style="{StaticResource InsertButtonStyle}" Click="BtnSubmit_Click" Margin="0,0,8,0"/>
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
        <!-- ================= Overlay ================= -->
        <local:AppOverlay x:Name="AppOverlayControl" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="8" Panel.ZIndex="10" Visibility="Collapsed" DataContext="{x:Null}"/>
    </Grid>
</utils:DpiAwareWindow>