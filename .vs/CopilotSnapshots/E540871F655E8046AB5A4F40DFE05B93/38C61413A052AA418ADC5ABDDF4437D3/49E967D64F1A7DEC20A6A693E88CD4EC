<utils:DpiAwareWindow x:Class="GLSense.Views.GLUserConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
        xmlns:local="clr-namespace:GLSense.Views"
        xmlns:ctrls="clr-namespace:GLSense.Controls"
        xmlns:utils="clr-namespace:GLSense.Utilities"
        xmlns:models="clr-namespace:GLSense.Models"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        MinHeight="320" MaxHeight="520"
        MinWidth="480" MaxWidth="580"
        ResizeMode="CanResize"
        Background="#F8F9FA">

    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </utils:DpiAwareWindow.Resources>

    <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1">

        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="UserGearSolid"
                                                        Style="{StaticResource LargeIcon}" />

                        <TextBlock Text="GLSense User Preferences"
                                   Style="{StaticResource TitleHeaderTextBlock}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CustomWindowCloseButtonStyle}"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- TAB CONTROL -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="0,8,0,8"
                        HorizontalContentAlignment="Left"
                        Style="{StaticResource ModernTabControl}"
                        ItemContainerStyle="{StaticResource TabItemStyle}"
                        SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="DrillDowns">
                    <Border Style="{StaticResource CompactCardStyle}" Padding="6" Margin="0,4,0,0">

                        <DataGrid x:Name="dgDrillDowns"
                                  FontFamily="Segoe UI"  AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column" Background="White" BorderThickness="0"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="DrillDowns"
                                                    Binding="{Binding Name}"
                                                    Width="*"
                                                    IsReadOnly="True"
                                                    ElementStyle="{StaticResource ModernDataGridTextBlock}"/>

                                <DataGridTemplateColumn Header="Run as Job" Width="110" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding RunAsJob, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanEditRunAsJob}"
                                                      Style="{StaticResource ModernDataGridCheckBoxColumn}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Real Time Data" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding RealTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanEditRealTime}"
                                                      Style="{StaticResource ModernDataGridCheckBoxColumn}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>
                </TabItem>

                <TabItem Header="Options">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <StackPanel Margin="4">

                            <!-- Consolidated Options Card -->
                            <Border Style="{StaticResource CompactCardStyle}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 1.) No Data/Missing Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="No Data/Missing :"
                               Style="{StaticResource TextBlockLabelStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                                         <ctrls:SuggestAppendComboBox x:Name="CmbOptions"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="8,0,0,0"
                                                  Foreground="Black"
                                                  DisplayMemberPath="Value"
                                                  Loaded="CmbOptions_Loaded"/>
                                    </Grid>

                                    <!-- 2.) Refresh Cells Row -->
                                    <Grid Grid.Row="1" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Range Cells :"
                                                       Style="{StaticResource TextBlockLabelStyle}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border Width="16" Height="16" Background="#DC3545" CornerRadius="8" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <iconPacks:PackIconFontAwesome Kind="CircleInfoSolid"
                                                                               Width="10"
                                                                               Height="10"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                    <iconPacks:PackIconFontAwesome.ToolTip>
                                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                            <TextBlock Text="Minimum 1, maximum 100. Values above 100 are capped at 100." TextWrapping="Wrap" MaxWidth="260"/>
                                                        </ToolTip>
                                                    </iconPacks:PackIconFontAwesome.ToolTip>
                                                </iconPacks:PackIconFontAwesome>
                                            </Border>
                                        </StackPanel>

                                        <ctrls:NumericSpinner x:Name="SpinnerRefreshCells"
                              Grid.Column="1"
                              Minimum="1"
                              Maximum="100"
                               HintText="Minimum 1, maximum 100. Values above 100 are capped at 100."
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Height="28"
                              Margin="8,0,0,0"
                              ValueChanged="SpinnerRefreshCells_ValueChanged"/>
                                    </Grid>

                                    <!-- 3.) Records per page Row -->
                                    <Grid Grid.Row="2" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Records per page :"
                                                       Style="{StaticResource TextBlockLabelStyle}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Border Width="16" Height="16" Background="#DC3545" CornerRadius="8" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <iconPacks:PackIconFontAwesome Kind="CircleInfoSolid"
                                                                               Width="10"
                                                                               Height="10"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                    <iconPacks:PackIconFontAwesome.ToolTip>
                                                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                            <TextBlock Text="Minimum 1, maximum 1000. Values above 1000 are capped at 1000." TextWrapping="Wrap" MaxWidth="260"/>
                                                        </ToolTip>
                                                    </iconPacks:PackIconFontAwesome.ToolTip>
                                                </iconPacks:PackIconFontAwesome>
                                            </Border>
                                        </StackPanel>

                                        <ctrls:NumericSpinner x:Name="SpinnerRecordsPerPage"
                              Grid.Column="1"
                              Minimum="1"
                              Maximum="1000"
                               HintText="Minimum 1, maximum 1000. Values above 1000 are capped at 1000."
                              Step="10"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              Height="28"                                
                              ValueChanged="SpinnerRecordsPerPage_ValueChanged"/>
                                    </Grid>

                                    <!-- 4.) Validate Cube Checkbox - Left aligned -->
                                    <CheckBox x:Name="ChkValidateCube"
                                          Grid.Row="3"
                                          Content="Validate Cube"
                                          Style="{StaticResource CompactCheckBox}"
                                          Margin="0,10,0,12"
                                          HorizontalAlignment="Left"
                                          Checked="ChkValidateCube_Checked"
                                          Unchecked="ChkValidateCube_Unchecked" >
                                        <CheckBox.ToolTip>
                                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="When enabled, cube validation will be performed while selecting the cube." FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="300"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </CheckBox.ToolTip>
                                    </CheckBox>

                                    <!-- 5.) Suppress zeroes Checkbox - Left aligned -->
                                    <CheckBox x:Name="ChkZeroes"
                              Grid.Row="4"
                              Content="Suppress zeroes in Balance Drilldown"
                              Style="{StaticResource CompactCheckBox}"
                              Margin="0,0,0,0"
                              HorizontalAlignment="Left"
                              Checked="ChkZeroes_Checked"
                              Unchecked="ChkZeroes_Unchecked"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- BUTTONS -->
            <Border Grid.Row="2" Style="{StaticResource CompactCardStyle}" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- RESET BUTTON - Left aligned -->
                    <Button Grid.Column="0"
                        Content="Reset" Style="{StaticResource DynamicContentButton}" Click="CmdReset_Click" >
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                <StackPanel>
                                    <TextBlock Text="Reset all preferences to default values." FontWeight="SemiBold"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <!-- spacer -->
                    <Grid Grid.Column="1" />

                    <!-- SAVE and CLOSE BUTTONS - Right aligned -->
                    <StackPanel Grid.Column="2" 
                    Orientation="Horizontal">
                        <Button Content="Save" Margin="0,0,8,0" Style="{StaticResource DynamicContentButton}"
                         Click="CmdSave_Click" >
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <StackPanel>
                                        <TextBlock Text="Save preferences." FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}"
                    Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Toast / Busy overlay -->
            <local:AppOverlay x:Name="AppOverlayControl"
                              Grid.Row="0"
                              Grid.ColumnSpan="2"
                              Grid.RowSpan="3"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="Collapsed"
                              DataContext="{x:Null}"
                              Panel.ZIndex="10"/>
        </Grid>

    </Border>
</utils:DpiAwareWindow>