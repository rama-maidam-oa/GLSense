using System;
using System.Runtime.InteropServices;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Interop;
using System.Windows.Media;
using System.Collections.Generic;

namespace GLSense.Utilities
{
    using System;

    public class DpiAwareWindow : Window
    {
        private HwndSource _hwndSource;
        private double _currentScaleFactor = 1.0;
        private readonly string _windowName;
        private FrameworkElement _adaptiveScaleTarget;
        private Grid _adaptiveShell;

        public double CurrentScaleFactor => _currentScaleFactor;
        public bool AutoClampToWorkArea { get; set; } = true;
        public double WorkAreaMargin { get; set; } = 24d;
        public double? MaxWidthCap { get; set; } = 1400d;
        public double? MaxHeightCap { get; set; }
            = null;

        public DpiAwareWindow()
        {
            try
            {
                _windowName = GetType().Name;
                LogUtility.LogDebug($"[{_windowName}] constructing window");

                // Ensure WPF Application exists
                WpfAppManager.EnsureApplication();

                // Initialize on the WPF thread
                WpfAppManager.InvokeOnWpfThread(() =>
                {
                    try
                    {
                        using (DpiAwarenessHelper.SetPerMonitorAware())
                        {
                            // Suppress flickering for borderless windows with SizeToContent
                            this.UseLayoutRounding = true;
                            this.SnapsToDevicePixels = true;

                            // Set render mode to software to avoid GPU compositing artifacts
                            RenderOptions.SetBitmapScalingMode(this, BitmapScalingMode.HighQuality);

                            this.SourceInitialized += OnSourceInitialized;
                            this.Loaded += OnLoaded;
                            this.ContentRendered += OnContentRenderedDebug;
                            this.Closed += OnClosedDebug;
                            this.Unloaded += OnUnloadedDebug;
                        }
                    }
                    catch (Exception ex)
                    {
                        LogUtility.LogError($"Error in DpiAwareWindow constructor: {ex.Message}");
                    }
                });
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Fatal error in DpiAwareWindow: {ex.Message}");
            }
        }

        protected override void OnInitialized(EventArgs e)
        {
            try
            {
                LogUtility.LogDebug($"[{_windowName}] initialized");
                base.OnInitialized(e);
            }
            catch (System.IO.IOException ex)
            {
                LogUtility.LogError($"IO Exception during window initialization: {ex.Message}");
                // Try to continue - the window might still work
            }
        }

        /// <summary>
        /// Helper method to set Excel as owner
        /// </summary>
        public void SetExcelOwner(IntPtr excelHwnd)
        {
            try
            {
                var helper = new WindowInteropHelper(this);
                helper.Owner = excelHwnd;
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error setting Excel owner: {ex.Message}");
            }
        }

        /// <summary>
        /// Show dialog with Excel as owner
        /// </summary>
        public bool? ShowDialogWithOwner(IntPtr excelHwnd)
        {
            try
            {
                SetExcelOwner(excelHwnd);
                return this.ShowDialog();
            }
            catch (System.IO.IOException ex)
            {
                LogUtility.LogError($"IO Exception showing dialog: {ex.Message}");
                // Retry once
                System.Threading.Thread.Sleep(100);
                SetExcelOwner(excelHwnd);
                return this.ShowDialog();
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error showing dialog: {ex.Message}");
                // Fallback - try to show as independent window
                try
                {
                    return this.ShowDialog();
                }
                catch (Exception innerEx)
                {
                    LogUtility.LogError($"Critical error showing dialog: {innerEx.Message}");
                    return null;
                }
            }
        }
        /// <summary>
        /// Show window with Excel as owner (modeless/non-modal)
        /// </summary>
        public void ShowWithOwner(IntPtr excelHwnd)
        {
            try
            {
                SetExcelOwner(excelHwnd);
                this.Show();
            }
            catch (System.IO.IOException ex)
            {
                LogUtility.LogError($"IO Exception showing window: {ex.Message}");
                // Retry once
                System.Threading.Thread.Sleep(100);
                SetExcelOwner(excelHwnd);
                this.Show();
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error showing window: {ex.Message}");

                // Fallback - try to show without owner
                try
                {
                    this.Show();
                }
                catch (Exception innerEx)
                {
                    LogUtility.LogError($"Critical error showing window: {innerEx.Message}");
                }
            }
        }

        private void OnSourceInitialized(object sender, EventArgs e)
        {
            try
            {
                LogUtility.LogDebug($"[{_windowName}] source initialized");
                _hwndSource = PresentationSource.FromVisual(this) as HwndSource;
                _hwndSource?.AddHook(WndProc);
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error in OnSourceInitialized: {ex.Message}");
            }
        }

        private void OnLoaded(object sender, RoutedEventArgs e)
        {
            try
            {
                LogUtility.LogDebug($"[{_windowName}] loaded - applying DPI adjustments");
                AdjustForCurrentDpi();
                EnsureFitsWorkArea();
                ApplyAdaptiveContentLayout();
                ApplyAdaptiveScale();
                LogUtility.LogDebug($"[{_windowName}] load complete");
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error in OnLoaded: {ex.Message}");
            }
        }

        private IntPtr WndProc(IntPtr hwnd, int msg, IntPtr wParam, IntPtr lParam, ref bool handled)
        {
            try
            {
                const int WM_DPICHANGED = 0x02E0;

                if (msg == WM_DPICHANGED)
                {
                    uint newDpi = (uint)wParam;
                    AdjustForDpiChange(newDpi, lParam);
                    handled = true;
                }
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error in WndProc: {ex.Message}");
            }

            return IntPtr.Zero;
        }

        private void AdjustForCurrentDpi()
        {
            if (_hwndSource == null) return;

            try
            {
                var monitorDpi = GetDpiForWindow(_hwndSource.Handle);
                var wpfDpi = 96.0 * _hwndSource.CompositionTarget.TransformToDevice.M11;
                var scaleFactor = monitorDpi / wpfDpi;

                ApplyScaleTransform(scaleFactor);
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error adjusting DPI: {ex.Message}");
            }
        }

        private void AdjustForDpiChange(uint newDpi, IntPtr lParam)
        {
            if (_hwndSource == null) return;

            try
            {
                var wpfDpi = 96.0 * _hwndSource.CompositionTarget.TransformToDevice.M11;
                var scaleFactor = newDpi / wpfDpi;

                ApplyScaleTransform(scaleFactor);

                // Resize window according to the suggested rectangle
                if (lParam != IntPtr.Zero)
                {
                    var rect = Marshal.PtrToStructure<Rect>(lParam);

                    this.Dispatcher.BeginInvoke(new Action(() =>
                    {
                        try
                        {
                            this.Width = rect.Width;
                            this.Height = rect.Height;
                        }
                        catch (Exception ex)
                        {
                            LogUtility.LogError($"Error resizing window: {ex.Message}");
                        }
                    }));
                }
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error in AdjustForDpiChange: {ex.Message}");
            }
        }

        private void ApplyScaleTransform(double scaleFactor)
        {
            if (Math.Abs(scaleFactor - _currentScaleFactor) < 0.001)
                return;

            try
            {
                _currentScaleFactor = scaleFactor;

                if (this.Content is FrameworkElement element)
                {
                    element.LayoutTransform = new ScaleTransform(scaleFactor, scaleFactor);
                    element.InvalidateMeasure();
                }
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error applying scale transform: {ex.Message}");
            }
        }

        protected double DipToPixels(double dip)
        {
            return dip * _currentScaleFactor;
        }

        protected double PixelsToDip(double pixels)
        {
            return pixels / _currentScaleFactor;
        }

        [DllImport("user32.dll")]
        private static extern uint GetDpiForWindow(IntPtr hwnd);

        [StructLayout(LayoutKind.Sequential)]
        private struct Rect
        {
            public int Left;
            public int Top;
            public int Right;
            public int Bottom;
            public readonly int Width => Right - Left;
            public readonly int Height => Bottom - Top;
        }

        protected override void OnRenderSizeChanged(SizeChangedInfo sizeInfo)
        {
            base.OnRenderSizeChanged(sizeInfo);

            if (!AutoClampToWorkArea)
                return;

            try
            {
                EnsureFitsWorkArea();
                ApplyAdaptiveContentLayout();
                ApplyAdaptiveScale();
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error clamping window size: {ex.Message}");
            }
        }

        protected void EnsureFitsWorkArea(double? marginOverride = null)
        {
            var margin = marginOverride ?? WorkAreaMargin;
            try
            {
                var workArea = SystemParameters.WorkArea;

                var baseMaxWidth = Math.Max(0, workArea.Width - margin);
                var baseMaxHeight = Math.Max(0, workArea.Height - margin);

                if (MaxWidthCap.HasValue)
                {
                    baseMaxWidth = Math.Min(baseMaxWidth, MaxWidthCap.Value);
                }

                if (MaxHeightCap.HasValue)
                {
                    baseMaxHeight = Math.Min(baseMaxHeight, MaxHeightCap.Value);
                }

                var effectiveMaxWidth = double.IsPositiveInfinity(MaxWidth)
                    ? baseMaxWidth
                    : Math.Min(MaxWidth, baseMaxWidth);

                var effectiveMaxHeight = double.IsPositiveInfinity(MaxHeight)
                    ? baseMaxHeight
                    : Math.Min(MaxHeight, baseMaxHeight);

                MaxWidth = effectiveMaxWidth;
                MaxHeight = effectiveMaxHeight;

                if (MinWidth > effectiveMaxWidth)
                {
                    MinWidth = effectiveMaxWidth;
                }

                if (MinHeight > effectiveMaxHeight)
                {
                    MinHeight = effectiveMaxHeight;
                }

                if (Width > effectiveMaxWidth)
                {
                    Width = effectiveMaxWidth;
                }
                else if (Width < MinWidth)
                {
                    Width = MinWidth;
                }

                if (Height > effectiveMaxHeight)
                {
                    Height = effectiveMaxHeight;
                }
                else if (Height < MinHeight)
                {
                    Height = MinHeight;
                }
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error ensuring window fits work area: {ex.Message}");
            }
        }

        private void ApplyAdaptiveContentLayout()
        {
            try
            {
                if (_adaptiveShell == null)
                {
                    var rootGrid = this.Content as Grid;
                    if (rootGrid != null && rootGrid.RowDefinitions.Count >= 3)
                    {
                        _adaptiveShell = BuildAdaptiveShell(rootGrid);
                        _adaptiveScaleTarget = _adaptiveShell;
                        this.Content = _adaptiveShell;
                    }
                    else
                    {
                        _adaptiveScaleTarget = this.Content as FrameworkElement;
                    }
                }
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error applying adaptive content layout: {ex.Message}");
            }
        }

        private Grid BuildAdaptiveShell(Grid rootGrid)
        {
            var shell = new Grid();
            shell.Margin = rootGrid.Margin;
            shell.Background = rootGrid.Background;
            shell.SnapsToDevicePixels = rootGrid.SnapsToDevicePixels;
            shell.UseLayoutRounding = rootGrid.UseLayoutRounding;
            shell.HorizontalAlignment = rootGrid.HorizontalAlignment;
            shell.VerticalAlignment = rootGrid.VerticalAlignment;

            shell.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
            shell.RowDefinitions.Add(new RowDefinition { Height = new GridLength(1, GridUnitType.Star) });
            shell.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });

            var headerHost = CreateSectionHost(rootGrid);
            var scrollViewer = new ScrollViewer
            {
                VerticalScrollBarVisibility = ScrollBarVisibility.Auto,
                HorizontalScrollBarVisibility = ScrollBarVisibility.Auto,
                CanContentScroll = false,
                Focusable = false
            };
            scrollViewer.Content = rootGrid;

            var footerHost = CreateSectionHost(rootGrid);

            var children = new List<UIElement>();
            foreach (UIElement child in rootGrid.Children)
            {
                children.Add(child);
            }

            int lastRow = rootGrid.RowDefinitions.Count - 1;
            for (int i = 0; i < children.Count; i++)
            {
                var child = children[i];
                int row = Grid.GetRow(child);
                int rowSpan = Grid.GetRowSpan(child);

                if (rowSpan >= rootGrid.RowDefinitions.Count)
                {
                    continue;
                }

                if (row == 0)
                {
                    rootGrid.Children.Remove(child);
                    Grid.SetRow(child, 0);
                    Grid.SetRowSpan(child, 1);
                    headerHost.Children.Add(child);
                }
                else if (row == lastRow)
                {
                    rootGrid.Children.Remove(child);
                    Grid.SetRow(child, 0);
                    Grid.SetRowSpan(child, 1);
                    footerHost.Children.Add(child);
                }
            }

            shell.Children.Add(headerHost);
            Grid.SetRow(headerHost, 0);

            shell.Children.Add(scrollViewer);
            Grid.SetRow(scrollViewer, 1);

            shell.Children.Add(footerHost);
            Grid.SetRow(footerHost, 2);

            foreach (UIElement child in children)
            {
                int rowSpan = Grid.GetRowSpan(child);
                if (rowSpan >= rootGrid.RowDefinitions.Count)
                {
                    rootGrid.Children.Remove(child);
                    Grid.SetRow(child, 0);
                    Grid.SetRowSpan(child, 3);
                    shell.Children.Add(child);
                    Panel.SetZIndex(child, 10);
                }
            }

            return shell;
        }

        private static Grid CreateSectionHost(Grid sourceGrid)
        {
            var host = new Grid();
            foreach (ColumnDefinition columnDefinition in sourceGrid.ColumnDefinitions)
            {
                host.ColumnDefinitions.Add(new ColumnDefinition
                {
                    Width = columnDefinition.Width,
                    MinWidth = columnDefinition.MinWidth,
                    MaxWidth = columnDefinition.MaxWidth,
                    SharedSizeGroup = columnDefinition.SharedSizeGroup
                });
            }

            return host;
        }

        private void ApplyAdaptiveScale()
        {
            try
            {
                var target = _adaptiveScaleTarget ?? this.Content as FrameworkElement;
                if (target == null)
                {
                    return;
                }

                var workArea = SystemParameters.WorkArea;
                var availableWidth = Math.Max(0, workArea.Width - WorkAreaMargin);
                var availableHeight = Math.Max(0, workArea.Height - WorkAreaMargin);

                target.Measure(new Size(double.PositiveInfinity, double.PositiveInfinity));

                var desiredWidth = target.DesiredSize.Width > 0 ? target.DesiredSize.Width : target.ActualWidth;
                var desiredHeight = target.DesiredSize.Height > 0 ? target.DesiredSize.Height : target.ActualHeight;

                if (desiredWidth <= 0 || desiredHeight <= 0)
                {
                    return;
                }

                var scaleWidth = availableWidth / desiredWidth;
                var scaleHeight = availableHeight / desiredHeight;
                var fitScale = Math.Min(scaleWidth, scaleHeight);

                if (double.IsNaN(fitScale) || double.IsInfinity(fitScale))
                {
                    fitScale = 1.0;
                }

                fitScale = Math.Min(1.0, fitScale);

                if (fitScale < 1.0)
                {
                    fitScale = Math.Max(0.85, fitScale);
                    target.LayoutTransform = new ScaleTransform(fitScale, fitScale);
                }
                else
                {
                    target.LayoutTransform = Transform.Identity;
                }
            }
            catch (Exception ex)
            {
                LogUtility.LogError($"Error applying adaptive scale: {ex.Message}");
            }
        }

