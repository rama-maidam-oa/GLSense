<utils:DpiAwareWindow x:Class="GLSense.Views.GLGetPeriodByDate" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:GLSense.Views" 
        xmlns:utils="clr-namespace:GLSense.Utilities"
        xmlns:conv="clr-namespace:GLSense.Converters" 
        xmlns:ctrls="clr-namespace:GLSense.Controls" 
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
        WindowStyle="None" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize" 
        SizeToContent="WidthAndHeight" 
        MinWidth="600" MaxWidth="700"
        MinHeight="280" MaxHeight="480"
        Background="#F8F9FA" >

    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Define consistent widths for labels and controls -->
            <sys:Double x:Key="LabelMinWidth">100</sys:Double>
            <sys:Double x:Key="ControlHeight">32</sys:Double>
            <Thickness x:Key="ControlMargin">6,0</Thickness>
            <Thickness x:Key="LabelMargin">0,0,6,0</Thickness>
            <sys:Double x:Key="RefEditMinWidth">200</sys:Double>

            <!-- Converters (window-specific) -->
            <conv:NullableDateConverter x:Key="NullableDateConverter"/>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- For labels -->
            <ColumnDefinition Width="*"/>
            <!-- For combo boxes -->
            <ColumnDefinition Width="Auto"/>
            <!-- For ref edit controls -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side with icon and title -->
                <StackPanel Grid.Column="0" 
           Orientation="Horizontal" 
           VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="CalendarDaysSolid" 
                 Style="{StaticResource LargeIcon}" />
                    <TextBlock Text="Get Period by Date" 
                 Style="{StaticResource TitleHeaderTextBlock}"/>
                </StackPanel>

                <Button Grid.Column="2" 
             Style="{StaticResource CustomWindowCloseButtonStyle}" 
             Click="BtnClose_Click" />
            </Grid>
        </Border>

        <!-- ================= Ledger Selection ================= -->
        <Border Grid.Row="1" 
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CompactBorderStyle}"
                Margin="0,5,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="Ledger :"
                       Style="{StaticResource HeaderLabel}"
                       MinWidth="{StaticResource LabelMinWidth}"
                       Margin="{StaticResource LabelMargin}"
                       VerticalAlignment="Center"/>

                <ctrls:SuggestAppendComboBox x:Name="cmbLedgers" 
                                             Grid.Column="1"
                                             Height="{StaticResource ControlHeight}"
                                             ItemsSource="{Binding Ledgers}" 
                                             DisplayMemberPath="LedgerName" 
                                             SelectedItem="{Binding LedgerField.ComboValue, Mode=TwoWay}" 
                                             Text="{Binding LedgerField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             Margin="{StaticResource ControlMargin}"
                                             ArrowBrush="#2E86AB" 
                                             ArrowWidth="10" 
                                             ArrowHeight="8" 
                                             Background="White" 
                                             Foreground="#212529" 
                                             IsEnabled="{Binding LedgerField.IsComboEnabled}"/>

                <local:ExcelRefEditControl Grid.Column="2"
                                           Height="{StaticResource ControlHeight}"
                                           Style="{StaticResource CompactRefEditControl}" 
                                           Text="{Binding LedgerField.RefValue, Mode=TwoWay}" 
                                           TagName="Period By Date Ledgers Field" 
                                           Margin="0,0,0,0"
                                           IsEnabled="{Binding LedgerField.IsRefEnabled}" 
                                           MinWidth="{StaticResource RefEditMinWidth}"
                                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= Date Selection ================= -->
        <Border Grid.Row="2" 
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CompactBorderStyle}"
                Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="Date :"
                       Style="{StaticResource HeaderLabel}"
                       MinWidth="{StaticResource LabelMinWidth}"
                       Margin="{StaticResource LabelMargin}"
                       VerticalAlignment="Center"/>

                <!-- DatePicker with simple tooltip -->
                <DatePicker x:Name="dtpDate" 
                            Grid.Column="1"
                            Height="{StaticResource ControlHeight}" 
                            VerticalAlignment="Center" 
                            SelectedDateFormat="Short" 
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay,
                                   UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnExceptions=False,
                                   NotifyOnValidationError=True}" 
                            IsEnabled="{Binding DateField.IsComboEnabled}" 
                            Margin="{StaticResource ControlMargin}"
                            BorderThickness="1" 
                            BorderBrush="Gray" 
                            Background="White" 
                            SelectedDateChanged="DtpDate_SelectedDateChanged">
                    <DatePicker.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock Text="Select a desired date by clicking the calendar icon"/>
                        </ToolTip>
                    </DatePicker.ToolTip>

                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DatePickerTextBox">
                                        <TextBox x:Name="TextBox" 
                                                 Height="{StaticResource ControlHeight}"
                                                 BorderBrush="White" 
                                                 Text="{Binding Path=SelectedDate, 
                                                        RelativeSource={RelativeSource AncestorType=DatePicker},
                                                        Converter={StaticResource NullableDateConverter},
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=LostFocus}"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>

                <!-- ExcelRefEditControl for Date Field -->
                <local:ExcelRefEditControl Grid.Column="2"
                                           Height="{StaticResource ControlHeight}"
                                           Style="{StaticResource CompactRefEditControl}" 
                                           Text="{Binding DateField.RefValue, Mode=TwoWay}" 
                                           TagName="Period By Date Date Field" 
                                           Margin="0,0,0,0"
                                           IsEnabled="{Binding DateField.IsRefEnabled}" 
                                           MinWidth="{StaticResource RefEditMinWidth}"
                                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= Offset Selection ================= -->
        <Border Grid.Row="3" 
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CompactBorderStyle}"
                Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="Offset :"
                       Style="{StaticResource HeaderLabel}"
                       MinWidth="{StaticResource LabelMinWidth}"
                       Margin="{StaticResource LabelMargin}"
                       VerticalAlignment="Center"/>

                <ctrls:SuggestAppendComboBox x:Name="cmbOffset" 
                                             Grid.Column="1"
                                             Height="{StaticResource ControlHeight}"
                                             ItemsSource="{Binding OffsetValues}" 
                                             SelectedItem="{Binding OffsetField.ComboValue, Mode=TwoWay}" 
                                             Text="{Binding OffsetField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding OffsetField.IsComboEnabled}" 
                                             VerticalAlignment="Center"
                                             Margin="{StaticResource ControlMargin}"
                                             ArrowBrush="#2E86AB" 
                                             ArrowWidth="10" 
                                             ArrowHeight="8" 
                                             Background="White" 
                                             Foreground="#212529"/>

                <local:ExcelRefEditControl Grid.Column="2"
                                           Height="{StaticResource ControlHeight}"
                                           Style="{StaticResource CompactRefEditControl}" 
                                           Text="{Binding OffsetField.RefValue, Mode=TwoWay}" 
                                           TagName="Period By Date Offset Field" 
                                           Margin="0,0,0,0"
                                           IsEnabled="{Binding OffsetField.IsRefEnabled}" 
                                           MinWidth="{StaticResource RefEditMinWidth}"
                                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= Result Display ================= -->
        <Border Grid.Row="4" 
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CompactBorderStyle}"
                Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="Result :"
                       Style="{StaticResource HeaderLabel}"
                       MinWidth="{StaticResource LabelMinWidth}"
                       Margin="{StaticResource LabelMargin}"
                       VerticalAlignment="Center"/>

                <TextBox x:Name="txtResult" 
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="{StaticResource ControlHeight}"
                         Style="{StaticResource ReadOnlyTextBox}" 
                         Text="{Binding ResultText, Mode=OneWay}" 
                         Margin="{StaticResource ControlMargin}"
                         VerticalAlignment="Center">
                    <TextBox.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <StackPanel>
                                <TextBlock Text="Calculated period start and end dates" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBox.ToolTip>
                </TextBox>
            </Grid>
        </Border>

        <!-- ================= Cell Reference ================= -->
        <Border Grid.Row="5" 
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource CompactBorderStyle}"
                Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Content="Reference :"
                       Style="{StaticResource HeaderLabel}"
                       MinWidth="{StaticResource LabelMinWidth}"
                       Margin="{StaticResource LabelMargin}"
                       VerticalAlignment="Center"/>

                <local:ExcelRefEditControl x:Name="CellReference" 
                                           Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Height="{StaticResource ControlHeight}"
                                           Style="{StaticResource CompactRefEditControl}" 
                                           Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                           TagName="Period By Date Cell Reference" 
                                           Margin="{StaticResource ControlMargin}"
                                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= Action Buttons ================= -->
        <Border Grid.Row="6" 
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="Transparent" 
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center">
                <Button x:Name="btnSubmit" 
                        Style="{StaticResource InsertButtonStyle}" 
                        Click="BtnSubmit_Click" 
                        Margin="0,0,8,0" />
                <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" 
                    Click="BtnClose_Click" />
            </StackPanel>
        </Border>

        <!-- Toast / Busy overlay -->
        <local:AppOverlay x:Name="AppOverlayControl" 
                          Grid.Column="0"
                          Grid.ColumnSpan="3" 
                          Grid.Row="0" 
                          Grid.RowSpan="7" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch" 
                          Visibility="Collapsed" 
                          DataContext="{x:Null}" 
                          Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>