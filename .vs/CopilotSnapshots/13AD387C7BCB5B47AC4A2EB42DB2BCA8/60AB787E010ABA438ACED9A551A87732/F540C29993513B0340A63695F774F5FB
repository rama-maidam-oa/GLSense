<UserControl x:Class="GLSense.Views.GLBalanceConfigurator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:GLSense.Controls"
             xmlns:views="clr-namespace:GLSense.Views"
             xmlns:conv="clr-namespace:GLSense.Converters"
             xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome"
             Background="#F8F9FA"
             MinWidth="600"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:WidthPercentageConverter x:Key="WidthPercentageConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:FieldDependencyEnableConverter x:Key="FieldDependencyEnableConverter"/>
            <conv:MultiBooleanAndConverter x:Key="MultiBooleanAndConverter"/>
            <conv:BalanceTypeDatePeriodConverter x:Key="BalanceTypeDatePeriodConverter"/>
            <conv:JournalValidationConverter x:Key="JournalValidationConverter"/>
            <conv:NullableDateConverter x:Key="NullableDateConverter"/>

            <!-- Professional Label Style for config rows -->
            <Style x:Key="ConfigLabelStyle" TargetType="Label" BasedOn="{StaticResource LabelStyle}">
                <Setter Property="Width" Value="140"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <!-- Professional Row Style -->
            <Style x:Key="ConfigRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Custom Expander Style with proper stretching -->
            <Style x:Key="BlueCircleExpanderStyle" TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderSite"
                                              Grid.Row="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Left"
                                              Cursor="Hand"
                                              Padding="12,10">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                                            <Ellipse Fill="{StaticResource PrimaryBrush}"
                                                     Stroke="{StaticResource PrimaryBrush}"
                                                     StrokeThickness="1"/>
                                            <Path x:Name="Arrow"
                                                  Data="M 5 7 L 9 11 L 13 7"
                                                  Stroke="White"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Grid>
                                        <ContentPresenter Grid.Column="1"
                                                          Margin="8,0,0,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          ContentSource="Header"/>
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Row="1"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ContentSource="Content"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="9" CenterY="9"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="MainScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0">
        <Grid MinWidth="600" VerticalAlignment="Stretch">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= Header ================= -->
                <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome Kind="MoneyCheckDollarSolid" Style="{StaticResource LargeIcon}"/>
                            <TextBlock Text="Balance Configurator" Style="{StaticResource TitleHeaderTextBlock}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource CustomWindowCloseButtonStyle}" Click="BtnCancelBottom_Click"/>
                    </Grid>
                </Border>

                <!-- ================= Main Controls Section ================= -->
                <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Margin="0,0,0,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="500">
                        <StackPanel>
                            <!-- Row 0: Ledger -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Ledger:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbLedgers"
                                                             Grid.Column="1"
                                                             IsMultiSelect="True"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding Ledgers}"
                                                             DisplayMemberPath="LedgerName"
                                                             SelectedItem="{Binding LedgerField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding LedgerField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding LedgerField.IsComboEnabled}"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefLedger"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding LedgerField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Ledgers Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="LedgerField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 1: Activity -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Activity:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbActivity"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding Activities}"
                                                             SelectedItem="{Binding ActivityField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding ActivityField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding ActivityField.IsComboEnabled}"
                                                             DisplayMemberPath="DisplayName"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefActivity"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding ActivityField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Activity Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="ActivityField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 2: Balance Type -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Balance Type:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbBT"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding BalanceTypes, UpdateSourceTrigger=PropertyChanged}"
                                                             SelectedItem="{Binding BalanceTypeField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding BalanceTypeField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding BalanceTypeField.IsComboEnabled}"
                                                             DisplayMemberPath="Name"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefBalanceType"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding BalanceTypeField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Balance Type Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="BalanceTypeField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 3: Start Date - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsStartEndVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Start Date:" Style="{StaticResource ConfigLabelStyle}"/>
                                <DatePicker x:Name="dtpStartDate"
            Grid.Column="1"
            Margin="0,0,8,0"
            Height="28"
            VerticalAlignment="Center"
            SelectedDateFormat="Short"
            CalendarOpened="DatePicker_CalendarOpened"                                
            SelectedDate="{Binding StartDateSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=False, NotifyOnValidationError=True}"
            BorderThickness="1"
            BorderBrush="Gray"
            Background="White">
                                    <DatePicker.IsEnabled>
                                        <MultiBinding Converter="{StaticResource BalanceTypeDatePeriodConverter}">
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="StartDateField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </DatePicker.IsEnabled>
                                    <!-- Tooltip will be set in code-behind -->
                                    <DatePicker.Resources>
                                        <Style TargetType="{x:Type DatePickerTextBox}">
                                            <Setter Property="Control.Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                        <TextBox x:Name="PART_TextBox"
                                 BorderBrush="White"
                                 Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, Converter={StaticResource NullableDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                                <views:ExcelRefEditControl x:Name="RefStartDate"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding StartDateField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Start Date Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="StartDateField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 4: End Date - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsStartEndVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="End Date:" Style="{StaticResource ConfigLabelStyle}"/>
                                <DatePicker x:Name="dtpEndDate"
            Grid.Column="1"
            Margin="0,0,8,0"
            Height="28"
            VerticalAlignment="Center"
            SelectedDateFormat="Short"
            CalendarOpened="DatePicker_CalendarOpened"                                
            SelectedDate="{Binding EndDateSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=False, NotifyOnValidationError=True}"
            BorderThickness="1"
            BorderBrush="Gray"
            Background="White">
                                    <DatePicker.IsEnabled>
                                        <MultiBinding Converter="{StaticResource BalanceTypeDatePeriodConverter}">
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="EndDateField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </DatePicker.IsEnabled>
                                    <!-- Tooltip will be set in code-behind -->
                                    <DatePicker.Resources>
                                        <Style TargetType="{x:Type DatePickerTextBox}">
                                            <Setter Property="Control.Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                                                        <TextBox x:Name="PART_TextBox"
                                 BorderBrush="White"
                                 Text="{Binding Path=SelectedDate, RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}, Converter={StaticResource NullableDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DatePicker.Resources>
                                </DatePicker>
                                <views:ExcelRefEditControl x:Name="RefEndDate"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding EndDateField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator End Date Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="EndDateField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 5: Period - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsPeriodVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Period:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbPeriods"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding Periods}"
                                                             SelectedItem="{Binding PeriodField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding PeriodField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             DisplayMemberPath="PeriodName"
                                                             Margin="0,0,8,0">
                                    <ctrls:SuggestAppendComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource BalanceTypeDatePeriodConverter}" ConverterParameter="Invert">
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="PeriodField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </ctrls:SuggestAppendComboBox.IsEnabled>
                                </ctrls:SuggestAppendComboBox>
                                <views:ExcelRefEditControl x:Name="RefPeriod"
                                                           Grid.Column="2"
                                                           RowAbsolute="True"
                                                           ColumnAbsolute="False"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding PeriodField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Period Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="PeriodField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 6: End Period - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsEndPeriodVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="End Period:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbEndPeriods"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding EndPeriods}"
                                                             SelectedItem="{Binding EndPeriodField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding EndPeriodField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             DisplayMemberPath="PeriodName"
                                                             Margin="0,0,8,0">
                                    <ctrls:SuggestAppendComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="BalanceTypeField.ComboValue" Converter="{StaticResource FieldDependencyEnableConverter}" ConverterParameter="BalanceType:EndPeriod"/>
                                            <Binding Path="EndPeriodField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </ctrls:SuggestAppendComboBox.IsEnabled>
                                </ctrls:SuggestAppendComboBox>
                                <views:ExcelRefEditControl x:Name="RefEndPeriod"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding EndPeriodField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator End Period Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="EndPeriodField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 7: Currency -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Currency:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbCurrency"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding Currencies}"
                                                             SelectedItem="{Binding CurrencyField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding CurrencyField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding CurrencyField.IsComboEnabled}"
                                                             DisplayMemberPath="CurrencyCode"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefCurrency"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding CurrencyField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Currency Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="CurrencyField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 8: Currency Type -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Currency Type:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbCurrencyType"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding CurrencyTypes}"
                                                             SelectedItem="{Binding CurrencyTypeField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding CurrencyTypeField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding CurrencyTypeField.IsComboEnabled}"
                                                             DisplayMemberPath="Name"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefCurrencyType"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding CurrencyTypeField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Currency Type Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="CurrencyTypeField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 9: Actual Flag -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Actual Flag:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbAF"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding ActualFlags}"
                                                             SelectedItem="{Binding ActualFlagField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding ActualFlagField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding ActualFlagField.IsComboEnabled}"
                                                             DisplayMemberPath="Name"
                                                             Margin="0,0,8,0"/>
                                <views:ExcelRefEditControl x:Name="RefActualFlag"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding ActualFlagField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Actual Flag Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="ActualFlagField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 10: Budgets - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsBudgetVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Budgets:" Style="{StaticResource ConfigLabelStyle}" VerticalAlignment="Center"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbBudgets"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding Budgets}"
                                                             SelectedItem="{Binding BudgetField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding BudgetField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             DisplayMemberPath="BudgetName"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center">
                                    <ctrls:SuggestAppendComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="ActualFlagField.ComboValue" Converter="{StaticResource FieldDependencyEnableConverter}" ConverterParameter="ActualFlag:Budget"/>
                                            <Binding Path="BudgetField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </ctrls:SuggestAppendComboBox.IsEnabled>
                                </ctrls:SuggestAppendComboBox>
                                <views:ExcelRefEditControl x:Name="RefBudget"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding BudgetField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Budget Field"
                                                           VerticalAlignment="Center">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="BudgetField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 11: Encumbrances - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsEncumbranceVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Encumbrances:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbEncumbrances"
                                                             Grid.Column="1"
                                                             IsMultiSelect="True"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding Encumbrances}"
                                                             SelectedItem="{Binding EncumbranceField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding EncumbranceField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             DisplayMemberPath="EncumbranceType"
                                                             Margin="0,0,8,0">
                                    <ctrls:SuggestAppendComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="ActualFlagField.ComboValue" Converter="{StaticResource FieldDependencyEnableConverter}" ConverterParameter="ActualFlag:Encumbrance"/>
                                            <Binding Path="EncumbranceField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </ctrls:SuggestAppendComboBox.IsEnabled>
                                </ctrls:SuggestAppendComboBox>
                                <views:ExcelRefEditControl x:Name="RefEncumbrance"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding EncumbranceField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Encumbrance Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="EncumbranceField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 12: Journal Source - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsJournalSourceVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Journal Source:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbJS"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding JournalSources}"
                                                             DisplayMemberPath="SourceName"
                                                             SelectedItem="{Binding JournalSourceField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding JournalSourceField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0,0,8,0">
                                    <ctrls:SuggestAppendComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource JournalValidationConverter}">
                                            <Binding Path="ActivityField.ComboValue"/>
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="CurrencyTypeField.ComboValue"/>
                                            <Binding Path="JournalSourceField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </ctrls:SuggestAppendComboBox.IsEnabled>
                                </ctrls:SuggestAppendComboBox>
                                <views:ExcelRefEditControl x:Name="RefJournalSource"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding JournalSourceField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Journal Source Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource JournalValidationConverter}">
                                            <Binding Path="ActivityField.ComboValue"/>
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="CurrencyTypeField.ComboValue"/>
                                            <Binding Path="JournalSourceField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 13: Journal Category - Collapsible -->
                            <Grid Style="{StaticResource ConfigRowStyle}"
                                  Visibility="{Binding IsJournalCategoryVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Journal Category:" Style="{StaticResource ConfigLabelStyle}"/>
                                <ctrls:SuggestAppendComboBox x:Name="CmbJC"
                                                             Grid.Column="1"
                                                             Style="{StaticResource CompactCombo}"
                                                             ItemsSource="{Binding JournalCategories}"
                                                             SelectedItem="{Binding JournalCategoryField.ComboValue, Mode=TwoWay}"
                                                             Text="{Binding JournalCategoryField.ComboText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             DisplayMemberPath="CategoryName"
                                                             Margin="0,0,8,0">
                                    <ctrls:SuggestAppendComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource JournalValidationConverter}">
                                            <Binding Path="ActivityField.ComboValue"/>
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="CurrencyTypeField.ComboValue"/>
                                            <Binding Path="JournalCategoryField.IsComboEnabled"/>
                                        </MultiBinding>
                                    </ctrls:SuggestAppendComboBox.IsEnabled>
                                </ctrls:SuggestAppendComboBox>
                                <views:ExcelRefEditControl x:Name="RefJournalCategory"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding JournalCategoryField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Journal Category Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource JournalValidationConverter}">
                                            <Binding Path="ActivityField.ComboValue"/>
                                            <Binding Path="BalanceTypeField.ComboValue"/>
                                            <Binding Path="CurrencyTypeField.ComboValue"/>
                                            <Binding Path="JournalCategoryField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>

                            <!-- Row 14: Account Assignments -->
                            <Grid Style="{StaticResource ConfigRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Account Assignment(s):" Style="{StaticResource ConfigLabelStyle}"/>
                                <views:GLAccountsRef x:Name="AcctsRef"
                                                     Grid.Column="1"
                                                     Margin="0,0,8,0"
                                                     Height="28"
                                                     FontSize="12"
                                                     Text="{Binding AccountAssignmentField.ComboValue, Mode=TwoWay}"
                                                     IsEnabled="{Binding AccountAssignmentField.IsComboEnabled}"/>
                                <views:ExcelRefEditControl x:Name="RefAccountAssignments"
                                                           Grid.Column="2"
                                                           Style="{StaticResource CompactRefEditControl}"
                                                           Text="{Binding AccountAssignmentField.RefValue, Mode=TwoWay}"
                                                           TagName="Balance Configurator Account(s) Assignment Field">
                                    <views:ExcelRefEditControl.IsEnabled>
                                        <MultiBinding Converter="{StaticResource MultiBooleanAndConverter}">
                                            <Binding Path="AccountAssignmentField.IsRefEnabled"/>
                                        </MultiBinding>
                                    </views:ExcelRefEditControl.IsEnabled>
                                </views:ExcelRefEditControl>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ================= Options Section ================= -->
                <Border Grid.Row="2" Style="{StaticResource ContentBorderStyle}" Margin="0,0,0,8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkSign"
                                      Content="Change Sign"
                                      Style="{StaticResource CompactCheckBox}"
                                      IsChecked="{Binding IsSignChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <CheckBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <TextBlock Text="Changes the value from positive to negative and vice versa"/>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <CheckBox x:Name="ChkZeroes"
                                      Content="Show 0's"
                                      Style="{StaticResource CompactCheckBox}"
                                      IsChecked="{Binding IsZeroesChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <CheckBox.ToolTip>
                                    <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                        <TextBlock Text="Applies excel number format to displays zero or not"/>
                                    </ToolTip>
                                </CheckBox.ToolTip>
                            </CheckBox>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="Factor:" VerticalAlignment="Center" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Right"/>
                        <TextBox x:Name="TxtFactor"
                                 Grid.Column="3"
                                 Style="{StaticResource CompactTextBox}"
                                 Margin="8,0,0,0"
                                 Text="{Binding FactorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                                    <StackPanel>
                                        <TextBlock Text="Multiplies the calculated value with the given factor value" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBox.ToolTip>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- ================= Action Buttons Section ================= -->
                <Border Grid.Row="3" Style="{StaticResource ContentBorderStyle}" Margin="0,0,0,8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Reference:" Style="{StaticResource SectionHeaderStyle}"/>
                        </StackPanel>

                        <views:ExcelRefEditControl x:Name="CellReference"
                                                   Grid.Column="1"
                                                   Height="28"
                                                   Margin="12,0"
                                                   TagName="Balance Configurator Cell Reference"
                                                   Text="{Binding GlobalState.ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CompactRefEditControl}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="btnOKBottom" Margin="0,0,8,0" Style="{StaticResource InsertButtonStyle}" Click="BtnOKBottom_Click"/>
                            <Button x:Name="btnCancelBottom" Style="{StaticResource CloseButtonStyle}" Click="BtnCancelBottom_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= Balance Parameters Section - Fills remaining space ================= -->
                <Expander Grid.Row="4"
                          x:Name="BalanceParametersExpander"
                          Style="{StaticResource BlueCircleExpanderStyle}"
                          IsExpanded="False"
                          Background="White"
                          BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                    <Expander.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Click to expand balance parameters"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.IsExpanded, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="True">
                                                <Setter Property="Text" Value="Click to collapse balance parameters"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToolTip>
                    </Expander.ToolTip>

                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <iconPacks:PackIconFontAwesome Kind="CodeSolid" Width="14" Height="14" Foreground="#2E86AB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Get Balance Function Parameters" Style="{StaticResource SectionHeaderStyle1}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <!-- Content that fills available space -->
                    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Border BorderBrush="#E9ECEF" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Background="White" 
                                Margin="2" 
                                Padding="0"
                                VerticalAlignment="Stretch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="8"
                                          VerticalAlignment="Stretch">
                                <RichTextBox x:Name="BalanceParametersBox"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Padding="4"
                                             FontSize="11"
                                             FontFamily="Segoe UI"
                                             Background="Transparent"
                                             VerticalAlignment="Stretch"
                                             conv:RichTextBoxHelper.BindableDocument="{Binding ParameterDisplayText}">
                                    <RichTextBox.Resources>
                                        <Style TargetType="FlowDocument">
                                            <Setter Property="PagePadding" Value="4"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                        </Style>
                                        <Style TargetType="Paragraph">
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                        </Style>
                                    </RichTextBox.Resources>
                                    <RichTextBox.Document>
                                        <FlowDocument PagePadding="4,0,4,0"/>
                                    </RichTextBox.Document>
                                </RichTextBox>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Expander>
            </Grid>

            <!-- Toast / Busy overlay -->
            <views:AppOverlay x:Name="AppOverlayControl"
                              Grid.ColumnSpan="3"
                              Margin="0"
                              Grid.Row="0"
                              Grid.RowSpan="7"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="Collapsed"
                              DataContext="{x:Null}"
                              Panel.ZIndex="10"/>
        </Grid>
    </ScrollViewer>
</UserControl>