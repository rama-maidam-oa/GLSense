        private static void InitializeExcelReferences()
        {
            _excelApp = AppState.Instance.ExcelApp;
            _workbook = _excelApp.ActiveWorkbook;
            _worksheet = _excelApp.ActiveSheet as Excel.Worksheet;
        }

        // ---------------------------------------------------------------------
        // Step 1: Save and Zip
        // ---------------------------------------------------------------------
        private static async Task<Exception?> Step_SaveAndZipWorkbook(CancellationToken token)
        {
            if (_workbook == null)
            {
                var ex = new Exception("No active workbook found.");
                LogError(ex);
                return ex;
            }

            return await RunLongRunningTask(token, ct => SaveAndZipWorkbookAsync(_workbook, ct));
        }

        // ---------------------------------------------------------------------
        // Step 2: Upload
        // ---------------------------------------------------------------------
        private static async Task<Exception?> Step_UploadZipToServer(CancellationToken token)
        {
            string postUrl = BuildUploadUrl();

            try
            {
                await MessageProgressWindowAsync("File prepared for upload.");
                await UploadZiptoServerAsync(postUrl, token).ConfigureAwait(false);
                return null;
            }
            catch (OperationCanceledException ex)
            {
                LogWarn("Upload canceled by user.");
                return ex;
            }
            catch (Exception ex)
            {
                LogError(ex);
                return token.IsCancellationRequested ? null : ex;
            }
        }

        private static string BuildUploadUrl()
        {
            if (_worksheet == null)
                return string.Empty;

            long cubeId = AppState.Instance.SelectedCube.CubeId;
            long coaId = AppState.Instance.SelectedLedger.CoaId;

            if (_isTypeSheet)
            {
                string sheetName = WebUtility.UrlEncode(_worksheet.Name);
                return $"{LoginURL}/rest/secure/finance/sheet-balances?cubeId={cubeId}&coaid={coaId}&sheetName={sheetName}";
            }

            return $"{LoginURL}/rest/secure/finance/sheet-balances?cubeId={cubeId}&coaid={coaId}";
        }

