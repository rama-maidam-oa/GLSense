        private static bool IsCancelled(CancellationToken token)
        {
            HandleCancellation(token);
            return token.IsCancellationRequested;
        }

        private static void HandleCancellation(CancellationToken token)
        {
            if (token.IsCancellationRequested && !UserCancelled)
            {
                UserCancelled = true;
                try
                {
                    token.ThrowIfCancellationRequested();
                }
                catch (OperationCanceledException ex)
                {
                    LogWarn($"HandleCancellation detected operation canceled: {ex.Message}");
                }
                catch (Exception ex)
                {
                    LogWarn($"Unexpected error in HandleCancellation: {ex.Message}");
                }
            }
        }
        private static Task MessageProgressWindowAsync(string? message)
        {
            // Basic guards
            if (Win == null || Win.Dispatcher == null)
                return Task.CompletedTask;

            try
            {
                // Use a reasonable priority and capture the Task [web:66]
                var op = Win.Dispatcher.InvokeAsync(
                    () =>
                    {
                        Win.SetProcessMessage(message);
                    },
                    DispatcherPriority.Normal);

                return op.Task;
            }
            catch (TaskCanceledException)
            {
                // Dispatcher shutting down; nothing to do
                return Task.CompletedTask;
            }
            catch (Exception ex)
            {
                // Last-resort logging if something unexpected happens
                LogUtility.LogException(ex);
                return Task.CompletedTask;
            }
        }

        private static string GetModeErrorMessage()
        {
            if (_isSnapshot)
            {
                return "An internal error occurred while creating the snapshot.";
            }

            return _isTypeSheet
                ? "An internal error occurred while performing the sheet refresh."
                : "An internal error occurred while performing the book refresh.";
        }
