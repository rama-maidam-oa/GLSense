        public static async Task SubmitSnapAsync(string RefreshMode)
        {

            _ctsHelper = new CancellationHelper();

            _Title = GetTitle("Snapshot", RefreshMode);

            CommonMethods.DisableExcelSettings();
            ExcelApp = AppState.Instance.ExcelApp;
            BrWorbook = ExcelApp.ActiveWorkbook;
            BrWorksheet = (Excel.Worksheet)ExcelApp.ActiveSheet;
            _originalExcelWindowState = ExcelApp.WindowState;

            try
            {
                Win = CreateAndShowProgressWindow(_ctsHelper);
                await InitializeProgressWindowAsync("Processing request...");

                Token.ThrowIfCancellationRequested();

                if (!await ValidateBalanceFormulasExistAsync())
                    return;

                if (!await ValidateNoBrokenLinksAsync())
                    return;

                Token.ThrowIfCancellationRequested();

                if (AppState.Instance.VersionCheck)
                {
                    await ValidateAndUpdateFormulasIfNeededAsync();
                }

                await MessageProgressWindowAsync("Saving and zipping the file copy...");

                if (!await SavingAndZipping())
                {
                    await ShowErrorMessage("Exception encountered while saving the file copy.");
                    return;
                }

                string postURL = BuildApiUrl(RefreshMode);
                await SendRequestAndHandleResponseAsync(postURL);
                Token.ThrowIfCancellationRequested();
            }
            catch (OperationCanceledException)
            {
                LogUtility.LogWarn("Snapshot submission cancelled by user.");
            }
            catch (Exception ex)
            {
                LogUtility.LogException(ex);
                await HandleUnexpectedErrorAsync(ex); // Optional: if you have a UI-friendly handler
            }
            finally
            {
                try
                {
                    if (_ctsHelper != null && !_ctsHelper.IsCancellationRequested)
                        _ctsHelper.Cancel();

                    _ctsHelper?.Dispose();  // ? ALWAYS SAFE - handles ALL cases
                }
                catch
                {
                    // Swallow dispose exceptions (Excel COM weirdness)
                }
                await ClearFiles();
                await SafelyCloseWindowAsync();
                CommonMethods.EnableExcelSettings();
            }
        }
        private static string BuildApiUrl(string RefreshMode)
        {
            _ = MessageProgressWindowAsync("Creating api url");
            string bookName = WebUtility.UrlEncode(BrWorbook?.Name ?? string.Empty);
            string sheetName = WebUtility.UrlEncode(BrWorksheet?.Name ?? string.Empty);
            string LoginURL = AppState.Instance.LoginUrl;
            long RespID = AppState.Instance.SelectedCube.CubeId;
            long ChartofAccountID = AppState.Instance.SelectedLedger.CoaId;

            Token.ThrowIfCancellationRequested();

            string encodedUrl;

            if (RefreshMode == "Book")
            {
                LogUtility.LogDebug($"Submitting snapshot for the workbook \"{BrWorbook?.Name}\"");
                encodedUrl = $"{LoginURL}/rest/secure/finance/sheet-snapshot?cubeId={RespID}&coaid={ChartofAccountID}&bookName={bookName}";
            }
            else
            {
                LogUtility.LogDebug($"Submitting snapshot for the worksheet \"{BrWorksheet?.Name}\"");
                encodedUrl = $"{LoginURL}/rest/secure/finance/sheet-snapshot?cubeId={RespID}&coaid={ChartofAccountID}&sheetName={sheetName}&bookName={bookName}";
            }

            return encodedUrl;
        }
        private static async Task SendRequestAndHandleResponseAsync(
            string apiUrl)
        {
            Token.ThrowIfCancellationRequested();

            await MessageProgressWindowAsync("Uploading the file to server...");
            try
            {
                string response = await ApiHelper.HttpUploadFileAsync(apiUrl, Token);

                Token.ThrowIfCancellationRequested();
                await MessageProgressWindowAsync("Response received from server...");

                if (!IsValidOutput(response))
                {
                    await ShowErrorMessage(response);
                }
                else
                {
                    await HandleResponseAsync(response.ToString().Trim());
                }
            }
            catch (Exception ex)
            {
                LogUtility.LogException(ex);
            }
        }
        private static async Task HandleResponseAsync(string json)
        {
            await MessageProgressWindowAsync("Parsing the response.");

            JsonDocument document;
            try
            {
                // Parse the JSON string. No built-in MaxJsonLength equivalent exists,
                // but System.Text.Json handles very large payloads efficiently by default.
                document = JsonDocument.Parse(json);
            }
            catch (JsonException ex)
            {
                LogUtility.LogException(ex);
                return;
            }
            catch (Exception ex) // e.g., OutOfMemory for extremely large input
            {
                LogUtility.LogException(ex);
                return;
            }

            var root = document.RootElement;

            string status = root.TryGetProperty("status", out var statusElement)
                ? statusElement.GetString() ?? string.Empty
                : string.Empty;

            string msg = root.TryGetProperty("msg", out var msgElement)
                ? msgElement.GetString() ?? string.Empty
                : string.Empty;

            if (!IsSuccessStatus(status))
            {
                await ShowErrorMessage(msg);
                return;
            }

            await HandleBackgroundMessageAsync(msg);

            document.Dispose(); // Always dispose JsonDocument to release memory
        }
        private static async Task HandleBackgroundMessageAsync(string msg)
        {
            string msgStr = msg ?? string.Empty;
            string id = ExtractLastToken(msgStr);
            if (!string.IsNullOrEmpty(id))
            {
                string rangeName = "GLSense_DD_" + id;
                if (!CommonFunctions.NameRangeExists(rangeName))
                {
                    try
                    {
                        BrWorbook?.Names.Add(Name: rangeName, RefersToR1C1: id);
                    }
                    catch (Exception ex)
                    {
                        LogUtility.LogException(ex, "Exception adding the named range");
                    }
                }
            }

            if (!string.IsNullOrWhiteSpace(msgStr))
            {
                msgStr += Environment.NewLine + "Launch monitor window to check the status.";
            }

            await ShowInfoMessage(msgStr);
        }

        private static string ExtractLastToken(string msg)
        {
            if (string.IsNullOrWhiteSpace(msg))
                return string.Empty;

            var parts = msg.Split(' ');
            return parts.Length == 0 ? string.Empty : parts[parts.Length - 1];
        }

        private static bool IsSuccessStatus(string status) =>
              string.Equals(status, AppConstants.Success, StringComparison.OrdinalIgnoreCase);
        private static bool IsValidOutput(object output)
        {
            if (output == null)
                return false;

            string s = output.ToString();
            return s.Length > 3 && s.IndexOf("status", StringComparison.Ordinal) >= 0;
        }
        private static Task<bool> SavingAndZipping()
        {
            var path = AppPaths.TempFilesPath ?? string.Empty;
            var filePath1 = Path.Combine(path, AppConstants.RefreshFileName);
            var zipPath = Path.Combine(path, AppConstants.RefreshZipFileName);

            // Save a copy of the workbook
            try
            {
                BrWorbook?.SaveCopyAs(filePath1);
            }
            catch (Exception ex)
            {
                LogUtility.LogException(ex);
                return Task.FromResult(false);
            }

            try
            {
                if (File.Exists(zipPath))
                {
                    File.Delete(zipPath);
                }

                using var newfile = ZipFile.Open(zipPath, ZipArchiveMode.Create);
                newfile.CreateEntryFromFile(filePath1, AppConstants.RefreshFileName);
                return Task.FromResult(true);
            }
            catch (Exception ex)
            {
                LogUtility.LogException(ex);
            }
            return Task.FromResult(false);
        }

        //Refreshing Balances Async Method

        public static async Task RefreshingBalancesAsync(string RefreshType, string RefreshMode)
        {

            _ctsHelper = new CancellationHelper();
            bool showMessage = false;
            try
            {
                InitializeEnvironment(RefreshType, RefreshMode);

                Win = CreateAndShowProgressWindow(_ctsHelper);

                if (Win == null)
                {
                    LogUtility.LogWarn("Unable to set progress window");
                    return;
                }

                await InitializeProgressWindowAsync("Processing request...");

                if (!await ValidateWorkbookIsSavedAsync()) return;
                if (!await ValidateNoBrokenLinksAsync()) return;

                Token.ThrowIfCancellationRequested();

                bool isSnapshot = IsSnapshotMode();
                string snapshotFilePath = string.Empty;

                if (isSnapshot)
                {
                    snapshotFilePath = await PromptForSnapshotPathAsync(Token);
                    Token.ThrowIfCancellationRequested();
                    if (string.IsNullOrEmpty(snapshotFilePath)) return;
                }

                if (!await ValidateBalanceFormulasExistAsync()) return;

                Token.ThrowIfCancellationRequested();

                CollectBalanceFormulas(RefreshMode);

                if (AppState.Instance.VersionCheck)
                {
                    Token.ThrowIfCancellationRequested();
                    await ValidateAndUpdateFormulasIfNeededAsync();
                }

                await MessageProgressWindowAsync("Saving copy and preparing for refresh...");

                Exception? refreshException = await BulkRefreshProcess.StartRefreshing(
                    Win, RefreshMode, isSnapshot, snapshotFilePath, Token);

                if (refreshException != null)
                {
                    await HandleRefreshErrorAsync(refreshException);
                }
                else
                {
                    showMessage = isSnapshot;
                    LogSuccess(RefreshType);
                }
            }
            catch (OperationCanceledException)
            {
                await ShowCancelledAsync();
                LogUtility.LogWarn($"{_Title} cancelled by user.");
            }
            catch (Exception ex)
            {
                await HandleUnexpectedErrorAsync(ex);
                LogUtility.LogException(ex);
            }
            finally
            {
                try
                {
                    if (_ctsHelper != null && !_ctsHelper.IsCancellationRequested)
                        _ctsHelper.Cancel();

                    _ctsHelper?.Dispose();  // ? ALWAYS SAFE - handles ALL cases
                }
                catch
                {
                    // Swallow dispose exceptions (Excel COM weirdness)
                }
                await ClearFiles();
                await SafelyCloseWindowAsync();
                CommonMethods.EnableExcelSettings();
                if (showMessage)
                {
                   string message = DisplayMessage(RefreshType);
                    if (!string.IsNullOrEmpty(message))
                    {
                        CommonFunctions.GLSenseMessage(message, MessageBoxIcon.Information, MessageBoxButtons.OK);
                    }
                }
            }
        }

