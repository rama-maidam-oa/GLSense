        private static async Task<bool> ExistsBalanceFormulas()
        {
            if (BrWorbook == null || BrWorksheet == null)
            {
                return false;
            }

            try
            {
                if (_Title == "Worksheet Refresh" || _Title == "Worksheet Snapshot")
                {
                    return CommonFunctions.BalanceFormulaExists(BrWorksheet.Name);
                }
                else
                {

                    bool formulasExists = BrWorbook.Worksheets
                             .Cast<Excel.Worksheet>()
                             .Any(wsheet => CommonFunctions.BalanceFormulaExists(wsheet.Name));

                    return formulasExists;
                }
            }
            catch (Exception ex)
            {
                await HandleUnexpectedErrorAsync(ex);
                return false;
            }
        }
