        private static readonly Dictionary<string, string> TitleLookup
            = new(StringComparer.OrdinalIgnoreCase)
            {
                ["Refresh-Sheet"] = "Worksheet Refresh",
                ["Refresh-Book"] = "Workbook Refresh",
