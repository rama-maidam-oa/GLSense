<utils:DpiAwareWindow x:Class="GLSense.Views.GLDrilldownCustomization" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:local="clr-namespace:GLSense.Views" 
        xmlns:utils="clr-namespace:GLSense.Utilities"
        xmlns:iconPacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" 
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        SizeToContent="Height"
        ResizeMode="CanResizeWithGrip" 
        MinWidth="1000" MaxWidth="1500" 
        MinHeight="750" MaxHeight="900"
        Background="#F8F9FA">
    <utils:DpiAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GLSense;component/Themes/GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </utils:DpiAwareWindow.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================= Header Section ================= -->
        <Border Grid.Row="0" Background="#2E86AB" CornerRadius="6" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="GearsSolid" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" Margin="0,3,12,0"/>
                    <TextBlock x:Name="txtTitle" Text="GLSense Drilldown Customization" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Close Button -->
                <Button Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" 
        Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand" 
        Style="{x:Null}" Click="BtnClose_Click"
        ToolTipService.InitialShowDelay="50"
        ToolTipService.BetweenShowDelay="0"
        ToolTipService.ShowDuration="8000">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <TextBlock Text="Click to close this window"/>
                        </ToolTip>
                    </Button.ToolTip>
                    <iconPacks:PackIconFontAwesome Kind="XmarkSolid" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
        <!-- ================= WebView2 Section ================= -->
        <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <wv2:WebView2 x:Name="webView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Grid>
        </Border>
        <!-- ================= Close Button Section ================= -->
        <Border Grid.Row="2" Background="Transparent" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnClose" Style="{StaticResource SecondaryButton}" Width="90" Height="32" 
        Click="BtnClose_Click"
        ToolTipService.InitialShowDelay="50"
        ToolTipService.BetweenShowDelay="0"
        ToolTipService.ShowDuration="8000">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource SimpleBrowserToolTip}">
                            <StackPanel>
                                <TextBlock Text="Click to close this window" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconFontAwesome Kind="CircleXmarkSolid" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="Close" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <!-- ================= Busy overlay ================= -->
        <!-- Window-local busy overlay (independent of shared AppOverlay) -->
        <Grid x:Name="LocalBusyOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Background="#88000000"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="50"
              IsHitTestVisible="True">
            <Border Background="White" Padding="16" CornerRadius="8" Width="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressBar IsIndeterminate="True" Height="10" Width="200"/>
                    <TextBlock x:Name="LocalBusyText"
                               Text="Loading..."
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Existing shared overlay (unchanged for other windows) -->
        <local:AppOverlay x:Name="AppOverlayControl" Margin="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" DataContext="{x:Null}" Panel.ZIndex="10"/>
    </Grid>
</utils:DpiAwareWindow>