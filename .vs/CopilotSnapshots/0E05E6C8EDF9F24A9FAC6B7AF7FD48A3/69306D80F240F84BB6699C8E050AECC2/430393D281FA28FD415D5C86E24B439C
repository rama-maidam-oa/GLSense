                {
                    if (sheetClear)
                    {
                        await win.Dispatcher.InvokeAsync(() => win.SetProcessMessage("Clearing sheet..."));
                        token.ThrowIfCancellationRequested();

                        if (ExcelApp.ActiveSheet is Worksheet sheet)
                            sheet.Cells.Clear();
                    }

                    await win.Dispatcher.InvokeAsync(() => win.SetProcessMessage("Loading ledger data..."));
                    token.ThrowIfCancellationRequested();

                    await CommonFunctions.FillResponsibilitiesAsync(ledger.LedgerId, AppState.Instance.SelectedCube.CubeId, token);

                    token.ThrowIfCancellationRequested();
                    UpdateRibbonUI(ledger);
                }
                catch (OperationCanceledException)
                {
                    LogUtility.LogDebug("Work task cancelled - propagating.");
                    throw;
                }
                catch (Exception ex)
                {
                    LogUtility.LogException(ex, "Work phase failed.");
                    throw;
                }
            }, token);
        }

